---
export const prerender = true;

import LayoutSubstack from "../../layouts/LayoutSubstack.astro";
import FloatingBackButton from "../../components/FloatingBackButton.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  try {
    const ensayos = await getCollection("ensayos");
    return ensayos.map((ensayo) => ({
      params: { slug: ensayo.id },
      props: { ensayo },
    }));
  } catch (e) {
    return [];
  }
}

const { ensayo: initialEnsayo } = Astro.props;
import { getEntry } from 'astro:content';

// Re-fetching the entry to ensure we have a fresh reference compatible with the current content layer state
const ensayo = await getEntry('ensayos', initialEnsayo.id);

let renderError: any = null;
const rendered = ensayo ? await render(ensayo).catch((e) => {
  console.error("Error rendering ensayo:", initialEnsayo.id, e);
  renderError = e;
  return null;
}) : null;

if (!ensayo) {
  renderError = new Error(`Ensayo not found: ${initialEnsayo.id}`);
}

const Content = rendered?.Content;

const title = ensayo.data.title || "Ensayo no titulado";
const subtitle = ensayo.data.subtitle || "";
const coverImage = ensayo.data.coverImage;
const author = ensayo.data.author || "Xavier Benítez";
const date = ensayo.data.date;
const accentColor = ensayo.data.accentColor || "#1a1a1a";

const avatarId = ensayo.id ? ensayo.id.charCodeAt(0) % 20 : 1;
const authorImg = `https://i.pravatar.cc/150?img=${avatarId}`;
---

<LayoutSubstack title={`${title} | The Great Puzzle`}>
  <FloatingBackButton />

  <article class="w-full max-w-2xl mx-auto pt-16 md:pt-32 pb-32 px-4 md:px-0">
    {/* Post Header */}
    <header class="mb-12">
      <h1
        class="font-gloock text-4xl md:text-6xl text-white mb-6 leading-tight"
      >
        {title}
      </h1>
      {
        subtitle && (
          <p class="text-xl text-gray-400 font-sans leading-relaxed mb-10">
            {subtitle}
          </p>
        )
      }

      {/* Reading Status Note - Exquisite Detail */}
      <div
        class="flex items-center gap-2 mb-4 text-gray-400 text-xs font-semibold uppercase tracking-[0.2em]"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>12 min read</span>
      </div>

      {/* Author Ribbon */}
      <div class="flex items-center gap-4 py-4 border-y border-white/10">
        <img
          src={authorImg}
          alt={author}
          class="w-12 h-12 rounded-full border border-white/20"
        />
        <div class="flex-1">
          <div class="flex items-center gap-2">
            <span class="text-white font-medium">{author}</span>
            <button
              class="text-[#FF6719] text-xs hover:underline font-bold uppercase tracking-wider ml-2"
              >Suscribirse</button
            >
          </div>
          <span class="text-gray-500 font-sans text-sm">{date}</span>
        </div>
        {/* Share / Interactions */}
        <div class="flex items-center gap-4 text-gray-500">
          <button class="hover:text-white transition-colors">
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
              ></path></svg
            >
          </button>
        </div>
      </div>
    </header>

    {/* Hero Image */}
    {
      coverImage && (
        <figure class="w-full mb-12 aspect-video overflow-hidden rounded-xl bg-[#0a0a0a] relative">
          <div
            class="absolute inset-0 z-0 opacity-30 mix-blend-screen"
            style={`background: linear-gradient(to right, transparent, ${accentColor})`}
          />
          <img
            src={coverImage}
            alt={title}
            class="w-full h-full object-cover relative z-10"
          />
        </figure>
      )
    }

    {/* Prose Content */}
    <div
      class="prose prose-invert prose-lg prose-p:font-sans prose-p:text-gray-300 prose-headings:font-gloock prose-headings:text-white prose-a:text-[#FF6719] max-w-none"
    >
      {renderError ? (
        <div class="bg-red-900/20 border border-red-500/50 p-8 rounded-lg">
          <h2 class="text-red-400 font-serif mb-4">Error de Sincronización</h2>
          <pre class="mt-4 p-4 bg-black/40 rounded text-xs text-red-300 overflow-x-auto">
            {renderError instanceof Error ? renderError.message : String(renderError)}
          </pre>
        </div>
      ) : (
        Content && <Content />
      )}
    </div>

    {/* Footer Interactions */}
    <div
      class="mt-16 pt-8 border-t border-white/10 flex justify-between items-center text-gray-400"
    >
      <button
        class="like-btn flex items-center gap-2 hover:text-[#FF6719] transition-colors group/like"
        data-liked="false"
      >
        <svg
          class="w-6 h-6 transition-all group-[.liked]/like:fill-[#FF6719] group-[.liked]/like:text-[#FF6719] group-[.liked]/like:scale-110"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
          ></path>
        </svg>
        <span class="like-count text-lg">21k</span>
      </button>
    </div>
  </article>
</LayoutSubstack>

<script>
  const likeButtons = document.querySelectorAll(".like-btn");
  likeButtons.forEach((btn) => {
    if (btn.hasAttribute("data-init")) return;
    btn.setAttribute("data-init", "true");
    btn.addEventListener("click", () => {
      const isLiked = btn.getAttribute("data-liked") === "true";
      const countSpan = btn.querySelector(".like-count");
      if (!isLiked) {
        btn.classList.add("liked");
        btn.setAttribute("data-liked", "true");
        if (countSpan) countSpan.textContent = "21.1k";
      } else {
        btn.classList.remove("liked");
        btn.setAttribute("data-liked", "false");
        if (countSpan) countSpan.textContent = "21k";
      }
    });
  });
</script>
