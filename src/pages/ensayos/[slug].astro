---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import FloatingBackButton from "../../components/FloatingBackButton.astro";
import EditorialReadMore from "../../components/EditorialReadMore.astro";
import ArticleFooter from "../../components/ArticleFooter.astro";
import TgpImage from "../../components/TgpImage.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  try {
    const ensayos = await getCollection("ensayos");
    return ensayos.map((ensayo) => ({
      params: { slug: ensayo.id },
      props: { ensayo },
    }));
  } catch (e) {
    return [];
  }
}

const { ensayo: initialEnsayo } = Astro.props;
import { getEntry } from 'astro:content';

// Re-fetching the entry to ensure we have a fresh reference compatible with the current content layer state
const ensayo = await getEntry('ensayos', initialEnsayo.id);

let renderError: any = null;
const rendered = ensayo ? await render(ensayo).catch((e) => {
  console.error("Error rendering ensayo:", initialEnsayo.id, e);
  renderError = e;
  return null;
}) : null;

if (!ensayo) {
  renderError = new Error(`Ensayo not found: ${initialEnsayo.id}`);
}

const Content = rendered?.Content;

const title = ensayo?.data?.title || initialEnsayo.data?.title || "Ensayo no titulado";
const subtitle = ensayo?.data?.subtitle || initialEnsayo.data?.subtitle || "";
const coverImage = ensayo?.data?.coverImage || initialEnsayo.data?.coverImage;
const author = ensayo?.data?.author || initialEnsayo.data?.author || "Xavier Benítez";
const date = ensayo?.data?.date || initialEnsayo.data?.date;
const accentColor = ensayo?.data?.accentColor || initialEnsayo.data?.accentColor || "#1a1a1a";

const currentId = ensayo?.id || initialEnsayo.id || "";

// Dynamic template resolution
const templateId = ensayo?.data?.template || "victorian-archeo";
const templateEntry = await getEntry('editorialTemplates', templateId);
const themeKey = templateEntry?.data.themeKey || 'vibe-victorian-archeo';
const vibeClass = themeKey;

const formattedDate = date ? (() => {
  try {
    const d = new Date(date);
    return !isNaN(d.getTime()) 
      ? d.toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' })
      : String(date);
  } catch {
    return String(date);
  }
})() : null;
---

<Layout title={`${title} | The Great Puzzle`} vibeClass={vibeClass}>
  <div 
    class={`ensayos-fullpage-root min-h-screen relative z-10 font-sans pb-20 md:pb-0 ${vibeClass}`} 
    style="background-color: var(--bg-current); color: var(--text-current);"
  >
    <FloatingBackButton />

    <main class="w-full max-w-(--ux-container-max,1500px) mx-auto pt-20 md:pt-28 pb-12 px-4 sm:px-6 lg:px-12">
      
      {/* ── Post Header (Centrado y Expansivo) ── */}
      <header class="w-full max-w-(--ux-reading-max,860px) mx-auto mb-12 md:mb-16 text-center flex flex-col items-center">
        <h1
          class="font-gloock text-4xl sm:text-6xl md:text-7xl lg:text-8xl text-white mb-4 leading-[0.94] text-balance max-w-[24ch] drop-shadow-sm transition-colors duration-500"
          style="color: var(--text-current);"
        >
          {title}
        </h1>
        {
          subtitle && (
            <p 
              class="text-lg sm:text-xl md:text-2xl font-sans text-balance max-w-2xl mx-auto opacity-75 leading-relaxed mb-6 font-light"
              style="color: var(--text-current);"
            >
              {subtitle}
            </p>
          )
        }

        {/* Editorial Metadata */}
        <div class="flex items-center justify-center py-2.5 border-y border-white/10 w-full max-w-lg text-[8px] md:text-[9px] font-tgp-tech tracking-[0.3em] uppercase opacity-60">
          <span>The Great Puzzle Project (Editions)</span>
        </div>
      </header>

      {/* ── Hero / Cover Image (Full-Width Cinematic Canvas) ── */}
      {
        coverImage && (
          <figure class="w-full max-w-(--ux-hero-max,1360px) mx-auto mb-16 md:mb-24 aspect-video md:aspect-21/9 overflow-hidden rounded-2xl md:rounded-3xl bg-black/25 relative shadow-2xl border border-white/5">
            <div
              class="absolute inset-0 z-0 opacity-25 mix-blend-screen pointer-events-none"
              style={`background: linear-gradient(to right, transparent, ${accentColor})`}
            />
            <TgpImage
              src={coverImage}
              alt={title}
              width={1600}
              height={700}
              format="webp"
              loading="eager"
              decoding="sync"
              fetchpriority="high"
              class="w-full h-full object-cover object-center relative z-10 brightness-95 hover:scale-[1.02] transition-transform duration-1000 ease-out"
            />
          </figure>
        )
      }

      {/* ── Prose / Reading Column (Optimizada para Alta Legibilidad) ── */}
      <div class="w-full max-w-(--ux-reading-max,860px) mx-auto mb-20 md:mb-28">
        <article
          class="prose prose-invert prose-lg sm:prose-xl prose-p:font-sans prose-p:leading-[1.85] prose-headings:font-gloock prose-headings:text-white max-w-none"
        >
          {renderError ? (
            <div class="bg-red-900/20 border border-red-500/50 p-8 rounded-lg">
              <h2 class="text-red-400 font-serif mb-4">Error de Sincronización</h2>
              <pre class="mt-4 p-4 bg-black/40 rounded text-xs text-red-300 overflow-x-auto">
                {renderError instanceof Error ? renderError.message : String(renderError)}
              </pre>
            </div>
          ) : (
            Content && <Content />
          )}
        </article>
      </div>

      {/* ── Dynamic Bento Read More Section (Expansivo a Ancho Completo) ── */}
      <section class="w-full max-w-(--ux-grid-max,1360px) mx-auto pt-8 border-t border-white/10">
        <EditorialReadMore collection="ensayos" currentSlug={currentId} vibeClass={vibeClass} />
      </section>

    </main>

    <ArticleFooter vibeClass={vibeClass} pageTitle={title} />
  </div>
</Layout>

<style>
  /* Variables de UX y responsividad editorial fluida */
  .ensayos-fullpage-root {
    --ux-container-max: min(100%, 1500px);
    --ux-hero-max: min(100%, 1360px);
    --ux-reading-max: min(100%, 860px);
    --ux-grid-max: min(100%, 1360px);
  }

  /* Animaciones milimétricas Ken Burns para las fotos */
  @keyframes mm-ken-burns-in {
    0% { transform: scale(1); }
    100% { transform: scale(1.05); }
  }

  @keyframes mm-ken-burns-out {
    0% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

  .mm-kb-in {
    animation: mm-ken-burns-in 30s alternate infinite ease-in-out;
    will-change: transform;
  }

  .mm-kb-out {
    animation: mm-ken-burns-out 30s alternate infinite ease-in-out;
    will-change: transform;
  }
</style>

<script>
  const initEnsayosKenBurns = () => {
    // Seleccionamos las imágenes del contenido (prose) y la imagen principal de portada (figure > img)
    const images = document.querySelectorAll('.ensayos-fullpage-root article img, .ensayos-fullpage-root figure > img');
    
    images.forEach((img, index) => {
      // Aseguramos que el contenedor recorte la imagen para que no desborde al hacer zoom
      const parent = img.parentElement;
      if (parent && parent.tagName.toLowerCase() !== 'figure') {
        parent.style.overflow = 'hidden';
        parent.style.display = 'block';
        parent.style.borderRadius = '1rem'; // Bordes redondeados sutiles para fotos interiores
      }

      // Intercalamos zoom in y zoom out
      if (index % 2 === 0) {
        img.classList.add('mm-kb-in');
      } else {
        img.classList.add('mm-kb-out');
      }
    });
  };

  document.addEventListener('astro:page-load', initEnsayosKenBurns);
</script>
