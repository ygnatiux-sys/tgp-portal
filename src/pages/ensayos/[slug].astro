---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import FloatingBackButton from "../../components/FloatingBackButton.astro";
import EditorialReadMore from "../../components/EditorialReadMore.astro";
import ArticleFooter from "../../components/ArticleFooter.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  try {
    const ensayos = await getCollection("ensayos");
    return ensayos.map((ensayo) => ({
      params: { slug: ensayo.id },
      props: { ensayo },
    }));
  } catch (e) {
    return [];
  }
}

const { ensayo: initialEnsayo } = Astro.props;
import { getEntry } from 'astro:content';

// Re-fetching the entry to ensure we have a fresh reference compatible with the current content layer state
const ensayo = await getEntry('ensayos', initialEnsayo.id);

let renderError: any = null;
const rendered = ensayo ? await render(ensayo).catch((e) => {
  console.error("Error rendering ensayo:", initialEnsayo.id, e);
  renderError = e;
  return null;
}) : null;

if (!ensayo) {
  renderError = new Error(`Ensayo not found: ${initialEnsayo.id}`);
}

const Content = rendered?.Content;

const title = ensayo?.data?.title || initialEnsayo.data?.title || "Ensayo no titulado";
const subtitle = ensayo?.data?.subtitle || initialEnsayo.data?.subtitle || "";
const coverImage = ensayo?.data?.coverImage || initialEnsayo.data?.coverImage;
const author = ensayo?.data?.author || initialEnsayo.data?.author || "Xavier Benítez";
const date = ensayo?.data?.date || initialEnsayo.data?.date;
const accentColor = ensayo?.data?.accentColor || initialEnsayo.data?.accentColor || "#1a1a1a";

const currentId = ensayo?.id || initialEnsayo.id || "";
const avatarId = currentId ? currentId.charCodeAt(0) % 20 : 1;
const authorImg = `https://i.pravatar.cc/150?img=${avatarId}`;

// Dynamic template resolution
const templateId = ensayo?.data?.template || "victorian-archeo";
const templateEntry = await getEntry('editorialTemplates', templateId);
const themeKey = templateEntry?.data.themeKey || 'vibe-victorian-archeo';
const vibeClass = themeKey;
---

<Layout title={`${title} | The Great Puzzle`} vibeClass={vibeClass}>
  <div class={`min-h-screen relative z-10 font-sans pb-20 md:pb-0 ${vibeClass}`} style="background-color: var(--bg-current); color: var(--text-current);">
    <FloatingBackButton />

    <article class="w-full max-w-2xl mx-auto pt-24 md:pt-32 pb-8 px-4 md:px-0">
    {/* Post Header */}
    <header class="mb-12">
      <h1
        class="font-gloock text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-white mb-3 leading-[0.98] text-balance max-w-[22ch]"
      >
        {title}
      </h1>
      {
        subtitle && (
          <p class="text-lg md:text-xl text-gray-400 font-sans leading-relaxed mb-4">
            {subtitle}
          </p>
        )
      }

      {/* Reading Status Note - Exquisite Detail */}
      <div
        class="flex items-center gap-2 mb-4 text-gray-400 text-xs font-semibold uppercase tracking-[0.2em]"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>12 min read</span>
      </div>

      {/* Author & Date info sobrio */}
      <div class="flex items-center gap-3 py-3 border-y border-white/10 text-white/50 text-xs font-tgp-tech uppercase tracking-widest">
        <span class="text-white/80">{author}</span>
        {date && <span>· {date}</span>}
      </div>
    </header>

    {/* Hero Image */}
    {
      coverImage && (
        <figure class="w-full mb-12 aspect-video overflow-hidden rounded-xl bg-black/20 relative">
          <div
            class="absolute inset-0 z-0 opacity-30 mix-blend-screen"
            style={`background: linear-gradient(to right, transparent, ${accentColor})`}
          />
          <img
            src={coverImage}
            alt={title}
            class="w-full h-full object-cover relative z-10"
          />
        </figure>
      )
    }

    {/* Prose Content */}
    <div
      class="prose prose-invert prose-lg prose-p:font-sans prose-p:text-gray-300 prose-headings:font-gloock prose-headings:text-white prose-a:text-[#FF6719] max-w-none"
    >
      {renderError ? (
        <div class="bg-red-900/20 border border-red-500/50 p-8 rounded-lg">
          <h2 class="text-red-400 font-serif mb-4">Error de Sincronización</h2>
          <pre class="mt-4 p-4 bg-black/40 rounded text-xs text-red-300 overflow-x-auto">
            {renderError instanceof Error ? renderError.message : String(renderError)}
          </pre>
        </div>
      ) : (
        Content && <Content />
      )}
    </div>

    {/* Dynamic Read More Section */}
    <EditorialReadMore collection="ensayos" currentSlug={currentId} vibeClass={vibeClass} />
  </article>

  <ArticleFooter vibeClass={vibeClass} pageTitle={title} />
  </div>
</Layout>

<script>
  const likeButtons = document.querySelectorAll(".like-btn");
  likeButtons.forEach((btn) => {
    if (btn.hasAttribute("data-init")) return;
    btn.setAttribute("data-init", "true");
    btn.addEventListener("click", () => {
      const isLiked = btn.getAttribute("data-liked") === "true";
      const countSpan = btn.querySelector(".like-count");
      if (!isLiked) {
        btn.classList.add("liked");
        btn.setAttribute("data-liked", "true");
        if (countSpan) countSpan.textContent = "21.1k";
      } else {
        btn.classList.remove("liked");
        btn.setAttribute("data-liked", "false");
        if (countSpan) countSpan.textContent = "21k";
      }
    });
  });
</script>
