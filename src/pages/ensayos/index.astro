---
import LayoutSubstack from '../../layouts/LayoutSubstack.astro';
import CardEnsayo from '../../components/CardEnsayo.astro';
import { getCollection } from 'astro:content';

let ensayos: any[] = [];
try {
  const ensayosRaw = await getCollection('ensayos');
  ensayos = [...ensayosRaw].sort((a: any, b: any) => b.id.localeCompare(a.id));
} catch (e) {
  // Colección vacía o sin archivos válidos — renderiza estado vacío
}
---

<LayoutSubstack title="Ensayos | The Great Puzzle Feed">
  
  {/* Substack Feed Header */}
  <header class="w-full max-w-2xl mx-auto pt-24 pb-12 px-6 border-b border-white/10 text-center">
    <h1 class="font-gloock text-5xl md:text-7xl text-white mb-4 italic tracking-tight">Feed</h1>
    <p class="text-gray-400 font-sans text-sm md:text-base max-w-md mx-auto">
      Rethinking spatial limits. Pensamientos inmersivos, diarios visuales y notas de diseño sobre la arquitectura del vacío.
    </p>

    <div class="mt-8 flex items-center justify-center gap-4">
        <input type="email" placeholder="Escribe tu email..." class="bg-[#111] border border-white/10 rounded-md px-4 py-2 text-white font-sans text-sm outline-none focus:border-[#FF6719] transition-colors w-64" />
        <button class="bg-[#FF6719] text-white px-6 py-2 rounded-md font-medium text-sm hover:bg-[#e55912] transition-colors">
            Suscribirse
        </button>
    </div>
  </header>

  <main class="w-full pt-16 pb-32 px-4 flex flex-col gap-16">
    {ensayos.map(ensayo => (
      <CardEnsayo ensayo={ensayo} />
    ))}
    
    {ensayos.length === 0 && (
        <div class="text-center py-24 text-gray-500">
            <p>Todavía no hay ensayos publicados.</p>
        </div>
    )}
  </main>
  
</LayoutSubstack>
