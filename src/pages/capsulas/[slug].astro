---
export const prerender = true;

import { getCollection, render } from "astro:content";
import LayoutDark from "../../layouts/LayoutDark.astro";
import HeroMarquee from "../../components/HeroMarquee.astro";
import HeroKenBurns from "../../components/HeroKenBurns.astro";
import HeroParallax from "../../components/HeroParallax.astro";
import HeroMagazine from "../../components/HeroMagazine.astro";
import FloatingBackButton from "../../components/FloatingBackButton.astro";
import EditorialReadMore from "../../components/EditorialReadMore.astro";
import DynamicEditorialGallery from "../../components/DynamicEditorialGallery.astro";
import ArticleFooter from "../../components/ArticleFooter.astro";

export async function getStaticPaths() {
  const archetypes = await getCollection("capsulas");
  return archetypes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
import { getEntry } from 'astro:content';

// Re-fetching the entry to ensure we have a fresh reference compatible with the current content layer state
const freshEntry = await getEntry('capsulas', entry.id);

let renderError: any = null;
const rendered = freshEntry ? await render(freshEntry).catch((e) => {
  console.error("Error rendering capsula:", entry.id, e);
  renderError = e;
  return null;
}) : null;

if (!freshEntry) {
  renderError = new Error(`Capsula not found: ${entry.id}`);
}

const Content = rendered?.Content;

// DICCIONARIO DE ARQUETIPOS (Arquitectura Cerrada)
const ARCHETYPE_CONFIG = {
  "tactile-archive": {
    hero: "cinematic-vintage", // HeroKenBurns
    scale: "max-w-2xl",
    vibe: "vibe-victorian-archeo",
    label: "The Tactile Archive",
  },
  "expansive-gallery": {
    hero: "magazine-luxury", // HeroMagazine
    scale: "w-full",
    vibe: "vibe-museum-luxury",
    label: "The Expansive Gallery",
  },
  "kinetic-manifesto": {
    hero: "cinematic-dark", // HeroMarquee
    scale: "max-w-4xl",
    vibe: "vibe-mid-90s-artsy",
    label: "The Kinetic Manifesto",
  },
  "field-notebook": {
    hero: "apple-os", // HeroParallax
    scale: "max-w-4xl",
    vibe: "vibe-kinfolk-high-design",
    label: "The Field Notebook",
  },
};

const config =
  ARCHETYPE_CONFIG[entry.data.master_archetype] ||
  ARCHETYPE_CONFIG["tactile-archive"];

// Mapeo de Componentes Hero
const HERO_MAP: Record<string, any> = {
  "cinematic-dark": HeroMarquee,
  "cinematic-vintage": HeroKenBurns,
  "apple-os": HeroParallax,
  "magazine-luxury": HeroMagazine,
};

const HeroComponent = HERO_MAP[config.hero];

console.log(`[VOGUE CAPSULA] Rendering ${entry.id}`);
console.log(
  `[VOGUE CAPSULA] Archetype: ${entry.data.master_archetype} -> Vibe: ${config.vibe}`,
);
---

<LayoutDark 
  title={`${entry.data.title} | eBooks | The Great Puzzle`}
  description={`${entry.data.title} — Cápsula y eBook publicado en The Great Puzzle.`}
  hero_image={entry.data.hero_image}
  vibeClass={config.vibe}
  article={{
    publishedTime: entry.data.date ? String(entry.data.date) : undefined,
    author: 'The Great Puzzle',
    section: 'eBooks'
  }}
>
  <FloatingBackButton />

  <HeroComponent
    slot="hero"
    title={entry.data.title}
    imageUrl={entry.data.hero_image}
    vibeClass={config.vibe}
  />

  <div
    class={`editorial-container w-full pt-16 pb-12 px-6 md:px-12 ${config.vibe}`}
    style="background-color: var(--bg-current); color: var(--text-current);"
  >
    <article class="relative">
      <div class={`${config.scale} mx-auto`}>
        {/* Renderizado de Galería Dinámica 1:1 con Lupa de Ampliación */}
        {
          entry.data.editorial_spreads &&
            entry.data.editorial_spreads.length > 0 && (
              <DynamicEditorialGallery spreads={entry.data.editorial_spreads} vibeClass={config.vibe} />
            )
        }

        <div class="prose prose-invert prose-tgp max-w-none">
          {renderError ? (
            <div class="bg-red-900/20 border border-red-500/50 p-8 rounded-lg mt-20">
              <h2 class="text-red-400 font-serif mb-4">Error de Sincronización</h2>
              <pre class="mt-4 p-4 bg-black/40 rounded text-xs text-red-300 overflow-x-auto">
                {renderError instanceof Error ? renderError.message : String(renderError)}
              </pre>
            </div>
          ) : (
            Content && <Content />
          )}
        </div>

        {/* Dynamic Read More Section */}
        <EditorialReadMore collection="capsulas" currentSlug={entry.id} vibeClass={config.vibe} />
      </div>
    </article>
  </div>

  <ArticleFooter vibeClass={config.vibe} pageTitle={entry.data.title} />
</LayoutDark>

<style is:global>
  /* Local Overrides for Archetype Spreads */
  .vibe-victorian-archeo.vibe-target-h1 {
    font-family: "Gloock", serif !important;
  }
</style>
