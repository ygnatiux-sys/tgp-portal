---
export const prerender = true;

import { getCollection, render } from "astro:content";

import LayoutApple from "../../layouts/LayoutApple.astro";
import LayoutVintage from "../../layouts/LayoutVintage.astro";
import LayoutDark from "../../layouts/LayoutDark.astro";

import HeroParallax from "../../components/HeroParallax.astro";
import HeroKenBurns from "../../components/HeroKenBurns.astro";
import HeroMarquee from "../../components/HeroMarquee.astro";
import HeroMagazine from "../../components/HeroMagazine.astro";
import FloatingBackButton from "../../components/FloatingBackButton.astro";
import EditorialStressTest from "../../components/EditorialStressTest.astro";
import ArticleFooter from "../../components/ArticleFooter.astro";

export async function getStaticPaths() {
  const visualSignals = await getCollection("visual_signals");

  // Filtramos por si hay algún documento en borrador o sin slug
  return visualSignals.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
import { getEntry } from 'astro:content';

// Re-fetching the entry to ensure we have a fresh reference compatible with the current content layer state
const freshPost = await getEntry('visual_signals', post.id);
const layoutStyle = freshPost?.data.layout_style || "cinematic-dark";

// 1. Resolvemos la relación con la Plantilla Editorial (TGP Engine v2)
const templateId = freshPost?.data.template || "victorian-archeo";
const templateEntry = await getEntry('editorialTemplates', templateId);
const themeKey = templateEntry?.data.themeKey || 'vibe-victorian-archeo';

console.log(`[VOGUE ENGINE] Rendering ${post.collection}/${post.id}`);
console.log(`[VOGUE ENGINE] Template resolved: ${templateId} -> ${themeKey}`);
console.log(`[VOGUE ENGINE] Layout Style detected: ${layoutStyle}`);

let renderError: any = null;
const rendered = freshPost ? await render(freshPost).catch((e) => {
  console.error("Error rendering visual signal:", post.id, e);
  renderError = e;
  return null;
}) : null;

if (!freshPost) {
  renderError = new Error(`Visual Signal not found: ${post.id}`);
}

const Content = rendered?.Content;

const formatScale = post.data.format_scale || "max-w-4xl";
const enableStressTest = post.data.enable_stress_test || false;

// Mapa de Layouts
const LAYOUT_MAP: Record<string, any> = {
  "apple-os": LayoutApple,
  "cinematic-vintage": LayoutVintage,
  "cinematic-dark": LayoutDark,
  "magazine-luxury": LayoutDark,
};

// Mapa de Heroes
const HERO_MAP: Record<string, any> = {
  "apple-os": HeroParallax,
  "cinematic-vintage": HeroKenBurns,
  "cinematic-dark": HeroMarquee,
  "magazine-luxury": HeroMagazine,
};

const LayoutComponent = LAYOUT_MAP[layoutStyle] || LayoutDark;
const HeroComponent = HERO_MAP[layoutStyle] || HeroMarquee;

console.log(
  `[VOGUE ENGINE] Resolved Hero: ${HeroComponent.name || HeroComponent.title || "DynamicComponent"}`,
);

// Aplicamos el themeKey como vibeClass para el sistema de data-theme
const vibeClass = themeKey;
---

<LayoutComponent title={post.data.title} vibeClass={vibeClass}>
  <FloatingBackButton />
  <HeroComponent
    slot="hero"
    title={post.data.title}
    imageUrl={post.data.hero_image}
    vibeClass={vibeClass}
  />

  <div
    class={`editorial-container w-full pt-16 pb-12 px-6 md:px-12 ${vibeClass}`}
    style="background-color: var(--bg-current);"
  >
    <article
      class={`prose prose-tgp mx-auto ${formatScale} transition-all duration-700 ease-in-out`}
    >
      {
        renderError ? (
          <div class="bg-red-900/20 border border-red-500/50 p-8 rounded-lg mt-20">
            <h2 class="text-red-400 font-serif mb-4">
              Error de Sincronización
            </h2>
            <pre class="mt-4 p-4 bg-black/40 rounded text-xs text-red-300 overflow-x-auto">
              {renderError instanceof Error
                ? renderError.message
                : String(renderError)}
            </pre>
          </div>
        ) : (
          <>
            {enableStressTest ? (
              <EditorialStressTest />
            ) : (
              Content && <Content />
            )}
          </>
        )
      }
    </article>

    {
      post.data.editorial_spreads && post.data.editorial_spreads.length > 0 && (
        <div class="mt-32 space-y-48">
          {post.data.editorial_spreads.map((spread: any) => {
            const type = spread.value.spread_type;
            const spreadClass =
              type === "full-bleed"
                ? "w-screen -mx-6 md:-mx-12"
                : type === "asymmetric-diptych"
                  ? "spread-asymmetric-diptych"
                  : type === "tactile-overlap"
                    ? "spread-tactile-overlap"
                    : type === "kinfolk-grid"
                      ? "spread-kinfolk-grid"
                      : "max-w-7xl mx-auto";

            return (
              <div class={`spread-wrapper ${spreadClass} ${vibeClass}`}>
                <div
                  class={`${type === "full-bleed" || type === "diptych" || type === "portrait-float" ? "grid grid-cols-1 md:grid-cols-2 gap-4" : ""}`}
                >
                  {spread.value.images.map((img: string) => (
                    <img src={img} class="w-full h-auto object-cover" alt="" />
                  ))}
                </div>
                {spread.value.caption && (
                  <p class="spread-caption">{spread.value.caption}</p>
                )}
              </div>
            );
          })}
        </div>
      )
    }
  </div>

  <ArticleFooter vibeClass={vibeClass} pageTitle={freshPost?.data.title} />
</LayoutComponent>
