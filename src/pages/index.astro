---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Premium Component Bundle
import CinematographicHero from '../components/CinematographicHero.astro';
import Stratigraphic from '../components/Stratigraphic.astro';
import BentoTrilitico from '../components/BentoTrilitico.astro';
import CardEnsayo from '../components/CardEnsayo.astro';

// 1. DATA PHASE: Recuperación y Refino de Alta Fidelidad
const essaysRaw = await getCollection('essays');
const architecturesRaw = await getCollection('architectures');
const visualSignalsRaw = await getCollection('visual_signals');

// Sorting helper by ID as proxy for date (Desc)
const sortByLatest = (a: any, b: any) => b.id.localeCompare(a.id);

const essays = [...essaysRaw].sort(sortByLatest).slice(0, 3);
const architectures = [...architecturesRaw].sort(sortByLatest).slice(0, 3);
const visualSignals = [...visualSignalsRaw].sort(sortByLatest).slice(0, 5);

let ensayosRaw: any[] = [];
try { ensayosRaw = await getCollection('ensayos'); } catch (e) {}
const ensayos = [...ensayosRaw].sort(sortByLatest).slice(0, 3);
const latestEnsayo = ensayosRaw.length > 0
  ? [...ensayosRaw].sort((a: any, b: any) => {
      const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
      const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
      return dateB - dateA || b.id.localeCompare(a.id);
    })[0]
  : null;

// Identificar el post global más reciente para el HERO (Protagonista)
const allPosts = [...essaysRaw, ...architecturesRaw, ...visualSignalsRaw, ...ensayosRaw].sort(sortByLatest);
const featuredPost = allPosts[0];

// Inyección de "Física Condicionada" para Landing
const landingVibe = "vibe-victorian-archeo"; // Default premium vibe for registration
---

<Layout title="The Great Puzzle | Cinematic Portal">
  
  <main class="bg-racing-green overflow-x-hidden">
    
    {/* FASE 0: IDENTIDAD DE MARCA (BRAND INTRO) */}
    <section id="phase-intro" class="relative h-screen w-full flex items-center justify-center bg-racing-green z-60 overflow-hidden">
      <div class="relative z-10 text-center">
        <h1 class="font-gloock text-[10vw] md:text-[8rem] text-white tracking-[0.3em] uppercase leading-none opacity-0 translate-y-12 animate-intro-load">
          The Great Puzzle
        </h1>
        <p class="mt-12 font-sans text-[11px] tracking-[1.5em] uppercase text-copper-ember/60 font-medium opacity-0 animate-intro-load delay-500">
          Project 2026 • Editorial Collective
        </p>
      </div>
      {/* Sutil textura táctil bg overlay */}
      <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('https://www.transparenttextures.com/patterns/dark-leather.png');"></div>
    </section>

    {/* FASE 1: EL GRAN PROTAGONISTA (PREMIUM HERO) */}
    <section id="phase-hero" class="relative z-50 transition-colors duration-1000" style={featuredPost?.collection === 'ensayos' ? `background-color: ${featuredPost.data.accentColor}` : ''}>
      <CinematographicHero 
        title={featuredPost?.data.title || "TGP ARCHIVE"}
        subtitle={`Latest Archetype • ${featuredPost?.collection.replace('_', ' ')}`}
        image={featuredPost?.data.hero_image || featuredPost?.data.coverImage || 'https://images.unsplash.com/photo-1478720568477-152d9b164e26?q=80&w=2670'}
        link={`/${featuredPost?.collection.replace('_', '-')}/${featuredPost?.id}`}
        vibeClass={landingVibe}
      />
    </section>

    {/* FASE 2: CUERPO EDITORIAL (THE PILLARS) */}
    <div id="content-body" class="relative z-40 bg-racing-green">
      
      {/* 2.1: SECCIÓN ESSAYS (MARQUEE PHYSICS) */}
      <section id="essays-section" class="relative py-48 overflow-hidden pointer-events-none">
        <div class="max-w-7xl mx-auto px-6 mb-24 pointer-events-auto">
          <h3 class="font-gloock text-8xl md:text-9xl text-white italic opacity-20">Essays</h3>
          <p class="text-[10px] tracking-[0.5em] text-copper-ember uppercase mt-6 font-bold">Infinite Meta-Theory</p>
        </div>

        {/* Horizontal Marquee for ESSAY CARDS */}
        <div class="essays-marquee-container flex gap-12 select-none pointer-events-auto hover:pause-marquee">
          <div class="essays-marquee-track flex gap-12 py-10">
            {[1, 2].map(() => (
              essays.map((post) => (
                <a href={`/essays/${post.id}`} class="group relative block w-[400px] aspect-4/5 bg-white/5 overflow-hidden rounded-sm border border-white/5 transition-all duration-700 hover:border-copper-ember/50 card-lut-fade">
                  <img src={post.data.hero_image} class="w-full h-full object-cover grayscale brightness-50 group-hover:grayscale-0 group-hover:brightness-100 group-hover:scale-110 transition-all duration-1000" />
                  <div class="absolute inset-0 bg-linear-to-t from-black/90 to-transparent p-12 flex flex-col justify-end">
                    <h4 class="font-serif text-4xl text-white group-hover:text-copper-ember transition-colors">{post.data.title}</h4>
                    <span class="text-[8px] tracking-[0.4em] uppercase text-gray-500 mt-4">Research V-01</span>
                  </div>
                </a>
              ))
            ))}
          </div>
        </div>
      </section>

      {/* 2.2: SECCIÓN ARCHITECTURES (STRATIGRAPHIC PHYSICS) */}
      <section id="architectures-section" class="relative bg-black/20 border-y border-white/5 overflow-hidden">
        <div class="max-w-7xl mx-auto py-32 px-6 relative z-60">
          <h3 class="font-gloock text-8xl md:text-9xl text-white italic text-right">Form</h3>
          <p class="text-[10px] tracking-[0.5em] text-copper-ember uppercase mt-6 font-bold text-right">Spatial Ontologies</p>
        </div>

        <Stratigraphic 
          vibeClass={landingVibe}
          items={architectures.map(post => ({
            title: post.data.title,
            subtitle: "Spatial Ontology Research",
            image: post.data.hero_image,
            link: `/architectures/${post.id}`
          }))}
        />
      </section>

      {/* 2.3: SECCIÓN VISUAL SIGNALS (BENTO TRILÍTICO) */}
      <section id="signals-section" class="relative bg-racing-green/20">
        <div class="max-w-7xl mx-auto pt-48 px-6">
          <h3 class="font-gloock text-8xl md:text-9xl text-white italic">Signals</h3>
          <p class="text-[10px] tracking-[0.5em] text-copper-ember uppercase mt-6 font-bold">Semiotic Markers</p>
        </div>

        <BentoTrilitico 
          vibeClass={landingVibe}
          posts={visualSignals.map(post => ({
            title: post.data.title,
            image: post.data.hero_image,
            link: `/visual-signals/${post.id}`,
            category: "Visual Signals",
            id: post.id
          }))}
        />
      </section>

      {/* 2.4: SECCIÓN ENSAYOS (SUBSTACK FEED) */}
      <section id="ensayos-feed-section" class="relative bg-black py-48 overflow-hidden pointer-events-none border-t border-white/5">
        <div class="max-w-7xl mx-auto px-6 mb-16 pointer-events-auto">
          <h3 class="font-gloock text-8xl md:text-9xl text-white italic">Feed</h3>
          <p class="text-[10px] tracking-[0.5em] text-[#FF6719] uppercase mt-6 font-bold">Inmersive Thoughts</p>
        </div>

        {ensayos.length > 0 ? (
          <div class="ensayos-marquee-container flex gap-8 select-none pointer-events-auto">
            <div class="ensayos-marquee-track flex gap-8 py-6">
              {[1, 2].map(() =>
                ensayos.map((ensayo: any) => (
                  <a
                    href={`/ensayos/${ensayo.id}`}
                    class="ensayo-card group relative shrink-0 w-[340px] h-[440px] bg-[#0a0a0a] overflow-hidden rounded-sm border border-white/5 transition-all duration-700 hover:border-[#FF6719]/40 card-lut-fade block"
                  >
                    {ensayo.data.coverImage ? (
                      <img
                        src={ensayo.data.coverImage}
                        alt={ensayo.data.title}
                        class="w-full h-full object-cover grayscale brightness-40 group-hover:grayscale-0 group-hover:brightness-90 group-hover:scale-105 transition-all duration-1000"
                      />
                    ) : (
                      <div class="w-full h-full" style={`background: linear-gradient(135deg, ${ensayo.data.accentColor || '#1a1a1a'}, #050505)`} />
                    )}
                    <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/30 to-transparent p-8 flex flex-col justify-end">
                      {ensayo.id === latestEnsayo?.id && (
                        <span class="mb-3 inline-flex items-center gap-1.5 text-[9px] tracking-[0.35em] uppercase text-[#FF6719] font-bold">
                          <span class="w-1.5 h-1.5 rounded-full bg-[#FF6719] animate-pulse"></span>
                          Último
                        </span>
                      )}
                      <h4 class="font-gloock text-3xl text-white group-hover:text-[#FF6719] transition-colors duration-500 leading-tight mb-3">
                        {ensayo.data.title || 'Sin título'}
                      </h4>
                      {ensayo.data.subtitle && (
                        <p class="text-gray-500 text-xs leading-relaxed line-clamp-2 group-hover:text-gray-300 transition-colors duration-500">
                          {ensayo.data.subtitle}
                        </p>
                      )}
                      <div class="mt-4 flex items-center justify-between">
                        <span class="text-[8px] tracking-[0.4em] uppercase text-gray-600">
                          {ensayo.data.author || 'Xavier Benítez'}
                        </span>
                        <svg class="w-4 h-4 text-white/20 group-hover:text-[#FF6719] group-hover:translate-x-1 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/>
                        </svg>
                      </div>
                    </div>
                  </a>
                ))
              )}
            </div>
          </div>
        ) : (
          <p class="text-center text-gray-700 text-sm pointer-events-auto px-6">Próximamente en el Feed.</p>
        )}

        <div class="max-w-7xl mx-auto px-6 mt-16 pointer-events-auto">
          <a
            href="/ensayos"
            class="inline-flex items-center gap-3 text-[10px] tracking-[0.4em] uppercase text-white/30 hover:text-[#FF6719] transition-colors group"
          >
            Ver todos los ensayos
            <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </section>

      {/* FASE 3: FOOTER INSTITUCIONAL */}
      <footer class="relative bg-black pt-64 pb-24 px-8 border-t border-white/5">
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-4 gap-24 mb-48">
          <div class="lg:col-span-2">
            <h5 class="font-gloock text-6xl text-white mb-10 tracking-tighter">The Great Puzzle</h5>
            <p class="text-gray-500 max-w-md font-sans font-light tracking-wide leading-relaxed">
              Exploración experimental de la intersección entre memoria arquitectónica y lenguaje visual. Un laboratorio de diseño especulativo.
            </p>
          </div>
          <div>
            <h6 class="text-[11px] tracking-[0.4em] uppercase text-copper-ember mb-8 font-bold">Exploración</h6>
            <ul class="space-y-4 text-xs tracking-widest text-gray-400 font-sans">
              <li><a href="/ensayos" class="hover:text-white transition-colors">// Ensayos</a></li>
              <li><a href="/essays" class="hover:text-white transition-colors">// Essays</a></li>
              <li><a href="/architectures" class="hover:text-white transition-colors">// Architectures</a></li>
              <li><a href="/visual-signals" class="hover:text-white transition-colors">// Signals</a></li>
              <li><a href="/capsulas" class="hover:text-white transition-colors">// Cápsulas</a></li>
            </ul>
          </div>
          <div>
            <h6 class="text-[11px] tracking-[0.4em] uppercase text-copper-ember mb-8 font-bold">Contacto</h6>
            <a href="mailto:archive@thegreatpuzzle.com" class="text-xl text-white font-serif block mb-6 hover:text-copper-ember transition-colors">archive@tgp.com</a>
            <p class="text-[9px] tracking-[0.3em] uppercase text-gray-600">Alvear • Buenos Aires • 2026</p>
          </div>
        </div>
        <div class="max-w-7xl mx-auto pt-12 border-t border-white/5 flex justify-between items-center text-[8px] tracking-[0.4em] uppercase text-gray-700">
          <p>The Great Puzzle Project © Xavier Benítez</p>
          <p>Built with Deep Atrophic Vision</p>
        </div>
      </footer>
    </div>
  </main>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener('astro:page-load', () => {
      // 0. INITIAL LOAD ANIMATIONS
      gsap.to('.animate-intro-load', {
        opacity: 1,
        y: 0,
        stagger: 0.3,
        duration: 2,
        ease: "power4.out"
      });

      // 1. PHASE 0 -> PHASE 1 REVEAL (The Intro Slide-up)
      const introTl = gsap.timeline({
        scrollTrigger: {
          trigger: '#phase-intro',
          start: 'top top',
          end: '+=100%',
          scrub: true,
          pin: true,
          snap: 1
        }
      });
      introTl.to('#phase-intro h1', { scale: 1.5, opacity: 0, duration: 1 })
            .to('#phase-intro p', { y: 100, opacity: 0, duration: 1 }, 0);

      // 2. PHASE 1 HERO ORCHESTRATION
      // Infinite Marquee Track
      gsap.to('.marquee-track', {
        xPercent: -66.666,
        duration: 120,
        ease: "none",
        repeat: -1
      });

      // 4. PHASE 2 PHYSICS: ESSAYS MARQUEE
      gsap.to('.essays-marquee-track', {
        x: "-50%",
        ease: "none",
        repeat: -1,
        duration: 40,
        scrollTrigger: {
          trigger: '#essays-section',
          start: "top bottom",
          end: "bottom top",
          toggleActions: "play pause resume pause"
        }
      });

      // 5. ENSAYOS FEED MARQUEE — slow, Substack-style
      const ensayosTrack = document.querySelector('.ensayos-marquee-track');
      if (ensayosTrack) {
        const ensayosTween = gsap.to('.ensayos-marquee-track', {
          x: "-50%",
          ease: "none",
          repeat: -1,
          duration: 60,
          scrollTrigger: {
            trigger: '#ensayos-feed-section',
            start: "top bottom",
            end: "bottom top",
            toggleActions: "play pause resume pause"
          }
        });

        // Pause on individual card hover
        document.querySelectorAll('.ensayo-card').forEach(card => {
          card.addEventListener('mouseenter', () => ensayosTween.pause());
          card.addEventListener('mouseleave', () => ensayosTween.resume());
        });
      }
    });
  </script>

  <style>
    .font-gloock { font-family: 'Gloock', serif; }
    
    /* Discovery LUT Effect */
    .card-lut-fade img {
      filter: grayscale(1) contrast(1.1) brightness(0.6) sepia(0.2);
      transition: filter 1s cubic-bezier(0.23, 1, 0.32, 1);
    }
    .card-lut-fade:hover img {
      filter: grayscale(0) contrast(1) brightness(1) sepia(0);
    }

    /* Selection Color */
    ::selection {
      background: #B87333;
      color: black;
    }

    /* Grainy Overlay */
    main::after {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url("https://grainy-gradients.vercel.app/noise.svg");
      opacity: 0.05;
      pointer-events: none;
      z-index: 200;
    }

    /* Section Headings Background Glow */
    section h3 {
      text-shadow: 0 0 100px rgba(184, 115, 51, 0.2);
    }
  </style>
</Layout>
