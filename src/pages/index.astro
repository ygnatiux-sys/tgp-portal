---
/**
 * index.astro — Ruta: / (Página de Inicio por Defecto)
 *
 * Pantalla de bienvenida cinematográfica de The Great Puzzle.
 * Dos actos:
 *   1. VOID HERO — letras que emergen del negro profundo
 *   2. VERTICAL MARQUEE SEAMLESS — cinta de posts con formato editorial y navegación directa
 *
 * Usa VoidIntroPage.astro como componente principal.
 */
import LayoutPortal from '../layouts/LayoutPortal.astro';
import VoidIntroPage from '../components/VoidIntroPage.astro';
import { getCollection } from 'astro:content';

// ─── DATA PHASE ────────────────────────────────────────────────────
let essaysRaw: any[] = [];
let architecturesRaw: any[] = [];
let visualSignalsRaw: any[] = [];
let ensayosRaw: any[] = [];
let capsulasRaw: any[] = [];

try { essaysRaw        = await getCollection('essays'); }        catch {}
try { architecturesRaw = await getCollection('architectures'); } catch {}
try { visualSignalsRaw = await getCollection('visual_signals'); } catch {}
try { ensayosRaw       = await getCollection('ensayos'); }       catch {}
try { capsulasRaw      = await getCollection('capsulas'); }      catch {}

// ─── NORMALIZADOR ──────────────────────────────────────────────────
type SizeType = 'portrait' | 'square' | 'landscape';
const SIZES: SizeType[] = ['portrait', 'square', 'landscape'];

const normalize = (post: any, col: string, idx: number) => ({
  title:      post.data?.title       ?? 'Sin título',
  eyebrow:    post.data?.subtitle    ?? formatCol(col),
  href:       `/${col.replace('_', '-')}/${post.id}`,
  image:      post.data?.hero_image  ?? post.data?.coverImage ?? 'https://storage.thegreatpuzzleproject.com/default-hero.webp',
  alt:        post.data?.title       ?? '',
  size:       SIZES[idx % 3] as SizeType,
  collection: col,
  author:     post.data?.author      ?? 'TGP',
  date:       post.data?.date        ? String(post.data.date) : undefined,
});

function formatCol(col: string): string {
  const c = col.toLowerCase();
  if (c === 'essays') return 'Dossiers';
  if (c === 'architectures') return 'Magazines';
  if (c === 'visual_signals') return 'Collections';
  if (c === 'capsulas') return 'eBooks';
  if (c === 'ensayos') return 'Ensayos';
  return col;
}

const sortByLatest = (a: any, b: any) => {
  const dA = a.data?.date ? new Date(String(a.data.date)).getTime() : Date.now();
  const dB = b.data?.date ? new Date(String(b.data.date)).getTime() : Date.now();
  return dB - dA;
};

const essays        = essaysRaw.filter(p => !p.data?.draft).sort(sortByLatest);
const architectures = architecturesRaw.filter(p => !p.data?.draft).sort(sortByLatest);
const visualSignals = visualSignalsRaw.filter(p => !p.data?.draft).sort(sortByLatest);
const ensayos       = ensayosRaw.filter(p => !p.data?.draft).sort(sortByLatest);
const capsulas      = capsulasRaw.filter(p => !p.data?.draft).sort(sortByLatest);

// Pool mezclado para darle variedad visual
const allMixed = [
  ...ensayos.map((p, i) => normalize(p, 'ensayos', i)),
  ...essays.map((p, i) => normalize(p, 'essays', i)),
  ...architectures.map((p, i) => normalize(p, 'architectures', i)),
  ...visualSignals.map((p, i) => normalize(p, 'visual_signals', i)),
  ...capsulas.map((p, i) => normalize(p, 'capsulas', i)),
].sort((a, b) => {
  const dA = a.date ? new Date(a.date).getTime() : 0;
  const dB = b.date ? new Date(b.date).getTime() : 0;
  return dB - dA;
});
---

<LayoutPortal
  title="Bienvenidos a The Great Puzzle | Portal Editorial"
  description="Arqueosemiótica, filosofía y cartografía del pensamiento contemporáneo. Portal editorial de The Great Puzzle Project."
  bgClass="bg-[#121413]"
  showFooter={false}
  showFooterMarquee={false}
>
  <VoidIntroPage
    items={allMixed}
    label="Explorar el Archivo TGP"
  />
</LayoutPortal>
