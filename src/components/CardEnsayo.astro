---
import TgpImage from './TgpImage.astro';

interface Props {
  ensayo: any;
  featured?: boolean;
}
const { ensayo, featured = false } = Astro.props;
// Usar un avatar de prueba basado en el slug o id para que sea determinista
const avatarId = ensayo.id ? ensayo.id.charCodeAt(0) % 20 : 1;
const authorImg = `https://i.pravatar.cc/150?img=${avatarId}`;
const { title = "Ensayo no titulado", subtitle = "", coverImage, author = "Xavier Benítez", date = "", accentColor = "#1a1a1a" } = ensayo.data || {};
---
<article class={`flex flex-col w-full max-w-2xl mx-auto overflow-hidden bg-[#050505] border-b border-white/10 pb-12 relative group ${featured ? 'featured-ensayo' : ''}`}>
  {/* Header with image */}
  <a href={`/ensayos/${ensayo.id}`} class="relative w-full aspect-4/3 sm:aspect-video overflow-hidden rounded-xl bg-[#0a0a0a] block mb-8">
    <div class="absolute inset-0 z-0" style={`background: linear-gradient(to bottom, transparent, ${accentColor}40)`} />
    {coverImage && (
      <TgpImage
        src={coverImage}
        alt={title}
        width={800}
        height={600}
        format="webp"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover mix-blend-overlay opacity-60 group-hover:scale-105 group-hover:opacity-80 transition-all duration-700 ease-out"
      />
    )}
    <div class="absolute inset-0 bg-linear-to-t from-[#050505] via-transparent to-transparent z-10" />
    
    {/* Translucent Bookmark - Repositioned to bottom-right as per request */}
    <button class="absolute bottom-4 right-4 bg-black/40 backdrop-blur-md p-2.5 rounded-xl text-white hover:bg-[#FF6719] hover:text-black transition-all duration-300 z-20 shadow-lg border border-white/5" aria-label="Bookmark">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
    </button>
  </a>

  {/* Content */}
  <div class="px-2">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4 mb-4">
        <a href={`/ensayos/${ensayo.id}`} class="block group text-left">
            <h2 class="font-gloock text-3xl sm:text-4xl text-white mb-3 group-hover:text-[#FF6719] transition-colors">{title}</h2>
            <p class="text-gray-400 font-sans leading-relaxed sm:text-lg">{subtitle}</p>
        </a>
    </div>

    {/* Reading Status Note - Exquisite Detail */}
    <div class="flex items-center gap-2 mb-3 text-gray-400 text-xs font-semibold uppercase tracking-[0.2em]">
       <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
       </svg>
       <span>6 min read</span>
    </div>

    {/* Author Meta */}
    <div class="flex items-center gap-3">
      <TgpImage
        src={authorImg}
        alt={author}
        width={96}
        height={96}
        format="webp"
        loading="lazy"
        decoding="async"
        class="w-12 h-12 rounded-full border border-white/10"
      />
      <div>
        <div class="flex items-center gap-2">
            <span class="text-white font-medium">{author}</span>
            <span class="text-gray-600 text-xs">•</span>
            <button class="text-[#FF6719] text-sm hover:underline font-bold uppercase tracking-wider">Suscribirse</button>
        </div>
        <span class="text-gray-500 font-serif italic text-sm">{date}</span>
      </div>
    </div>
    
    {/* Footer Interactions - Exactly as requested */}
    <div class="mt-8 pt-4 flex justify-between items-center text-gray-500">
      <button 
        class="like-btn flex items-center gap-2 text-gray-400 hover:text-[#FF6719] transition-colors group/like"
        data-liked="false"
      >
        <svg class="w-5 h-5 transition-all group-[.liked]/like:fill-[#FF6719] group-[.liked]/like:text-[#FF6719] group-[.liked]/like:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
        </svg>
        <span class="like-count">21k</span>
      </button>

      <div class="flex items-center gap-4">
        <button class="hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
        </button>
        <button class="hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
        </button>
      </div>
    </div>
  </div>
</article>

<script>
  // Script estático para simular la interacción en el cliente
  const likeButtons = document.querySelectorAll('.like-btn');
  
  likeButtons.forEach(btn => {
    if (btn.hasAttribute('data-init')) return;
    btn.setAttribute('data-init', 'true');
    
    btn.addEventListener('click', () => {
      const isLiked = btn.getAttribute('data-liked') === 'true';
      const countSpan = btn.querySelector('.like-count');
      
      if (!isLiked) {
        btn.classList.add('liked');
        btn.setAttribute('data-liked', 'true');
        // Simulación visual
        if(countSpan) countSpan.textContent = '21.1k';
      } else {
        btn.classList.remove('liked');
        btn.setAttribute('data-liked', 'false');
        if(countSpan) countSpan.textContent = '21k';
      }
    });
  });
</script>
