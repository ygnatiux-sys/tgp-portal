---
/**
 * AIPendingNotice.astro — Fallback & Centro de Diagnóstico Interactivo Gemini API
 * 
 * Se muestra cuando un post está vacío o pendiente de generación.
 * Permite diagnosticar el estado de la API de Gemini y disparar la generación
 * directamente desde el navegador con 1 solo clic.
 */

interface Props {
  title: string;
  copilotConfig?: {
    generation_mode?: string;
    trigger_both?: boolean;
    trigger_text_only?: boolean;
    trigger_image_only?: boolean;
    image_style_hint?: string;
  };
  collection?: string;
  slug?: string;
}

const { title, copilotConfig, collection = "essays", slug = "" } = Astro.props;

const mode = copilotConfig?.generation_mode || (copilotConfig?.trigger_both ? 'both' : (copilotConfig?.trigger_text_only ? 'text_only' : (copilotConfig?.trigger_image_only ? 'image_only' : 'empty')));

const hasApiKey = Boolean(import.meta.env.GEMINI_API_KEY && !import.meta.env.GEMINI_API_KEY.includes('tu_gemini_api_key'));
const uniqueId = "ai-pending-" + Math.random().toString(36).substring(2, 9);
---

<div id={uniqueId} class="ai-pending-wrapper w-full max-w-4xl mx-auto my-12 p-8 md:p-12 rounded-2xl border border-amber-500/40 bg-linear-to-b from-[#16120c] via-[#0d0b08] to-black shadow-2xl relative overflow-hidden text-neutral-200">
  <!-- Glow decorativo superior -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-0.5 bg-linear-to-r from-transparent via-amber-400 to-transparent"></div>
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-48 bg-amber-500/10 blur-3xl pointer-events-none"></div>

  <!-- Encabezado del Cartel -->
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-amber-500/20 pb-6 mb-8">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-amber-500/20 border border-amber-400/60 flex items-center justify-center text-xl animate-pulse">
        ⏳
      </div>
      <div>
        <span class="text-xs uppercase tracking-widest text-amber-400 font-mono font-semibold">Scriptorium AI Studio · Diagnóstico</span>
        <h3 class="text-2xl font-serif text-amber-100 mt-0.5">{title}</h3>
      </div>
    </div>
    
    <!-- Badge de Estado API -->
    <div class="flex items-center gap-2">
      {hasApiKey ? (
        <span class="px-3.5 py-1.5 rounded-full text-xs font-mono tracking-wide bg-emerald-950/80 text-emerald-300 border border-emerald-500/40 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          GEMINI API: CONECTADA
        </span>
      ) : (
        <span class="px-3.5 py-1.5 rounded-full text-xs font-mono tracking-wide bg-red-950/80 text-red-300 border border-red-500/40 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-red-400 animate-ping"></span>
          GEMINI API: FALTA CLAVE (.env)
        </span>
      )}
    </div>
  </div>

  <!-- Diagnóstico detallado -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <!-- Bloque 1: Solicitud detectada -->
    <div class="bg-black/50 border border-neutral-800 rounded-xl p-5">
      <h4 class="text-sm uppercase tracking-wider text-neutral-400 font-mono mb-3 flex items-center gap-2">
        <span>🎛️</span> Opciones Solicitadas en CMS
      </h4>
      <ul class="space-y-2 text-sm">
        <li class="flex items-center justify-between">
          <span class="text-neutral-400">Modo de Generación:</span>
          <span class="font-mono text-amber-300 font-medium">{mode}</span>
        </li>
        <li class="flex items-center justify-between">
          <span class="text-neutral-400">✍️ Redacción Erudita (Gemini):</span>
          <span class={copilotConfig?.trigger_both || copilotConfig?.trigger_text_only ? "text-emerald-400 font-mono" : "text-neutral-500 font-mono"}>
            {copilotConfig?.trigger_both || copilotConfig?.trigger_text_only ? "SOLICITADO" : "Inactivo"}
          </span>
        </li>
        <li class="flex items-center justify-between">
          <span class="text-neutral-400">🎨 Render Veo 3 / Imagen:</span>
          <span class={copilotConfig?.trigger_both || copilotConfig?.trigger_image_only ? "text-emerald-400 font-mono" : "text-neutral-500 font-mono"}>
            {copilotConfig?.trigger_both || copilotConfig?.trigger_image_only ? "SOLICITADO" : "Inactivo"}
          </span>
        </li>
        {copilotConfig?.image_style_hint && (
          <li class="flex items-center justify-between">
            <span class="text-neutral-400">Estilo Visual:</span>
            <span class="font-mono text-neutral-300 text-xs">{copilotConfig.image_style_hint}</span>
          </li>
        )}
      </ul>
    </div>

    <!-- Bloque 2: Diagnóstico de Gemini API -->
    <div class="bg-black/50 border border-neutral-800 rounded-xl p-5">
      <h4 class="text-sm uppercase tracking-wider text-neutral-400 font-mono mb-3 flex items-center gap-2">
        <span>🔍</span> Diagnóstico del Sistema
      </h4>
      <p class="text-xs leading-relaxed text-neutral-300">
        {hasApiKey ? (
          <span>
            Tu clave <code class="text-amber-300 bg-black px-1.5 py-0.5 rounded font-mono">GEMINI_API_KEY</code> está cargada en el servidor. Puedes pulsar el botón inferior para ejecutar la redacción con el prompt <strong>Erudito Divulgativo</strong> y escribir automáticamente el archivo <code class="text-amber-300 font-mono">.mdoc</code>.
          </span>
        ) : (
          <span class="text-red-300">
            No se detectó una clave válida en tu archivo <code class="text-white font-mono">.env</code>. Agrega <code class="text-white font-mono">GEMINI_API_KEY=tu_clave</code> para activar la generación asistida.
          </span>
        )}
      </p>
      <p class="text-xs leading-relaxed text-neutral-400 mt-2">
        Colección de destino: <strong class="text-amber-200">{collection}</strong> · Slug: <strong class="text-amber-200">{slug}</strong>
      </p>
    </div>
  </div>

  <!-- Caja de Acción y Disparo Interactivo -->
  <div class="p-6 rounded-xl bg-amber-500/10 border border-amber-500/30 flex flex-col md:flex-row items-start md:items-center justify-between gap-5">
    <div>
      <h4 class="text-amber-200 font-serif text-lg mb-1">¿Generar el ensayo de "{title}" ahora?</h4>
      <p class="text-xs text-neutral-300">
        Dispara la llamada directa a Gemini 1.5 con el prompt <strong>Erudito Divulgativo</strong> configurado en <code class="text-amber-300 font-mono">geminiPrompts.ts</code>.
      </p>
      
      <!-- Mensaje de estado dinámico -->
      <div class="status-box mt-3 text-xs font-mono hidden"></div>
    </div>

    <div class="flex items-center gap-3 w-full md:w-auto">
      <button 
        type="button"
        class="generate-btn px-5 py-3 bg-linear-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-black font-semibold rounded-lg text-xs font-mono transition-all transform hover:scale-[1.02] active:scale-[0.98] shadow-lg flex items-center justify-center gap-2 cursor-pointer w-full md:w-auto"
        data-collection={collection}
        data-slug={slug}
        data-title={title}
      >
        <span>⚡</span>
        <span>GENERAR CON GEMINI AHORA</span>
      </button>

      <a 
        href={`/keystatic/collection/${collection}/item/${slug}`}
        class="px-4 py-3 bg-neutral-900 hover:bg-neutral-800 border border-neutral-700 text-neutral-300 rounded-lg text-xs font-mono transition-colors whitespace-nowrap hidden sm:inline-block"
      >
        ✏️ Keystatic
      </a>
    </div>
  </div>
</div>

<script>
  function setupAIGenerator() {
    const wrappers = document.querySelectorAll('.ai-pending-wrapper');
    
    wrappers.forEach((wrapper) => {
      const btn = wrapper.querySelector('.generate-btn') as HTMLButtonElement | null;
      const statusBox = wrapper.querySelector('.status-box') as HTMLDivElement | null;
      
      if (!btn || btn.dataset.initialized) return;
      btn.dataset.initialized = 'true';

      btn.addEventListener('click', async () => {
        const collection = btn.dataset.collection || 'essays';
        const slug = btn.dataset.slug || '';
        const title = btn.dataset.title || '';

        btn.disabled = true;
        btn.innerHTML = '<span>⏳</span><span>REDACTANDO CON GEMINI...</span>';
        btn.classList.add('opacity-75', 'cursor-not-allowed');

        if (statusBox) {
          statusBox.classList.remove('hidden', 'text-red-400', 'text-emerald-400');
          statusBox.classList.add('text-amber-300');
          statusBox.textContent = '🚀 Conectando con Gemini API y estructurando el ensayo erudito...';
        }

        try {
          const res = await fetch('/api/scriptorium/generate-post-file', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ collection, slug, title })
          });

          const result = await res.json();

          if (result.success) {
            if (statusBox) {
              statusBox.classList.remove('text-amber-300');
              statusBox.classList.add('text-emerald-400');
              statusBox.textContent = `✅ ¡Éxito! ${result.message} (${result.wordCount || ''} palabras). Recargando página...`;
            }
            btn.innerHTML = '<span>✅</span><span>¡LISTO! RECARGANDO...</span>';
            setTimeout(() => {
              window.location.reload();
            }, 1200);
          } else {
            throw new Error(result.error || 'Error desconocido al invocar Gemini.');
          }
        } catch (err: any) {
          console.error('[AI GENERATOR ERROR]', err);
          btn.disabled = false;
          btn.classList.remove('opacity-75', 'cursor-not-allowed');
          btn.innerHTML = '<span>⚠️</span><span>REINTENTAR GENERACIÓN</span>';
          
          if (statusBox) {
            statusBox.classList.remove('hidden', 'text-amber-300');
            statusBox.classList.add('text-red-400');
            statusBox.textContent = `❌ Falló la generación: ${err.message}`;
          }
        }
      });
    });
  }

  // Inicializar en carga y tras navegaciones de Astro
  setupAIGenerator();
  document.addEventListener('astro:page-load', setupAIGenerator);
</script>
