---
interface Props {
  title: string;
  subtitle?: string;
  imageUrl?: string;
  vibeClass?: string;
}
const {
  title,
  subtitle = "Apple Editorial",
  imageUrl = "",
  vibeClass = "",
} = Astro.props;
---

<section
  class={`apple-hero relative w-[calc(100%-2rem)] h-[calc(90vh-2rem)] min-h-175 mx-auto mt-4 flex items-center justify-center overflow-hidden rounded-3xl ${vibeClass}`}
  style="background-color: #0A1C15;"
>
  <div class="apple-bg-pin absolute inset-0 z-0">
    <div class="absolute inset-0 opacity-100 apple-bg-layer z-0">
      <div class="apple-marquee-container flex h-full w-[200vw]">
        <div class="cine-wrapper z-10">
          <img
            src={imageUrl}
            alt="Panoramic 1"
            class="w-full h-full object-cover apple-img-target"
            style="transform-origin: center center;"
          />
        </div>
        <div class="cine-wrapper z-10">
          <img
            src={imageUrl}
            alt="Panoramic 2"
            class="w-full h-full object-cover apple-img-target"
            style="transform-origin: center center;"
          />
        </div>
      </div>
    </div>

    <div class="texture-grain z-10 opacity-30"></div>
    <div class="texture-scratches z-10"></div>
    <div class="atmospheric-dust z-10"></div>

    <div
      class="absolute inset-0 z-10 pointer-events-none"
      style="background-image: linear-gradient(to top, #0A1C15 0%, rgba(10, 28, 21, 0.65) 45%, transparent 100%);"
    >
    </div>
  </div>

  <div
    class="apple-title-box relative z-20 px-6 py-6 md:py-8 max-w-4xl mx-auto flex flex-col items-center text-center -translate-y-4"
  >
    <h1
      class="vibe-target-h1 font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-white tracking-tight leading-[0.95] pb-1 drop-shadow-2xl text-center text-balance mx-auto max-w-[22ch] inline-block"
    >
      {title}
    </h1>
    {subtitle && (
      <p
        class="vibe-target-h2 font-sans text-xs md:text-sm tracking-[0.15em] text-white/90 my-2 text-balance max-w-xl mx-auto drop-shadow-md"
      >
        {subtitle}
      </p>
    )}
    <h3
      class={`vibe-target-folio font-tgp-tech text-white/40 text-[9px] md:text-[10px] tracking-[0.25em] uppercase mt-2 ${vibeClass === "vibe-travel-senses" ? "vibe-vertical" : ""}`}
    >
      TGP Editorial // {vibeClass.replace("vibe-", "").replace(/-/g, " ")}
    </h3>
  </div>
</section>

<style>
  @keyframes cine-drift {
    0% { transform: scale(1.06) translate(0%, 0%); }
    25% { transform: scale(1.09) translate(-0.4%, 0.25%); }
    50% { transform: scale(1.07) translate(-0.7%, -0.15%); }
    75% { transform: scale(1.09) translate(-0.3%, 0.3%); }
    100% { transform: scale(1.06) translate(0%, 0%); }
  }

  .cine-wrapper {
    width: 100vw;
    height: 110%;
    flex-shrink: 0;
    position: relative;
    top: -5%;
    animation: cine-drift 32s ease-in-out infinite;
    will-change: transform;
  }

  .cine-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .apple-hero:hover .cine-wrapper {
    animation-duration: 16s;
  }

  .apple-hero:hover .apple-img-target {
    filter: brightness(0.85) contrast(1.05);
    transition: filter 1.8s ease;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initAppleHero = () => {
    const appleHero = document.querySelector(".apple-hero");
    const appleMarquee = document.querySelector(".apple-hero .apple-marquee-container");
    const appleBgPin = document.querySelector(".apple-hero .apple-bg-pin");
    const titleBox = document.querySelector(".apple-hero .apple-title-box");
    const images = document.querySelectorAll(".apple-hero .apple-img-target");

    if (appleMarquee) {
      gsap.to(appleMarquee, {
        xPercent: -50,
        ease: "none",
        repeat: -1,
        duration: 80,
      });
    }

    if (appleHero && appleBgPin && titleBox) {
      // FIX: Eliminamos el 'pin' que colapsaba la imagen. 
      // Ahora usamos el parallax limpio que tienen los demás.
      gsap.to(appleBgPin, {
        scrollTrigger: {
          trigger: appleHero,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
        y: 120,
        ease: "none",
      });

      // 2. ZOOM-OUT & FADE OUT TO BLACK ON SCROLL
      gsap.to(images, {
        scrollTrigger: {
          trigger: appleHero,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
        scale: 0.78,
        opacity: 0,
        rotation: 0.01,
        ease: "power2.inOut",
      });

      // 3. TITLE BOX PARALLAX & FADE OUT (IN-PLACE SOFT GRADUAL FADE)
      gsap.to(titleBox, {
        scrollTrigger: {
          trigger: appleHero,
          start: "top top",
          end: "70% top",
          scrub: 1.2,
        },
        y: -40,
        opacity: 0,
        scale: 0.94,
        ease: "power2.out",
      });
    }
  };

  document.addEventListener("astro:page-load", initAppleHero);
</script>