---
interface Props {
  title: string;
  subtitle?: string;
  imageUrl?: string;
  vibeClass?: string;
}
const { title, subtitle = 'Apple Editorial', imageUrl = '', vibeClass = '' } = Astro.props;
---
<section class={`apple-hero relative w-full h-[90vh] min-h-[700px] flex items-center justify-center overflow-hidden bg-racing-green ${vibeClass}`}>
  <!-- Pinned Marquee Background Layer -->
  <div class="apple-bg-pin absolute inset-0 z-0">
    <div class="absolute inset-0 opacity-60 apple-bg-layer">
      <div class="apple-marquee-container flex h-full w-[200vw]">
        <div class="cine-wrapper"><img src={imageUrl} alt="Panoramic 1" class="w-full h-full object-cover apple-img-target" style="transform-origin: center center;" /></div>
        <div class="cine-wrapper"><img src={imageUrl} alt="Panoramic 2" class="w-full h-full object-cover apple-img-target" style="transform-origin: center center;" /></div>
      </div>
    </div>
    
    <!-- Cinematic Overlays (from global.css) -->
    <div class="texture-grain"></div>
    <div class="texture-scratches"></div>
    <div class="atmospheric-dust"></div>
    
    <!-- Universal Scrim Overlay -->
    <div class="absolute inset-0 z-10 bg-linear-to-t from-racing-green via-racing-green/50 to-transparent"></div>
    <div class="absolute inset-0 z-10 bg-black/40 mix-blend-multiply"></div>
  </div>

  <!-- Folio / Editorial Header -->
  <div class="absolute top-12 left-12 z-30 pointer-events-none">
    <div class={`vibe-target-folio text-white/40 text-[10px] uppercase ${vibeClass === 'vibe-travel-senses' ? 'vibe-vertical' : ''}`}>
      TGP Editorial // {vibeClass.replace('vibe-', '').replace(/-/g, ' ')}
    </div>
  </div>

  <!-- Glassmorphism Container with Typography -->
  <div class="apple-title-box relative z-20 p-12 rounded-3xl backdrop-blur-md bg-white/5 border border-white/10 shadow-2xl max-w-4xl mx-6 flex flex-col items-center">
    <p class="vibe-target-h2 font-sans text-sm uppercase tracking-[0.2em] text-white/70 mb-8 border-b border-white/20 pb-2">
      {subtitle}
    </p>
    <h1 class="vibe-target-h1 font-serif text-6xl md:text-8xl text-white tracking-tighter leading-none drop-shadow-2xl text-center">
      {title}
    </h1>
  </div>
</section>

<style>
  @keyframes cine-drift {
    0%   { transform: scale(1.06) translate(0%, 0%); }
    25%  { transform: scale(1.09) translate(-0.4%, 0.25%); }
    50%  { transform: scale(1.07) translate(-0.7%, -0.15%); }
    75%  { transform: scale(1.09) translate(-0.3%, 0.3%); }
    100% { transform: scale(1.06) translate(0%, 0%); }
  }

  .cine-wrapper {
    /* Ocupa el ancho completo — flex-item */
    width: 100vw;
    height: 110%;
    flex-shrink: 0;
    position: relative;
    top: -5%;
    animation: cine-drift 32s ease-in-out infinite;
    will-change: transform;
  }

  .cine-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .apple-hero:hover .cine-wrapper {
    animation-duration: 16s;
  }

  .apple-hero:hover .apple-img-target {
    filter: brightness(0.75) contrast(1.05);
    transition: filter 1.8s ease;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initAppleHero = () => {
    const appleHero = document.querySelector('.apple-hero');
    const appleMarquee = document.querySelector('.apple-hero .apple-marquee-container');
    const appleBgPin = document.querySelector('.apple-hero .apple-bg-pin');
    const appleBgLayer = document.querySelector('.apple-hero .apple-bg-layer');
    const titleBox = document.querySelector('.apple-hero .apple-title-box');
    const images = document.querySelectorAll('.apple-hero .apple-img-target');

    if (appleMarquee) {
      gsap.to(appleMarquee, {
        xPercent: -50,
        ease: "none",
        repeat: -1,
        duration: 80 
      });
    }

    if (appleHero && appleBgPin && titleBox) {
      // 1. PIN BACKGROUND
      ScrollTrigger.create({
        trigger: appleHero,
        start: 'top top',
        end: 'bottom top',
        pin: appleBgPin,
        pinSpacing: false 
      });

      // 2. ZOOM-OUT & FADE PHYSICS
      gsap.to(images, {
        scrollTrigger: {
          trigger: appleHero,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
        scale: 0.85,
        opacity: 0.3,
        rotation: 0.01, // Force hardware acceleration
        ease: "power2.inOut"
      });

      // 3. TITLE BOX PARALLAX (With higher inertia)
      gsap.to(titleBox, {
        scrollTrigger: {
          trigger: appleHero,
          start: 'top top',
          end: 'bottom top',
          scrub: 1.5,
        },
        y: -300, 
        opacity: 0,
        scale: 0.9,
        rotationX: 10,
        ease: "power3.out"
      });
    }
  };

  // Lifecycle Protocol
  document.addEventListener('astro:page-load', initAppleHero);
</script>
