---
import TgpImage from './TgpImage.astro';

/**
 * BentoPortal.astro
 * Sistema de Grid Bento en 3 bloques para el portal editorial TGP.
 *
 * BLOQUE A — Full-bleed Protagonista (1 card, 21:9)
 * BLOQUE B — Cluster 2+1+2 (5 cards en grid asimétrico)
 * BLOQUE C — Array 4+Engine+4 (8 cards estándar + 1 EngineCard auto-slider)
 *
 * Recibe un array de `posts` (mínimo 14 recomendado) y los distribuye.
 */

interface Post {
  title: string;
  subtitle?: string;
  image: string;
  link: string;
  collection: string;
  date?: string;
  author?: string;
  id: string;
}

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

// Garantizar que siempre hay posts placeholder si no hay contenido
const safePosts: Post[] = posts.length > 0 ? posts : Array.from({ length: 14 }, (_, i) => ({
  title: `Post ${i + 1}`,
  image: `https://images.unsplash.com/photo-1478720568477-152d9b164e26?q=80&w=800&h=600`,
  link:  '#',
  collection: 'essays',
  id: `placeholder-${i}`,
}));

// Distribución de posts por bloque
const heroPost      = safePosts[0];                  // Bloque A: 1 post
const clusterPosts  = safePosts.slice(1, 6);         // Bloque B: 5 posts (2+1+2)
const enginePosts   = safePosts.slice(1, 7);         // Engine Card: rotación de posts
const array4Before  = safePosts.slice(6, 10);        // Bloque C primero: 4 cards
const array4After   = safePosts.slice(10, 14);       // Bloque C segundo: 4 cards

// Helper: etiqueta de colección formateada
const formatCollection = (col: string) => {
  const c = col.toLowerCase();
  if (c === 'essays') return 'Dossiers';
  if (c === 'architectures') return 'Magazines';
  if (c === 'visual_signals' || c === 'visual-signals') return 'Collections';
  if (c === 'capsulas') return 'eBooks';
  return col.replace('_', ' ').replace('-', ' ')
    .split(' ')
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
};
---

<div id="bento-portal" class="bento-portal-root w-full grid grid-cols-1 md:grid-cols-12 auto-rows-min gap-6 px-3 md:px-0">

  {/* ============================================================
      BLOQUE A — FULL-BLEED PROTAGONISTA
      1 card que ocupa todo el ancho. Ratio 21:9 en desktop.
  ============================================================= */}
  <a 
    href={heroPost.link}
    class="md:col-span-12 group relative block w-full bento-hero-card overflow-hidden bg-black border border-white/5 rounded-3xl"
    aria-label={`Leer: ${heroPost.title}`}
  >
    {/* Imagen full-bleed */}
    <TgpImage
      src={heroPost.image}
      alt={heroPost.title}
      width={1920}
      height={820}
      format="webp"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover brightness-[0.6] group-hover:brightness-[0.75] group-hover:scale-[1.03] transition-all duration-1200 ease-out"
    />

    {/* Scrim de legibilidad */}
    <div class="absolute inset-0 bg-linear-to-r from-charcoal-wood/95 via-charcoal-wood/50 to-transparent"></div>
    <div class="absolute inset-0 bg-linear-to-t from-charcoal-wood/70 via-transparent to-transparent"></div>

    {/* Content */}
    <div class="absolute inset-0 flex flex-col justify-end p-6 max-w-4xl">
      <span class="inline-block mb-4 text-xs tracking-[0.4em] uppercase text-copper-ember/70 font-tgp-tech animate-pulse-slow">
        {formatCollection(heroPost.collection)} · Destacado
      </span>
      <h2 class="font-tgp-gloock text-3xl md:text-5xl lg:text-6xl text-white leading-[0.92] tracking-tight mb-4 group-hover:text-copper-ember transition-colors duration-700">
        {heroPost.title}
      </h2>
      {heroPost.subtitle && (
        <p class="text-white/70 text-base font-tgp-body font-light leading-relaxed max-w-[50ch] hidden md:block">
          {heroPost.subtitle}
        </p>
      )}
      {/* CTA line */}
      <div class="mt-6 flex items-center gap-4">
        <span class="w-0 group-hover:w-16 h-px bg-copper-ember transition-all duration-700"></span>
        <span class="text-[8px] tracking-[0.5em] uppercase text-white/30 group-hover:text-copper-ember font-tgp-tech transition-colors duration-500">
          Leer Pieza
        </span>
      </div>
    </div>

    {/* Corner accent */}
    <div class="absolute top-8 right-8 w-16 h-16 border-t border-r border-white/10 group-hover:border-copper-ember/40 transition-colors duration-700 pointer-events-none"></div>
  </a>


  {/* ============================================================
      BLOQUE B — CLUSTER 2 + 1 (full-bleed) + 2
  ============================================================= */}
  
  {/* Fila superior: 2 cards */}
  {clusterPosts.slice(0, 2).map((post, i) => (
    <a 
      href={post.link} 
      class="md:col-span-6 group relative block overflow-hidden bg-black bento-cluster-card border border-white/5 rounded-3xl h-100 md:h-112.5"
    >
      <TgpImage
        src={post.image}
        alt={post.title}
        width={960}
        height={720}
        format="webp"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover brightness-75 group-hover:brightness-100 group-hover:scale-110 transition-all duration-1000"
      />
      <div class="absolute inset-0 bg-linear-to-t from-charcoal-wood/95 via-charcoal-wood/30 to-transparent"></div>
      <div class="absolute bottom-0 left-0 p-6">
        <span class="block text-xs tracking-[0.3em] uppercase text-copper-ember/70 mb-2 font-tgp-tech">
          {formatCollection(post.collection)} · 0{i + 1}
        </span>
        <h3 class="font-tgp-gloock text-xl md:text-2xl text-white leading-tight group-hover:text-copper-ember transition-colors duration-500">
          {post.title}
        </h3>
        {post.subtitle && (
          <p class="text-white/70 text-base font-tgp-body font-light mt-2 leading-relaxed line-clamp-2">
            {post.subtitle}
          </p>
        )}
        <div class="mt-4 w-0 group-hover:w-10 h-px bg-copper-ember/60 transition-all duration-700"></div>
      </div>
    </a>
  ))}

  {/* Fila central: 1 card full-bleed - Byblos Engine */}
  <div 
    id="bento-byblos-card"
    class="md:col-span-12 bento-cluster-full-mid relative overflow-hidden bg-black border border-white/5 rounded-3xl group/byblos w-full h-112.5"
    aria-label="Byblos Engine: piezas centrales"
  >
    {safePosts.map((post, i) => (
      <div 
        class={`byblos-slide absolute inset-0 transition-opacity duration-1000 ${i === 0 ? 'opacity-100 z-10 is-active' : 'opacity-0 z-0'} overflow-hidden`}
        data-byblos-slide={i}
      >
        <div class="hero-v2-cine-wrapper w-full h-[110%] absolute top-[-5%] left-0">
          <TgpImage
            src={post.image}
            alt={post.title}
            width={1600}
            height={900}
            format="webp"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover brightness-[0.5] contrast-[1.08]"
          />
        </div>
        <div class="absolute inset-0 bg-linear-to-r from-charcoal-wood/90 via-charcoal-wood/40 to-transparent z-10"></div>

        {/* Granular Ken Burns local elements */}
        <div class="card-grain opacity-30 pointer-events-none"></div>
        <div class="card-scratches opacity-30 pointer-events-none"></div>
        <div class="atmospheric-dust z-20"></div>

        <a href={post.link} class="absolute inset-0 flex items-center p-6 group/card z-30">
          <div>
            <span class="text-xs tracking-[0.4em] uppercase text-copper-ember/70 mb-3 font-tgp-tech flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-copper-ember animate-pulse"></span>
              {formatCollection(post.collection)} · Pieza Central
            </span>
            <h3 class="font-tgp-gloock text-3xl md:text-5xl text-white leading-[0.9] group-hover/card:text-copper-ember transition-colors duration-700 max-w-[20ch]">
              {post.title}
            </h3>
          </div>
        </a>
      </div>
    ))}

    {/* Controles laterales en hover */}
    <div class="byblos-nav-zone absolute inset-y-0 left-0 w-16 z-30 flex items-center justify-start pointer-events-none">
      <button id="byblos-prev" class="byblos-nav-btn pl-4 text-white/20 hover:text-white/40 transition-all cursor-pointer opacity-0 group-hover/byblos:opacity-100 pointer-events-auto" aria-label="Anterior">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" d="M15 19l-7-7 7-7" /></svg>
      </button>
    </div>
    <div class="byblos-nav-zone absolute inset-y-0 right-0 w-16 z-30 flex items-center justify-end pointer-events-none">
      <button id="byblos-next" class="byblos-nav-btn pr-4 text-white/20 hover:text-white/40 transition-all cursor-pointer opacity-0 group-hover/byblos:opacity-100 pointer-events-auto" aria-label="Siguiente">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>

    {/* Dots de progreso en Byblos */}
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2">
      {safePosts.map((_, i) => (
        <button 
          class="byblos-dot h-[1.5px] rounded-full bg-white/8 transition-all duration-500 hover:bg-white/20 cursor-pointer"
          style={`width: ${i === 0 ? '1.25rem' : '0.4rem'};`}
          data-byblos-dot={i}
          aria-label={`Slide ${i + 1}`}
        ></button>
      ))}
    </div>
  </div>

  {/* Fila inferior: 2 cards */}
  {clusterPosts.slice(3, 5).map((post, i) => (
    <a 
      href={post.link} 
      class="md:col-span-6 group relative block overflow-hidden bg-black bento-cluster-card border border-white/5 rounded-3xl h-100 md:h-112.5"
    >
      <TgpImage
        src={post.image}
        alt={post.title}
        width={960}
        height={720}
        format="webp"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover brightness-75 group-hover:brightness-100 group-hover:scale-110 transition-all duration-1000"
      />
      <div class="absolute inset-0 bg-linear-to-t from-charcoal-wood/95 via-charcoal-wood/30 to-transparent"></div>
      <div class="absolute bottom-0 left-0 p-6">
        <span class="block text-xs tracking-[0.3em] uppercase text-copper-ember/70 mb-2 font-tgp-tech">
          {formatCollection(post.collection)} · 0{i + 4}
        </span>
        <h3 class="font-tgp-gloock text-xl md:text-2xl text-white leading-tight group-hover:text-copper-ember transition-colors duration-500">
          {post.title}
        </h3>
        {post.subtitle && (
          <p class="text-white/70 text-base font-tgp-body font-light mt-2 leading-relaxed line-clamp-2">
            {post.subtitle}
          </p>
        )}
        <div class="mt-4 w-0 group-hover:w-10 h-px bg-copper-ember/60 transition-all duration-700"></div>
      </div>
    </a>
  ))}

  {/* ============================================================
      BLOQUE C — ARRAY 4 + ENGINE CARD + 4
  ============================================================= */}

  {/* Primeras 4 cards estándar */}
  {array4Before.map((post, i) => (
    <a 
      href={post.link} 
      class="md:col-span-6 lg:col-span-3 group relative block overflow-hidden bg-black bento-standard-card border border-white/5 rounded-3xl aspect-3/4 min-h-80"
    >
      <TgpImage
        src={post.image}
        alt={post.title}
        width={600}
        height={800}
        format="webp"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover brightness-75 group-hover:brightness-100 group-hover:scale-110 transition-all duration-1000"
      />
      <div class="absolute inset-0 bg-linear-to-t from-charcoal-wood/95 via-charcoal-wood/20 to-transparent"></div>
      <div class="absolute bottom-0 left-0 p-6">
        <span class="block text-xs tracking-[0.3em] uppercase text-copper-ember/70 mb-2 font-tgp-tech">
          {formatCollection(post.collection)}
        </span>
        <h3 class="font-tgp-gloock text-lg md:text-xl text-white leading-tight group-hover:text-copper-ember transition-colors duration-500">
          {post.title}
        </h3>
        {post.subtitle && (
          <p class="text-white/70 text-sm font-tgp-body font-light mt-2 leading-normal line-clamp-2">
            {post.subtitle}
          </p>
        )}
      </div>
      {/* Index badge */}
      <div class="absolute top-4 right-4 text-xs font-tgp-tech text-white/40 group-hover:text-copper-ember/60 transition-colors duration-500">
        {String(i + 7).padStart(2, '0')}
      </div>
    </a>
  ))}

  {/* ENGINE CARD — Full-bleed auto-slider de noticias */}
  <div 
    id="bento-engine-card"
    class="md:col-span-12 bento-engine-card relative overflow-hidden bg-racing-green border border-white/5 rounded-3xl group/engine h-[65vh] min-h-112.5"
    aria-label="Engine: últimas piezas"
  >
    {/* Slides del Engine */}
    {enginePosts.map((post, i) => (
      <div 
        class={`engine-slide absolute inset-0 transition-opacity duration-1000 ${i === 0 ? 'opacity-100 z-10 is-active' : 'opacity-0 z-0'}`}
        data-engine-slide={i}
      >
        <TgpImage
          src={post.image}
          alt={post.title}
          width={1600}
          height={900}
          format="webp"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover brightness-[0.45] transition-transform duration-10000 ease-linear scale-100"
        />
        <div class="absolute inset-0 bg-linear-to-r from-[#0A1C15]/95 via-[#0A1C15]/60 to-transparent"></div>
        <a href={post.link} class="absolute inset-0 flex flex-col justify-center p-6 md:px-16 group/card">
          <span class="text-xs tracking-[0.4em] uppercase text-copper-ember/70 mb-4 font-tgp-tech inline-block animate-pulse-slow">
            {formatCollection(post.collection)} · En rotación
          </span>
          <h3 class="font-tgp-gloock text-3xl md:text-5xl text-white leading-[0.92] tracking-tight max-w-[22ch] group-hover/card:text-copper-ember transition-colors duration-700">
            {post.title}
          </h3>
          {post.subtitle && (
            <div class="mt-6 border-l border-white/10 pl-4 hidden md:block">
              <p class="text-white/40 text-sm font-tgp-body font-light leading-relaxed max-w-[55ch]">
                {post.subtitle}
              </p>
            </div>
          )}
          <div class="mt-6 flex items-center gap-4">
            <span class="w-0 group-hover/card:w-8 h-px bg-copper-ember transition-all duration-700"></span>
            <span class="text-[8px] tracking-[0.5em] uppercase text-white/30 group-hover/card:text-copper-ember font-tgp-tech transition-colors duration-500">
              Leer Pieza
            </span>
          </div>
        </a>
      </div>
    ))}

    {/* Controles laterales en hover */}
    <div class="engine-nav-zone absolute inset-y-0 left-0 w-16 z-30 flex items-center justify-start pointer-events-none">
      <button id="engine-prev" class="engine-nav-btn pl-4 text-white/20 hover:text-white/40 transition-all cursor-pointer opacity-0 group-hover/engine:opacity-100 pointer-events-auto" aria-label="Anterior">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" d="M15 19l-7-7 7-7" /></svg>
      </button>
    </div>
    <div class="engine-nav-zone absolute inset-y-0 right-0 w-16 z-30 flex items-center justify-end pointer-events-none">
      <button id="engine-next" class="engine-nav-btn pr-4 text-white/20 hover:text-white/40 transition-all cursor-pointer opacity-0 group-hover/engine:opacity-100 pointer-events-auto" aria-label="Siguiente">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>

    {/* Progress dots (Medio punto editorial centrado) */}
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2">
      {enginePosts.map((_, i) => (
        <button 
          class="engine-dot h-[1.5px] rounded-full bg-white/8 transition-all duration-500 hover:bg-white/20 cursor-pointer"
          style={`width: ${i === 0 ? '1.25rem' : '0.4rem'};`}
          data-engine-dot={i}
          aria-label={`Slide ${i + 1}`}
        ></button>
      ))}
    </div>

    {/* Engine label */}
    <div class="absolute top-6 right-8 z-20 flex items-center gap-3 opacity-30 group-hover/engine:opacity-100 transition-opacity duration-500">
      <span class="text-[7px] tracking-[0.6em] uppercase text-white font-tgp-tech">Engine</span>
    </div>
  </div>

  {/* Últimas 4 cards estándar */}
  {array4After.map((post, i) => (
    <a 
      href={post.link} 
      class="md:col-span-6 lg:col-span-3 group relative block overflow-hidden bg-black bento-standard-card border border-white/5 rounded-3xl aspect-3/4 min-h-80"
    >
      <TgpImage
        src={post.image}
        alt={post.title}
        width={600}
        height={800}
        format="webp"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover brightness-75 group-hover:brightness-100 group-hover:scale-110 transition-all duration-1000"
      />
      <div class="absolute inset-0 bg-linear-to-t from-charcoal-wood/95 via-charcoal-wood/20 to-transparent"></div>
      <div class="absolute bottom-0 left-0 p-6">
        <span class="block text-xs tracking-[0.3em] uppercase text-copper-ember/70 mb-2 font-tgp-tech">
          {formatCollection(post.collection)}
        </span>
        <h3 class="font-tgp-gloock text-lg md:text-xl text-white leading-tight group-hover:text-copper-ember transition-colors duration-500">
          {post.title}
        </h3>
        {post.subtitle && (
          <p class="text-white/70 text-sm font-tgp-body font-light mt-2 leading-normal line-clamp-2">
            {post.subtitle}
          </p>
        )}
      </div>
      <div class="absolute top-4 right-4 text-xs font-tgp-tech text-white/40 group-hover:text-copper-ember/60 transition-colors duration-500">
        {String(i + 11).padStart(2, '0')}
      </div>
    </a>
  ))}

</div>

{/* ================================================================
    ENGINE CARD: Auto-slider con intervalo de 4 segundos
================================================================= */}
<script>
  const initEngineCard = () => {
    const slides     = document.querySelectorAll<HTMLElement>('[data-engine-slide]');
    const dots       = document.querySelectorAll<HTMLButtonElement>('[data-engine-dot]');
    const prevBtn    = document.getElementById('engine-prev');
    const nextBtn    = document.getElementById('engine-next');
    const engineCard = document.getElementById('bento-engine-card');
    const INTERVAL   = 4500; // ms entre slides
    let current      = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    if (slides.length === 0) return;

    const goToSlide = (index: number) => {
      slides.forEach((s, i) => {
        s.classList.toggle('opacity-100', i === index);
        s.classList.toggle('opacity-0',   i !== index);
        s.classList.toggle('is-active',   i === index);
        s.style.zIndex = i === index ? '10' : '0';
      });
      dots.forEach((d, i) => {
        d.style.backgroundColor = i === index ? 'rgba(255, 255, 255, 0.25)' : 'rgba(255, 255, 255, 0.08)';
        d.style.width           = i === index ? '1.25rem' : '0.4rem';
      });
    };

    const next = () => {
      current = (current + 1) % slides.length;
      goToSlide(current);
    };

    const prev = () => {
      current = (current - 1 + slides.length) % slides.length;
      goToSlide(current);
    };

    // Dots: navegación manual
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        if (timer) clearInterval(timer);
        current = i;
        goToSlide(current);
        timer = setInterval(next, INTERVAL);
      });
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (timer) clearInterval(timer);
      next();
      timer = setInterval(next, INTERVAL);
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (timer) clearInterval(timer);
      prev();
      timer = setInterval(next, INTERVAL);
    });

    // Pausar en hover
    engineCard?.addEventListener('mouseenter', () => {
      if (timer) clearInterval(timer);
    });
    engineCard?.addEventListener('mouseleave', () => {
      timer = setInterval(next, INTERVAL);
    });

    // Scroll / Wheel
    let wheelDebounce = 0;
    engineCard?.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) > 25 || (e.shiftKey && Math.abs(e.deltaY) > 25)) {
        const now = Date.now();
        if (now - wheelDebounce > 400) {
          wheelDebounce = now;
          if (e.deltaX > 0 || e.deltaY > 0) next();
          else prev();
        }
      }
    }, { passive: true });

    // Drag / Swipe
    let startX = 0;
    let isDragging = false;
    engineCard?.addEventListener('mousedown', (e) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      startX = e.clientX;
      isDragging = true;
    });
    engineCard?.addEventListener('mouseup', (e) => {
      if (!isDragging) return;
      isDragging = false;
      const diffX = e.clientX - startX;
      if (Math.abs(diffX) > 50) {
        if (diffX < 0) next();
        else prev();
      }
    });

    // Iniciar
    goToSlide(0);
    timer = setInterval(next, INTERVAL);
  };

  const initByblosCard = () => {
    const slides     = document.querySelectorAll<HTMLElement>('[data-byblos-slide]');
    const dots       = document.querySelectorAll<HTMLButtonElement>('[data-byblos-dot]');
    const prevBtn    = document.getElementById('byblos-prev');
    const nextBtn    = document.getElementById('byblos-next');
    const byblosCard = document.getElementById('bento-byblos-card');
    const INTERVAL   = 5000; // ms entre slides
    let current      = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    if (slides.length === 0) return;

    const goToSlide = (index: number) => {
      slides.forEach((s, i) => {
        s.classList.toggle('opacity-100', i === index);
        s.classList.toggle('opacity-0',   i !== index);
        s.classList.toggle('is-active',   i === index);
        s.style.zIndex = i === index ? '10' : '0';
      });
      dots.forEach((d, i) => {
        d.style.backgroundColor = i === index ? 'rgba(255, 255, 255, 0.25)' : 'rgba(255, 255, 255, 0.08)';
        d.style.width           = i === index ? '1.25rem' : '0.4rem';
      });
    };

    const next = () => {
      current = (current + 1) % slides.length;
      goToSlide(current);
    };

    const prev = () => {
      current = (current - 1 + slides.length) % slides.length;
      goToSlide(current);
    };

    // Dots: navegación manual
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        if (timer) clearInterval(timer);
        current = i;
        goToSlide(current);
        timer = setInterval(next, INTERVAL);
      });
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (timer) clearInterval(timer);
      next();
      timer = setInterval(next, INTERVAL);
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (timer) clearInterval(timer);
      prev();
      timer = setInterval(next, INTERVAL);
    });

    // Pausar en hover
    byblosCard?.addEventListener('mouseenter', () => {
      if (timer) clearInterval(timer);
    });
    byblosCard?.addEventListener('mouseleave', () => {
      timer = setInterval(next, INTERVAL);
    });

    // Scroll / Wheel
    let wheelDebounce = 0;
    byblosCard?.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) > 25 || (e.shiftKey && Math.abs(e.deltaY) > 25)) {
        const now = Date.now();
        if (now - wheelDebounce > 400) {
          wheelDebounce = now;
          if (e.deltaX > 0 || e.deltaY > 0) next();
          else prev();
        }
      }
    }, { passive: true });

    // Drag / Swipe
    let startX = 0;
    let isDragging = false;
    byblosCard?.addEventListener('mousedown', (e) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      startX = e.clientX;
      isDragging = true;
    });
    byblosCard?.addEventListener('mouseup', (e) => {
      if (!isDragging) return;
      isDragging = false;
      const diffX = e.clientX - startX;
      if (Math.abs(diffX) > 50) {
        if (diffX < 0) next();
        else prev();
      }
    });

    // Iniciar
    goToSlide(0);
    timer = setInterval(next, INTERVAL);
  };

  document.addEventListener('astro:page-load', () => {
    initEngineCard();
    initByblosCard();
  });
</script>

<style>
  /* Engine slide transition */
  .engine-slide {
    transition: opacity 1s ease-in-out;
  }
  .engine-slide.is-active img {
    transform: scale(1.05);
  }
  .engine-dot {
    transition: all 0.4s ease;
  }
  .byblos-slide {
    transition: opacity 1s ease-in-out;
  }
  .byblos-slide.is-active img {
    transform: scale(1.05);
  }
  .byblos-dot {
    transition: all 0.4s ease;
    cursor: pointer;
  }
</style>
