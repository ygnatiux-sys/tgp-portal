---

/**
 * SidebarPortal.astro
 * Columna lateral de cards verticales para el portal editorial.
 * - Desktop: columna fija de 320px a la derecha del Bento
 * - Mobile: sección horizontal con scroll snap
 *
 * Cards mínimas: imagen + badge de colección + título + folio (autor/fecha)
 */

interface Post {
  title: string;
  subtitle?: string;
  image: string;
  link: string;
  collection: string;
  date?: string;
  author?: string;
  id: string;
}

interface Props {
  posts: Post[];
  title?: string;
}

const { posts, title = "También en TGP" } = Astro.props;

const sidebarPosts = posts.slice(0, 8); // máximo 8 en sidebar

const formatCollection = (col: string) => {
  const c = col.toLowerCase();
  if (c === 'essays') return 'Dossiers';
  if (c === 'architectures') return 'Magazines';
  if (c === 'visual_signals' || c === 'visual-signals') return 'Collections';
  if (c === 'capsulas') return 'eBooks';
  return col.replace('_', ' ').replace('-', ' ')
    .split(' ')
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
};
---

<aside class="sidebar-portal" aria-label="Lecturas recomendadas">

  {/* Header de sección */}
  <div class="sidebar-header px-0 mb-6 pb-4 border-b border-white/8">
    <span class="font-tgp-tech text-[8px] tracking-[0.6em] uppercase text-copper-ember">
      ——— {title}
    </span>
  </div>

  {/* Lista de cards verticales */}
  <nav class="sidebar-cards-container" aria-label="Artículos relacionados">
    {sidebarPosts.map((post, i) => (
      <a
        href={post.link}
        class="sidebar-card group flex flex-col py-6 border border-white/5 rounded-3xl hover:border-white/15 p-4 mb-4 transition-all duration-500"
        aria-label={`Leer: ${post.title}`}
      >
        {/* Thumbnail: slightly rectangular 16/10 */}
        <div class="sidebar-thumbnail w-full aspect-16/10 overflow-hidden rounded-2xl bg-charcoal-wood relative mb-4">
          <img
            src={post.image}
            alt={post.title}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover grayscale brightness-60 group-hover:grayscale-0 group-hover:brightness-90 transition-all duration-700"
          />
        </div>

        {/* Metadata + Título (20%) */}
        <div class="flex flex-col min-w-0">
          {/* Badge de colección (Único metadata) */}
          <span class="font-tgp-tech text-xs tracking-[0.3em] uppercase text-copper-ember/70 mb-2">
            {formatCollection(post.collection)}
          </span>

          {/* Título */}
          <h3 class="font-tgp-gloock text-xl text-white leading-snug group-hover:text-copper-ember transition-colors duration-500 line-clamp-2">
            {post.title}
          </h3>

          {/* Excerpt Sobrio con border-text */}
          {post.subtitle && (
            <div class="mt-4 border-l border-white/10 pl-3">
              <p class="font-tgp-body text-xs text-white/40 font-light leading-relaxed line-clamp-2">
                {post.subtitle}
              </p>
            </div>
          )}
        </div>
      </a>
    ))}
  </nav>

  {/* Footer: link al archivo completo */}
  <div class="sidebar-footer mt-6 pt-4">
    <a 
      href="/ensayos"
      class="group flex items-center gap-3 text-[8px] tracking-[0.5em] uppercase font-tgp-tech text-white/20 hover:text-copper-ember transition-colors duration-300"
    >
      Ver el archivo completo
      <span class="w-4 h-px bg-current group-hover:w-8 transition-all duration-500"></span>
    </a>
  </div>

</aside>

<style>
  /* Desktop: columna estática */
  .sidebar-portal {
    padding: 0;
  }

  /* Las cards tienen transiciones suaves al hover */
  .sidebar-card {
    position: relative;
    text-decoration: none;
  }

  /* Mobile: scroll horizontal con snap */
  @media (max-width: 1024px) {
    .sidebar-cards-container {
      display: flex;
      gap: 1.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 1rem;
      scrollbar-width: none; /* Firefox */
    }
    .sidebar-cards-container::-webkit-scrollbar {
      display: none; /* Chrome/Safari */
    }
    .sidebar-card {
      flex-shrink: 0;
      width: 240px;
      scroll-snap-align: start;
      border-bottom: none;
      border-right: 1px solid rgba(255, 255, 255, 0.05);
      padding-right: 1.5rem;
    }
  }
</style>
