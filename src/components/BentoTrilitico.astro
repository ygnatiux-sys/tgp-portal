---
import TgpImage from './TgpImage.astro';

/**
 * BentoTrilitico.astro
 * Una grilla tipo Bento de 3 a 5 celdas con tamaños desiguales, 
 * inspirada en estructuras megalíticas.
 */
interface Post {
  title: string;
  image: string;
  link: string;
  category?: string;
  id: string;
}

interface Props {
  posts: Post[];
  vibeClass?: string;
}

const { posts, vibeClass = "" } = Astro.props;

// Is it a "Tactile" vibe?
const isTactile = vibeClass.includes('victorian') || vibeClass.includes('ethnics') || vibeClass.includes('80s');

// Select first 5 posts if more are provided
const bentoPosts = posts.slice(0, 5);
---

<section class={`bento-trilitico relative w-[calc(100%-2rem)] mx-auto my-12 ${vibeClass}`}>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 auto-rows-70">
    
    {bentoPosts.map((post, index) => {
      // Megalithic Layout Rules
      let gridClasses = "md:col-span-1 md:row-span-1";
      let heightClass = "h-[400px]"; // Mobile height default
      
      if (index === 0) {
        gridClasses = "md:col-span-2 md:row-span-2";
        heightClass = "h-[500px]"; // Significant height for mobile anchor
      } else if (index === 1) {
        gridClasses = "md:col-span-1 md:row-span-2";
        heightClass = "h-[600px]"; // Tall pillar for mobile asymmetry
      } else if (index === 2) {
        gridClasses = "md:col-span-1 md:row-span-1";
        heightClass = "h-[300px]";
      } else {
        gridClasses = "md:col-span-1 md:row-span-1";
        heightClass = "h-[350px]";
      }

      return (
        <a 
          href={post.link} 
          class={`group relative block overflow-hidden rounded-sm bg-black border border-white/5 transition-all duration-1000 ease-[cubic-bezier(0.23,1,0.32,1)] ${gridClasses} ${heightClass} md:h-full ${isTactile ? 'tactile-elevation' : ''}`}
        >
          {/* Background Image with LUT Fade */}
          <div class="absolute inset-0 z-0 overflow-hidden">
            <TgpImage 
              src={post.image} 
              alt={post.title}
              width={1000}
              height={800}
              format="webp"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover grayscale brightness-50 group-hover:grayscale-0 group-hover:brightness-100 group-hover:scale-110 transition-all duration-1000"
            />
            {/* Cinematic Overlays */}
            <div class="texture-grain opacity-30 group-hover:opacity-10 transition-opacity duration-1000"></div>
            <div class="atmospheric-dust opacity-20 group-hover:opacity-40 transition-opacity duration-1000"></div>
            
            <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/20 to-transparent z-10"></div>
          </div>

          {/* Content Overlays */}
          <div class="absolute inset-0 z-20 p-8 flex flex-col justify-end">
            <div class="mb-4 translate-y-4 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-700">
              <span class="text-[8px] tracking-[0.4em] uppercase text-copper-ember font-bold">
                {post.category || 'Archive'} • 0{index + 1}
              </span>
            </div>
            
            <h3 class={`font-gloock text-white leading-none tracking-tight transition-all duration-700 group-hover:text-copper-ember ${index === 0 ? 'text-4xl md:text-6xl' : 'text-2xl md:text-3xl'}`}>
              {post.title}
            </h3>
            
            <div class="mt-6 w-0 group-hover:w-full h-px bg-copper-ember/30 transition-all duration-1000"></div>
          </div>
          
          {/* Physical Frame (Tactile) */}
          {isTactile && (
            <div class="absolute inset-4 border border-white/5 pointer-events-none opacity-20 group-hover:opacity-40 transition-opacity"></div>
          )}
        </a>
      );
    })}
  </div>
</section>

<style>
  .tactile-elevation:hover {
    transform: translateY(-8px) scale(1.01);
    box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.8), 0 0 20px rgba(184, 115, 51, 0.1);
    z-index: 50;
    border-color: rgba(184, 115, 51, 0.3);
  }

  /* Ensure smooth stacking order */
  .bento-trilitico {
    isolation: isolate;
  }
</style>
