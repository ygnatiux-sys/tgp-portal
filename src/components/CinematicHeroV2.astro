---
/**
 * CinematicHeroV2.astro
 * Hero de nueva generación con scroll-scrub GSAP.
 * El hero COMPLETO (contenedor) se encoge + desvanece al scrollear,
 * revelando fluidamente el content-grid debajo.
 *
 * Diferencias vs CinematographicHero.astro:
 * - El scrub afecta al contenedor completo (scale + opacity + y), no solo la imagen
 * - Añade un indicador de scroll animado
 * - Datos: recibe `post` como objeto tipado desde portal.astro
 */

interface Post {
  title: string;
  subtitle?: string;
  image: string;
  link: string;
  collection: string;
  date?: string;
  author?: string;
}

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

// Formatear colección para el badge
const formatCollection = (col: string) =>
  col.replace('_', ' ').replace('visual signals', 'Visual Signals').toUpperCase();
---

{/* ===== HERO CINEMATICO V2 ===== */}
<section 
  id="hero-v2" 
  class="relative h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] mx-auto mt-4 overflow-hidden flex items-end rounded-3xl bg-black"
  style="transform-origin: top center;"
>
  {/* ---- BACKGROUND ENGINE ---- */}
  <div id="hero-v2-slides-container" class="absolute inset-0 z-0 w-full h-full">
    {posts.map((post, i) => (
      <div 
        class={`hero-v2-slide absolute inset-0 transition-opacity duration-1000 ${i === 0 ? 'opacity-100 z-10 is-active' : 'opacity-0 z-0'}`}
        data-hero-slide={i}
      >
        <div class="hero-v2-cine-wrapper w-full h-[110%] absolute top-[-5%] left-0">
          <img
            src={post.image}
            alt={post.title}
            class="w-full h-full object-cover brightness-[0.55] contrast-[1.08]"
          />
        </div>

        {/* Scrims */}
        <div class="absolute inset-0 bg-linear-to-t from-[#050c08] via-black/50 to-transparent z-10"></div>
        <div class="absolute inset-0 bg-linear-to-r from-black/60 via-transparent to-transparent z-10"></div>
        
        {/* Granular Ken Burns local elements */}
        <div class="card-grain opacity-30 pointer-events-none"></div>
        <div class="card-scratches opacity-30 pointer-events-none"></div>
        <div class="atmospheric-dust z-20"></div>

        {/* Content Layer */}
        <div class="absolute inset-0 z-30 flex flex-col justify-end max-w-[1600px] mx-auto px-8 md:px-16 pb-20 md:pb-28 w-full h-full">
          <div class="hero-v2-badge flex items-center gap-4 mb-8">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 border border-copper-ember/40 text-copper-ember text-[8px] tracking-[0.6em] uppercase rounded-full bg-black/50 backdrop-blur-md font-tgp-tech">
              <span class="w-1.5 h-1.5 rounded-full bg-copper-ember animate-pulse"></span>
              {formatCollection(post.collection)}
            </span>
            <span class="text-white/20 text-[8px] tracking-[0.5em] uppercase font-tgp-tech hidden md:block">
              ——— Vol. 2026 ———
            </span>
          </div>

          <h1 
            class="font-tgp-gloock text-3xl md:text-5xl lg:text-6xl font-normal leading-[1.05] tracking-[-0.02em] text-old-silver hover:text-copper-ember transition-colors duration-500 cursor-pointer"
            style="max-width: 25ch;"
          >
            {post.title}
          </h1>

          {post.subtitle && (
            <p class="mt-6 text-copper-ember/60 text-sm md:text-base font-tgp-body font-light leading-relaxed max-w-[55ch] tracking-wide">
              {post.subtitle}
            </p>
          )}

          <div class="hero-v2-folio mt-10 flex items-center gap-8">
            {post.author && (
              <span class="text-[9px] tracking-[0.35em] uppercase text-copper-ember/40 font-tgp-tech">
                {post.author}
              </span>
            )}
            {post.date && (
              <span class="text-[9px] tracking-[0.35em] uppercase text-copper-ember/30 font-tgp-tech">
                {new Date(post.date).toLocaleDateString('es-AR', { year: 'numeric', month: 'long' })}
              </span>
            )}
            <a 
              href={post.link}
              class="ml-auto inline-flex items-center gap-5 px-10 py-4 bg-white/5 backdrop-blur-md border border-white/10 text-alpaca-silver text-[9px] tracking-[0.45em] uppercase font-bold font-tgp-tech rounded-sm hover:bg-charcoal-wood/5 hover:text-old-silver hover:border-charcoal-wood/10 transition-all duration-700 hover:scale-105 shadow-2xl shadow-black/60"
            >
              Leer Pieza
              <span class="w-6 h-px bg-current inline-block transition-all duration-700"></span>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>

  {/* Dots de progreso */}
  <div class="absolute bottom-10 left-8 md:left-16 z-40 flex gap-3">
    {posts.map((_, i) => (
      <button 
        class="hero-dot h-1 rounded-full bg-white/20 transition-all duration-500 hover:bg-copper-ember"
        style={`width: ${i === 0 ? '2rem' : '0.5rem'};`}
        data-hero-dot={i}
        aria-label={`Slide ${i + 1}`}
      ></button>
    ))}
  </div>

  {/* ---- SCROLL INDICATOR ---- */}
  <div 
    id="hero-v2-scroll-cue" 
    class="absolute bottom-10 right-8 md:right-16 z-40 flex flex-col items-center gap-3"
  >
    <span class="text-[7px] tracking-[0.6em] uppercase text-white/30 font-tgp-tech">Scroll</span>
    <div class="w-px h-12 bg-linear-to-b from-white/30 to-transparent hero-v2-scroll-line"></div>
  </div>
</section>

{/* ================================================================
    GSAP: Scroll-scrub del hero completo
================================================================= */}
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initHeroV2 = () => {
    const hero        = document.getElementById('hero-v2');
    const slides      = document.querySelectorAll<HTMLElement>('[data-hero-slide]');
    const dots        = document.querySelectorAll<HTMLButtonElement>('[data-hero-dot]');
    const scrollCue   = document.getElementById('hero-v2-scroll-cue');
    const INTERVAL    = 5000;
    let current       = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    if (!hero || slides.length === 0) return;

    // ── 1. SLIDER MACHINE ─────────
    const goToSlide = (index: number) => {
      slides.forEach((s, i) => {
        s.classList.toggle('opacity-100', i === index);
        s.classList.toggle('opacity-0',   i !== index);
        s.classList.toggle('is-active',   i === index);
        s.style.zIndex = i === index ? '10' : '0';

        // Animar entrada del contenido
        if (i === index) {
          const b = s.querySelector('.hero-v2-badge');
          const t = s.querySelector('h1');
          const sub = s.querySelector('p');
          const f = s.querySelector('.hero-v2-folio');
          gsap.fromTo([b, t, sub, f], 
            { y: 30, opacity: 0 },
            { y: 0, opacity: 1, duration: 0.8, ease: 'expo.out', stagger: 0.08 }
          );
        }
      });

      dots.forEach((d, i) => {
        d.style.backgroundColor = i === index ? '#E3DDD3' : '';
        d.style.width           = i === index ? '2rem' : '0.5rem';
      });
    };

    const next = () => {
      current = (current + 1) % slides.length;
      goToSlide(current);
    };

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        if (timer) clearInterval(timer);
        current = i;
        goToSlide(current);
        timer = setInterval(next, INTERVAL);
      });
    });

    // Auto-advance
    goToSlide(0);
    timer = setInterval(next, INTERVAL);

    // ── 2. SCROLL SCRUB ─────────
    gsap.to(hero, {
      scrollTrigger: {
        trigger: hero,
        start:  'top top',
        end:    'bottom top',
        scrub:  1.5,
        pin:    false,
      },
      opacity: 0,
      scale:   0.96,
      y:       '-3%',
      ease:    'none',
    });

    if (scrollCue) {
      ScrollTrigger.create({
        trigger: hero,
        start:   'top+=100 top',
        onEnter: () => gsap.to(scrollCue, { opacity: 0, y: -20, duration: 0.5 }),
      });
    }
  };

  document.addEventListener('astro:page-load', initHeroV2);
</script>

<style>
  /* Ken Burns: drift cinematográfico independiente del scroll */
  @keyframes hero-v2-drift {
    0%   { transform: scale(1.0)  translate(0%, 0%); }
    33%  { transform: scale(1.04) translate(-0.3%, 0.2%); }
    66%  { transform: scale(1.06) translate(-0.5%, -0.1%); }
    100% { transform: scale(1.0)  translate(0%, 0%); }
  }

  .hero-v2-cine-wrapper {
    animation: hero-v2-drift 40s ease-in-out infinite;
    will-change: transform;
  }

  /* Scroll line animation (breathing) */
  @keyframes scroll-breathe {
    0%, 100% { transform: scaleY(1); opacity: 0.3; }
    50%       { transform: scaleY(0.5); opacity: 0.6; }
  }

  .hero-v2-scroll-line {
    animation: scroll-breathe 2.5s ease-in-out infinite;
    transform-origin: top center;
  }
</style>
