---
/**
 * CinematicHeroV2.astro
 * Hero de nueva generación con scroll-scrub GSAP.
 * El hero COMPLETO (contenedor) se encoge + desvanece al scrollear,
 * revelando fluidamente el content-grid debajo.
 *
 * Diferencias vs CinematographicHero.astro:
 * - El scrub afecta al contenedor completo (scale + opacity + y), no solo la imagen
 * - Añade un indicador de scroll animado
 * - Datos: recibe `post` como objeto tipado desde portal.astro
 */

interface Post {
  title: string;
  subtitle?: string;
  image: string;
  link: string;
  collection: string;
  date?: string;
  author?: string;
}

interface Props {
  post: Post;
}

const { post } = Astro.props;

const {
  title    = "TGP ARCHIVE",
  subtitle,
  image    = "https://images.unsplash.com/photo-1478720568477-152d9b164e26?q=80&w=2670",
  link     = "#",
  collection = "featured",
  date,
  author,
} = post;

// Formatear colección para el badge
const collectionLabel = collection
  .replace('_', ' ')
  .replace('visual signals', 'Visual Signals')
  .toUpperCase();
---

{/* ===== HERO CINEMATICO V2 ===== */}
{/* El id="hero-v2" es el target del GSAP scrub */}
<section 
  id="hero-v2" 
  class="relative h-dvh w-full overflow-hidden flex items-end"
  style="transform-origin: top center;"
>

  {/* ---- BACKGROUND ENGINE ---- */}
  <div class="absolute inset-0 z-0">
    {/* Cine Wrapper: Ken Burns drift animado */}
    <div class="hero-v2-cine-wrapper w-full h-[110%] absolute top-[-5%] left-0">
      <img
        id="hero-v2-img"
        src={image}
        alt={title}
        class="w-full h-full object-cover brightness-[0.55] contrast-[1.08]"
      />
    </div>

    {/* Scrim: gradiente bottom-to-top (para legibilidad del texto) */}
    <div class="absolute inset-0 bg-linear-to-t from-[#050c08] via-black/50 to-transparent z-10"></div>

    {/* Scrim lateral derecho: crea profundidad asimétrica */}
    <div class="absolute inset-0 bg-linear-to-r from-black/60 via-transparent to-transparent z-10"></div>

    {/* Grain overlay — sutil, editorial */}
    <div class="texture-grain opacity-30 absolute inset-0 z-20 pointer-events-none"></div>
  </div>

  {/* ---- CONTENT LAYER ---- */}
  <div id="hero-v2-content" class="relative z-30 w-full max-w-[1600px] mx-auto px-8 md:px-16 pb-20 md:pb-28">

    {/* Badge de colección + número de edición */}
    <div class="hero-v2-badge flex items-center gap-4 mb-8 opacity-0">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 border border-copper-ember/40 text-copper-ember text-[8px] tracking-[0.6em] uppercase rounded-full bg-black/50 backdrop-blur-md font-tgp-tech">
        <span class="w-1.5 h-1.5 rounded-full bg-copper-ember animate-pulse"></span>
        {collectionLabel}
      </span>
      <span class="text-white/20 text-[8px] tracking-[0.5em] uppercase font-tgp-tech hidden md:block">
        ——— Vol. 2026 ———
      </span>
    </div>

    {/* Título principal: display XL */}
    <h1 
      id="hero-v2-title"
      class="hero-v2-title font-tgp-gloock text-[13vw] md:text-[9.5vw] lg:text-[8vw] font-normal leading-[0.88] tracking-[-0.03em] text-white opacity-0"
      style="max-width: 16ch;"
    >
      {title}
    </h1>

    {/* Subtítulo / Deck */}
    {subtitle && (
      <p class="hero-v2-subtitle mt-6 text-white/50 text-sm md:text-base font-tgp-body font-light leading-relaxed max-w-[55ch] tracking-wide opacity-0">
        {subtitle}
      </p>
    )}

    {/* Folio: metadata (autor, fecha, colección) */}
    <div class="hero-v2-folio mt-10 flex items-center gap-8 opacity-0">
      {author && (
        <span class="text-[9px] tracking-[0.35em] uppercase text-white/35 font-tgp-tech">
          {author}
        </span>
      )}
      {date && (
        <span class="text-[9px] tracking-[0.35em] uppercase text-white/25 font-tgp-tech">
          {new Date(date).toLocaleDateString('es-AR', { year: 'numeric', month: 'long' })}
        </span>
      )}
      {/* CTA: leer el post */}
      <a 
        href={link}
        class="ml-auto inline-flex items-center gap-5 px-10 py-4 bg-white text-black text-[9px] tracking-[0.45em] uppercase font-bold font-tgp-tech rounded-sm hover:bg-copper-ember hover:text-white transition-all duration-700 hover:scale-105 shadow-2xl shadow-black/60"
      >
        Leer Pieza
        <span class="w-6 h-px bg-current inline-block transition-all duration-700 group-hover:w-12"></span>
      </a>
    </div>
  </div>

  {/* ---- SCROLL INDICATOR ---- */}
  <div 
    id="hero-v2-scroll-cue" 
    class="absolute bottom-10 left-1/2 -translate-x-1/2 z-40 flex flex-col items-center gap-3 opacity-0"
  >
    <span class="text-[7px] tracking-[0.6em] uppercase text-white/30 font-tgp-tech">Scroll</span>
    <div class="w-px h-12 bg-linear-to-b from-white/30 to-transparent hero-v2-scroll-line"></div>
  </div>

</section>

{/* ================================================================
    GSAP: Scroll-scrub del hero completo
    El hero se encoge (scale) y desvanece (opacity) al scrollear,
    revelando el content-grid por debajo.
================================================================= */}
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initHeroV2 = () => {
    const hero        = document.getElementById('hero-v2');
    const title       = document.getElementById('hero-v2-title');
    const content     = document.getElementById('hero-v2-content');
    const scrollCue   = document.getElementById('hero-v2-scroll-cue');
    const badge       = document.querySelector('.hero-v2-badge') as HTMLElement | null;
    const subtitle    = document.querySelector('.hero-v2-subtitle') as HTMLElement | null;
    const folio       = document.querySelector('.hero-v2-folio') as HTMLElement | null;
    const img         = document.getElementById('hero-v2-img');

    if (!hero) return;

    // ── 1. ENTRANCE ANIMATIONS (solo al cargar la página) ─────────
    const tl = gsap.timeline({ delay: 0.3 });

    tl.to(badge,    { opacity: 1, y: 0, duration: 1,    ease: 'expo.out' }, 0.0)
      .to(title,    { opacity: 1, y: 0, duration: 1.4,  ease: 'expo.out' }, 0.2)
      .to(subtitle, { opacity: 1, y: 0, duration: 1.2,  ease: 'expo.out' }, 0.5)
      .to(folio,    { opacity: 1, y: 0, duration: 1,    ease: 'expo.out' }, 0.7)
      .to(scrollCue,{ opacity: 1, duration: 1,           ease: 'power2.inOut' }, 1.0);

    // Configurar estado inicial para las animaciones de entrada
    gsap.set([badge, title, subtitle, folio], { opacity: 0, y: 40 });
    gsap.set(scrollCue, { opacity: 0 });

    // ── 2. KEN BURNS en imagen (independiente del scroll scrub) ────
    if (img) {
      gsap.to(img, {
        scale: 1.06,
        duration: 30,
        ease: 'none',
        repeat: -1,
        yoyo: true,
      });
    }

    // ── 3. SCROLL SCRUB: El hero completo desaparece al scrollear ──
    // El contenedor entero escala ligeramente hacia adentro y se desvanece.
    // El contenido de abajo (#content-grid) queda "revelado" por debajo.
    gsap.to(hero, {
      scrollTrigger: {
        trigger: hero,
        start:  'top top',
        end:    'bottom top',
        scrub:  1.5,              // 1.5 = suavizado ligero (no 100% rígido)
        pin:    false,
      },
      opacity: 0,
      scale:   0.96,
      y:       '-3%',
      ease:    'none',
    });

    // El texto del hero sale a un ritmo diferente al contenedor (profundidad)
    if (content) {
      gsap.to(content, {
        scrollTrigger: {
          trigger: hero,
          start:  'top top',
          end:    'center top',
          scrub:  0.8,
        },
        y:       -80,
        opacity: 0,
        ease:    'none',
      });
    }

    // Scroll cue se oculta rápido
    if (scrollCue) {
      ScrollTrigger.create({
        trigger: hero,
        start:   'top+=100 top',
        onEnter: () => gsap.to(scrollCue, { opacity: 0, y: -20, duration: 0.5 }),
      });
    }
  };

  // Lifecycle: Compatible con Astro ClientRouter
  document.addEventListener('astro:page-load', initHeroV2);
</script>

<style>
  /* Ken Burns: drift cinematográfico independiente del scroll */
  @keyframes hero-v2-drift {
    0%   { transform: scale(1.0)  translate(0%, 0%); }
    33%  { transform: scale(1.04) translate(-0.3%, 0.2%); }
    66%  { transform: scale(1.06) translate(-0.5%, -0.1%); }
    100% { transform: scale(1.0)  translate(0%, 0%); }
  }

  .hero-v2-cine-wrapper {
    animation: hero-v2-drift 40s ease-in-out infinite;
    will-change: transform;
  }

  /* Scroll line animation (breathing) */
  @keyframes scroll-breathe {
    0%, 100% { transform: scaleY(1); opacity: 0.3; }
    50%       { transform: scaleY(0.5); opacity: 0.6; }
  }

  .hero-v2-scroll-line {
    animation: scroll-breathe 2.5s ease-in-out infinite;
    transform-origin: top center;
  }
</style>
