---
/**
 * CinematicHeroV2.astro
 * Hero de nueva generación con scroll-scrub GSAP.
 * El hero COMPLETO (contenedor) se encoge + desvanece al scrollear,
 * revelando fluidamente el content-grid debajo.
 *
 * Diferencias vs CinematographicHero.astro:
 * - El scrub afecta al contenedor completo (scale + opacity + y), no solo la imagen
 * - Añade un indicador de scroll animado
 * - Datos: recibe `post` como objeto tipado desde portal.astro
 */

interface Post {
  title: string;
  subtitle?: string;
  image: string;
  link: string;
  collection: string;
  date?: string;
  author?: string;
}

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

// Formatear colección para el badge
const formatCollection = (col: string) => {
  const c = col.toLowerCase();
  if (c === 'essays') return 'DOSSIERS';
  if (c === 'architectures') return 'MAGAZINES';
  if (c === 'visual_signals' || c === 'visual-signals') return 'COLLECTIONS';
  if (c === 'capsulas') return 'EBOOKS';
  return col.replace('_', ' ').replace('-', ' ').toUpperCase();
};
---

{/* ===== HERO CINEMATICO V2 ===== */}
<section 
  id="hero-v2" 
  class="relative h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] mx-auto mt-4 overflow-hidden flex items-end rounded-3xl bg-black"
  style="transform-origin: top center;"
>
  {/* ---- BACKGROUND ENGINE ---- */}
  <div id="hero-v2-slides-container" class="absolute inset-0 z-0 w-full h-full">
    {posts.map((post, i) => (
      <div 
        class={`hero-v2-slide absolute inset-0 transition-opacity duration-1000 ${i === 0 ? 'opacity-100 z-10 is-active' : 'opacity-0 z-0'}`}
        data-hero-slide={i}
      >
        <div class="hero-v2-cine-wrapper w-full h-[110%] absolute top-[-5%] left-0">
          <img
            src={post.image}
            alt={post.title}
            class="w-full h-full object-cover brightness-[0.55] contrast-[1.08]"
          />
        </div>

        {/* Scrims */}
        <div class="absolute inset-0 bg-linear-to-t from-[#050c08] via-black/50 to-transparent z-10"></div>
        <div class="absolute inset-0 bg-linear-to-r from-black/60 via-transparent to-transparent z-10"></div>
        
        {/* Granular Ken Burns local elements */}
        <div class="card-grain opacity-30 pointer-events-none"></div>
        <div class="card-scratches opacity-30 pointer-events-none"></div>
        <div class="atmospheric-dust z-20"></div>

        {/* Content Layer: Ritmo de Luces ([ensayo] -> [h1] -> [metadata] -> [leer pieza]) */}
        <div class="absolute inset-0 z-30 flex flex-col justify-end max-w-[1600px] mx-auto px-8 md:px-16 pb-20 md:pb-28 w-full h-full">
          {/* 1. Categoría/Colección (Sin punto, pulso lento) */}
          <div class="hero-v2-badge flex items-center gap-4 mb-6">
            <span class="inline-flex items-center text-copper-ember text-[9px] tracking-[0.6em] uppercase font-tgp-tech animate-pulse-slow">
              {formatCollection(post.collection)}
            </span>
          </div>

          {/* 2. H1 Título */}
          <h1 
            class="font-tgp-gloock hero-interactive-h1 text-3xl md:text-5xl lg:text-6xl font-normal leading-[1.05] tracking-[-0.02em]"
            style="max-width: 25ch;"
          >
            <a href={post.link} class="hover:text-copper-ember transition-colors duration-300 block">
              {post.title}
            </a>
          </h1>

          {/* 3. Subtítulo */}
          {post.subtitle && (
            <p class="mt-4 text-copper-ember/60 text-sm md:text-base font-tgp-body font-light leading-relaxed max-w-[55ch] tracking-wide">
              {post.subtitle}
            </p>
          )}

          {/* 4. Leer Pieza (CTA) */}
          <div class="hero-v2-cta mt-6">
            <a 
              href={post.link}
              class="inline-flex items-center gap-5 px-10 py-4 bg-white/1.5 border border-white/10 text-alpaca-silver text-[9px] tracking-[0.45em] uppercase font-bold font-tgp-tech rounded-sm hover:bg-white/5 hover:text-white/80 hover:border-white/20 transition-all duration-700 hover:scale-105"
            >
              Leer Pieza
              <span class="w-6 h-px bg-current inline-block transition-all duration-700"></span>
            </a>
          </div>

          {/* 5. Metadata: Mes y Año (Debajo de H1, subs y botón Leer Pieza) */}
          {/* 5. Metadata: Mes y Año & Redes */}
          <div class="hero-v2-folio mt-6 flex flex-wrap items-center gap-6">
            {post.date && (
              <span class="font-tgp-tech font-extralight text-[8px] tracking-[0.4em] uppercase text-copper-ember/35">
                {new Date(post.date).toLocaleDateString('es-AR', { year: 'numeric', month: 'long' })}
              </span>
            )}

            {/* Spotify & YouTube Discrete Links */}
            <div class="flex items-center gap-4">
              <a
                href="https://open.spotify.com/show/3zFq9ab980MamMHW48Sqxy"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 text-[9px] tracking-[0.22em] uppercase font-tgp-tech text-old-silver hover:text-[#E3DDD3] transition-colors duration-300 group"
              >
                <span class="flex items-center justify-center w-6 h-6 rounded-full border border-old-silver/20 bg-white/4 group-hover:border-[#E3DDD3]/50 group-hover:bg-white/8 transition-all duration-300">
                  <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.59 14.42c-.18.27-.53.37-.8.19-2.25-1.38-5.08-1.69-8.41-.93-.31.07-.62-.13-.69-.44-.07-.31.13-.62.44-.69 3.65-.83 6.78-.47 9.29 1.07.28.17.37.52.17.8zm1.22-2.72c-.22.36-.69.48-1.05.25-2.58-1.59-6.52-2.05-9.57-1.12-.4.12-.83-.11-.95-.51-.12-.4.11-.83.51-.95 3.5-.1 7.84.41 10.82 2.25.36.22.48.69.24 1.08zm.11-2.86C14.77 8.9 9.53 8.7 6.49 9.62c-.46.14-.94-.12-1.08-.58-.14-.46.12-.94.58-1.08 3.51-1.06 9.3-.84 13.06 1.39.42.25.56.8.31 1.22-.25.42-.8.56-1.22.31z"/>
                  </svg>
                </span>
                <span>Spotify</span>
              </a>
              <a
                href="https://www.youtube.com/@thegreatpuzzleproject"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 text-[9px] tracking-[0.22em] uppercase font-tgp-tech text-old-silver hover:text-[#E3DDD3] transition-colors duration-300 group"
              >
                <span class="flex items-center justify-center w-6 h-6 rounded-full border border-old-silver/20 bg-white/4 group-hover:border-[#E3DDD3]/50 group-hover:bg-white/8 transition-all duration-300">
                  <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
                    <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.507a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.507 9.388.507 9.388.507s7.518 0 9.388-.507a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                </span>
                <span>YouTube</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  {/* ---- UI: Flechas prev/next laterales mínimas (aparecen en hover) ---- */}
  <div class="hero-v2-nav-zone absolute inset-y-0 left-0 w-24 z-40 flex items-center justify-start group/hero-l">
    <button 
      id="hero-v2-prev"
      class="hero-v2-nav-btn pl-6 flex items-center justify-center group-hover/hero-l:-translate-x-1 transition-all duration-500 cursor-pointer"
      aria-label="Slide anterior"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
  </div>

  <div class="hero-v2-nav-zone absolute inset-y-0 right-0 w-24 z-40 flex items-center justify-end group/hero-r">
    <button 
      id="hero-v2-next"
      class="hero-v2-nav-btn pr-6 flex items-center justify-center group-hover/hero-r:translate-x-1 transition-all duration-500 cursor-pointer"
      aria-label="Slide siguiente"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>

  {/* Dots de progreso (Medio punto editorial centrado) */}
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-40 flex items-center gap-2">
    {posts.map((_, i) => (
      <button 
        class="hero-dot h-[1.5px] rounded-full bg-white/8 transition-all duration-500 hover:bg-white/20 cursor-pointer"
        style={`width: ${i === 0 ? '1.25rem' : '0.4rem'};`}
        data-hero-dot={i}
        aria-label={`Slide ${i + 1}`}
      ></button>
    ))}
  </div>

  {/* ---- SCROLL INDICATOR ---- */}
  <div 
    id="hero-v2-scroll-cue" 
    class="absolute bottom-10 right-8 md:right-16 z-40 flex flex-col items-center gap-3"
  >
    <span class="text-[7px] tracking-[0.6em] uppercase text-white/30 font-tgp-tech">Scroll</span>
    <div class="w-px h-12 bg-linear-to-b from-white/30 to-transparent hero-v2-scroll-line"></div>
  </div>
</section>

{/* ================================================================
    GSAP: Scroll-scrub del hero completo + Controles manuales
================================================================= */}
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initHeroV2 = () => {
    const hero        = document.getElementById('hero-v2');
    const slides      = document.querySelectorAll<HTMLElement>('[data-hero-slide]');
    const dots        = document.querySelectorAll<HTMLButtonElement>('[data-hero-dot]');
    const prevBtn     = document.getElementById('hero-v2-prev');
    const nextBtn     = document.getElementById('hero-v2-next');
    const scrollCue   = document.getElementById('hero-v2-scroll-cue');
    const INTERVAL    = 5000;
    let current       = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    if (!hero || slides.length === 0) return;

    // ── 1. SLIDER MACHINE ─────────
    const goToSlide = (index: number) => {
      slides.forEach((s, i) => {
        s.classList.toggle('opacity-100', i === index);
        s.classList.toggle('opacity-0',   i !== index);
        s.classList.toggle('is-active',   i === index);
        s.style.zIndex = i === index ? '10' : '0';

        // Animar entrada del contenido en ritmo de luces: badge -> h1 -> sub -> cta -> metadata
        if (i === index) {
          const b   = s.querySelector('.hero-v2-badge');
          const t   = s.querySelector('h1');
          const sub = s.querySelector('p');
          const cta = s.querySelector('.hero-v2-cta');
          const f   = s.querySelector('.hero-v2-folio');
          const targets = [b, t, sub, cta, f].filter(Boolean);

          if (timer) clearInterval(timer);
          gsap.killTweensOf(targets);

          gsap.fromTo(targets, 
            { y: 20, opacity: 0 },
            { 
              y: 0, 
              opacity: 1, 
              duration: 1.1, 
              ease: 'power2.out', 
              stagger: 0.16,
              onComplete: () => {
                // Reiniciar auto-timer recién AL COMPLETAR el ritmo de luces
                if (timer) clearInterval(timer);
                timer = setInterval(next, INTERVAL);
              }
            }
          );
        }
      });

      dots.forEach((d, i) => {
        d.style.backgroundColor = i === index ? 'rgba(255, 255, 255, 0.25)' : 'rgba(255, 255, 255, 0.08)';
        d.style.width           = i === index ? '1.25rem' : '0.4rem';
      });
    };

    const next = () => {
      current = (current + 1) % slides.length;
      goToSlide(current);
    };

    const prev = () => {
      current = (current - 1 + slides.length) % slides.length;
      goToSlide(current);
    };

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        if (timer) clearInterval(timer);
        current = i;
        goToSlide(current);
        timer = setInterval(next, INTERVAL);
      });
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (timer) clearInterval(timer);
      next();
      timer = setInterval(next, INTERVAL);
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (timer) clearInterval(timer);
      prev();
      timer = setInterval(next, INTERVAL);
    });

    // Pausar en hover
    hero.addEventListener('mouseenter', () => {
      if (timer) clearInterval(timer);
    });
    hero.addEventListener('mouseleave', () => {
      timer = setInterval(next, INTERVAL);
    });

    // Control manual por Scroll / Trackpad horizontal
    let wheelDebounce = 0;
    hero.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) > 25 || (e.shiftKey && Math.abs(e.deltaY) > 25)) {
        const now = Date.now();
        if (now - wheelDebounce > 400) {
          wheelDebounce = now;
          if (e.deltaX > 0 || e.deltaY > 0) next();
          else prev();
        }
      }
    }, { passive: true });

    // Control manual por cursor (Drag / Swipe)
    let startX = 0;
    let isDragging = false;
    hero.addEventListener('mousedown', (e) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      startX = e.clientX;
      isDragging = true;
    });
    hero.addEventListener('mouseup', (e) => {
      if (!isDragging) return;
      isDragging = false;
      const diffX = e.clientX - startX;
      if (Math.abs(diffX) > 50) {
        if (diffX < 0) next();
        else prev();
      }
    });

    // Auto-advance
    goToSlide(0);
    timer = setInterval(next, INTERVAL);

    // ── 2. SCROLL SCRUB ─────────
    gsap.to(hero, {
      scrollTrigger: {
        trigger: hero,
        start:  'top top',
        end:    'bottom top',
        scrub:  1.5,
        pin:    false,
      },
      opacity: 0,
      scale:   0.96,
      y:       '-3%',
      ease:    'none',
    });

    if (scrollCue) {
      ScrollTrigger.create({
        trigger: hero,
        start:   'top+=100 top',
        onEnter: () => gsap.to(scrollCue, { opacity: 0, y: -20, duration: 0.5 }),
      });
    }
  };

  document.addEventListener('astro:page-load', initHeroV2);
</script>

<style>
  /* Ken Burns: drift cinematográfico independiente del scroll */
  @keyframes hero-v2-drift {
    0%   { transform: scale(1.0)  translate(0%, 0%); }
    33%  { transform: scale(1.04) translate(-0.3%, 0.2%); }
    66%  { transform: scale(1.06) translate(-0.5%, -0.1%); }
    100% { transform: scale(1.0)  translate(0%, 0%); }
  }

  .hero-v2-cine-wrapper {
    animation: hero-v2-drift 40s ease-in-out infinite;
    will-change: transform;
  }

  /* Scroll line animation (breathing) */
  @keyframes scroll-breathe {
    0%, 100% { transform: scaleY(1); opacity: 0.3; }
    50%       { transform: scaleY(0.5); opacity: 0.6; }
  }

  .hero-v2-scroll-line {
    animation: scroll-breathe 2.5s ease-in-out infinite;
    transform-origin: top center;
  }

  /* Flechas laterales mínimas en hover */
  .hero-v2-nav-btn {
    opacity: 0;
    pointer-events: none;
    color: rgba(255, 255, 255, 0.15);
    transition: opacity 0.4s ease, transform 0.4s ease, color 0.3s ease;
  }

  #hero-v2:hover .hero-v2-nav-btn {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-v2-nav-btn:hover {
    color: rgba(255, 255, 255, 0.35);
  }

  .hero-v2-nav-zone {
    pointer-events: none;
  }

  #hero-v2:hover .hero-v2-nav-zone {
    pointer-events: auto;
  }

  /* Slow gentle pulse for badge text */
  @keyframes pulse-slow {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.3; }
  }

  .animate-pulse-slow {
    animation: pulse-slow 4.2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
