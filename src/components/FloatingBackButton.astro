---
// FloatingBackButton.astro
---

<a
  href="javascript:history.back()"
  class="tgp-back-btn fixed top-1/2 left-4 md:left-8 z-100 -translate-y-1/2 flex items-center justify-center text-white/20 hover:text-white/40 transition-colors duration-400 group cursor-pointer"
  aria-label="Volver atrás"
>
  <svg
    class="w-4 h-4 transition-transform duration-400 group-hover:-translate-x-0.5"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.25"
      d="M15 19l-7-7 7-7"></path>
  </svg>
</a>

<style>
  /* Efecto de entrada suave al cargar la página */
  .tgp-back-btn {
    animation: fade-in-left 1.2s ease-out forwards;
    opacity: 0;
  }

  @keyframes fade-in-left {
    from {
      opacity: 0;
      transform: translate(-20px, -50%);
    }
    to {
      opacity: 1;
      transform: translate(0, -50%);
    }
  }

  /* Ocultar sutilmente al hacer scroll hacia abajo (Opcional, manejado por GSAP si querés, pero así fijo en el medio es el estándar editorial actual) */
</style>
