---
/**
 * RowNetflixClasico.astro
 * Componente de Carrusel Netflix Clásico Vertical (Sibling Push + Hover Delay + Paginación)
 * 4 Columnas visibles en Desktop.
 */
import { getCollection } from 'astro:content';

interface SliderItem {
  title: string;
  subtitle?: string;
  image: string;
  link: string;
  collectionLabel?: string;
  date?: string;
}

interface Props {
  title?: string;
  eyebrow?: string;
  viewAllLink?: string;
  viewAllText?: string;
  collection?: 'visual_signals' | 'capsulas' | 'ensayos' | 'essays' | 'architectures' | string;
  currentSlug?: string;
  items?: SliderItem[];
  max?: number;
  variant?: 'vertical' | 'horizontal';
}

const { 
  title = "También podrían gustarte",
  eyebrow = "Colecciones",
  viewAllLink = "",
  viewAllText = "Ver Todas las Categorías",
  collection = "visual_signals",
  currentSlug = "",
  items: customItems,
  max = 15,
  variant = 'vertical'
} = Astro.props;

const COLLECTION_LABELS: Record<string, string> = {
  ensayos: 'Ensayos',
  essays: 'Dossiers',
  architectures: 'Magazines',
  visual_signals: 'Collections',
  'visual-signals': 'Collections',
  capsulas: 'eBooks',
  test: 'TEST',
};

const collectionKey = collection.replace('-', '_');
const activeLabel = COLLECTION_LABELS[collection] || COLLECTION_LABELS[collectionKey] || 'TGP';

let displayItems: SliderItem[] = [];

if (customItems && customItems.length > 0) {
  displayItems = customItems.slice(0, max);
} else {
  // ── Obtenemos posts de la colección especificada o de todas las colecciones ──
  let rawPosts: any[] = [];
  try {
    rawPosts = await getCollection(collectionKey as any);
  } catch {
    try {
      rawPosts = await getCollection(collection as any);
    } catch {
      rawPosts = [];
    }
  }

  // Si la colección tiene pocos items, completar con otras secciones
  if (!rawPosts || rawPosts.length < 5) {
    const otherCollections = ['visual_signals', 'capsulas', 'ensayos', 'essays', 'architectures'].filter(c => c !== collectionKey && c !== collection);
    for (const col of otherCollections) {
      try {
        const posts = await getCollection(col as any);
        if (Array.isArray(posts)) {
          rawPosts = [...rawPosts, ...posts.map((p: any) => ({ ...p, _collection: col }))];
        }
      } catch {}
    }
  }

  // Filtrar el post actual y mapear a formato estándar
  displayItems = rawPosts
    .filter((p: any) => p.id !== currentSlug)
    .slice(0, max)
    .map((p: any) => {
      const col = p._collection || p.collection || collectionKey;
      return {
        title: p.data?.title ?? 'Sin título',
        subtitle: p.data?.subtitle ?? p.data?.description ?? '',
        image: p.data?.hero_image ?? p.data?.coverImage ?? 'https://storage.thegreatpuzzleproject.com/default-hero.webp',
        link: `/${col.replace('_', '-')}/${p.id}`,
        collectionLabel: COLLECTION_LABELS[col] || activeLabel,
        date: p.data?.date ? String(p.data.date) : '',
      };
    });
}

// Sanitización segura de caracteres especiales
displayItems = displayItems.map(item => ({
  ...item,
  title: (item.title || '')
    .replaceAll('Ã±', 'ñ')
    .replaceAll('Ã¡', 'á')
    .replaceAll('Ã©', 'é')
    .replaceAll('Ã\u00AD', 'í')
    .replaceAll('Ã\xAD', 'í')
    .replaceAll('Ã³', 'ó')
    .replaceAll('Ãº', 'ú')
    .replaceAll('Ã‘', 'Ñ')
    .replaceAll('Â', ''),
}));

// ID único para aislar la instancia en caso de haber múltiples filas en la misma vista
const uid = `row-${Math.random().toString(36).substring(2, 8)}`;
---

<section 
  id={uid} 
  class={`netflix-row-root w-full py-6 md:py-10 overflow-hidden relative select-none group/section variant-${variant}`}
  data-variant={variant}
  aria-label={title}
>
  <!-- Encabezado de la fila -->
  <div class="mb-4 px-2 md:px-4 z-20 relative flex items-end justify-between gap-4">
    <div>
      {eyebrow && (
        <span class="text-[8px] md:text-[9px] tracking-[0.4em] uppercase font-mono text-amber-500/80 block mb-1">
          {eyebrow}
        </span>
      )}
      <h2 class="text-white text-xl md:text-2xl font-serif tracking-tight leading-tight uppercase">
        {title}
      </h2>
    </div>
    
    {viewAllLink ? (
      <a 
        href={viewAllLink}
        class="text-[8px] font-mono tracking-[0.25em] text-white/50 hover:text-amber-400 transition-colors uppercase cursor-pointer"
      >
        {viewAllText} &rarr;
      </a>
    ) : (
      <span class="text-[8px] font-mono tracking-[0.25em] text-white/30 uppercase hidden sm:inline-block">
        {displayItems.length} Elementos
      </span>
    )}
  </div>

  <!-- Contenedor Maestro: Define el alto fijo para evitar el 'Layout Shift' -->
  <div class="relative w-full px-2 md:px-4" style={variant === 'horizontal' ? "min-height: 240px;" : "min-height: 300px;"}>
    
    <!-- Botón Anterior Flotante en Cápsula (Aparece en hover) -->
    <button 
      class="nav-btn prev-btn absolute left-0 md:left-1 top-1/2 -translate-y-1/2 z-40 w-9 md:w-10 h-16 md:h-20 rounded-full bg-black/55 hover:bg-black/90 text-white/70 hover:text-white border border-white/15 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-0 group-hover/section:opacity-100 hover:scale-105 active:scale-95 disabled:opacity-0 disabled:pointer-events-none cursor-pointer shadow-xl"
      aria-label="Anterior"
    >
      <svg class="w-5 h-5 -translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </button>

    <!-- Botón Siguiente Flotante en Cápsula -->
    <button 
      class="nav-btn next-btn absolute right-0 md:right-1 top-1/2 -translate-y-1/2 z-40 w-9 md:w-10 h-16 md:h-20 rounded-full bg-black/55 hover:bg-black/90 text-white/70 hover:text-white border border-white/15 backdrop-blur-md transition-all duration-300 flex items-center justify-center opacity-0 group-hover/section:opacity-100 hover:scale-105 active:scale-95 disabled:opacity-0 disabled:pointer-events-none cursor-pointer shadow-xl"
      aria-label="Siguiente"
    >
      <svg class="w-5 h-5 translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>

    <!-- Pista de Deslizamiento -->
    <div class="track-wrapper overflow-visible py-4">
      <div class="netflix-track flex gap-3 md:gap-4 transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)]">
        
        {displayItems.map((item) => (
          <article class="netflix-card relative flex-none rounded-xl md:rounded-2xl overflow-hidden cursor-pointer">
            <a href={item.link} class="block w-full h-full" aria-label={`Ver: ${item.title}`}>
              <div class="w-full h-full bg-black/40 overflow-hidden">
                <img 
                  src={item.image} 
                  alt={item.title} 
                  class="netflix-card-img w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              
              <!-- Viñeta degradada inferior -->
              <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/40 to-transparent pointer-events-none"></div>

              <!-- Información Editorial -->
              <div class="card-info absolute inset-x-0 bottom-0 p-3.5 md:p-4 flex flex-col justify-end">
                <span class="text-[7.5px] tracking-[0.3em] uppercase text-amber-500/90 font-mono mb-1 block">
                  {item.subtitle || item.collectionLabel}
                </span>
                <h3 class="netflix-card-title text-white font-serif font-medium line-clamp-2 leading-snug uppercase">
                  {item.title}
                </h3>
              </div>
            </a>
          </article>
        ))}

      </div>
    </div>
  </div>
</section>

<style>
  /* ── 1. DIMENSIONES BASE (4 COLUMNAS VISIBLES EN DESKTOP) ── */
  .track-wrapper {
    width: 100%;
  }

  .netflix-track {
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  /* Tarjeta en Reposo Vertical (Default 2:3) */
  .netflix-card {
    width: calc(48% - 6px);
    aspect-ratio: 2 / 3;
    opacity: 0.7;
    background-color: var(--bg-card-main, #111716);
    border: 1px solid var(--border-card, #263231);
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.4);
    
    transform: translate3d(0, 0, 0) scale(1);
    transform-origin: center center;
    transition: 
      transform 340ms cubic-bezier(0.25, 1, 0.5, 1), 
      opacity 340ms ease,
      box-shadow 340ms ease, 
      border-color 340ms ease,
      background-color 340ms ease;
    will-change: transform, opacity;
  }

  /* Variante Horizontal 16:9 (Colecciones Destacadas) */
  .variant-horizontal .netflix-card {
    aspect-ratio: 16 / 9;
  }

  .netflix-card-img {
    filter: brightness(0.72) contrast(1.06);
    transition: filter 340ms ease;
  }

  .netflix-card-title {
    font-size: 0.85rem;
    opacity: 0.85;
    transition: opacity 300ms ease, color 300ms ease;
  }

  @media (min-width: 640px) {
    .netflix-card {
      width: calc(33.333% - 10px); /* 3 columnas en tablet */
    }
  }

  @media (min-width: 1024px) {
    .netflix-card {
      width: calc(25% - 12px); /* 4 columnas visibles exactas en desktop */
    }
    .netflix-card-title {
      font-size: 0.95rem;
    }
  }

  /* ── 2. EL EFECTO ZOOM Y EMPUJE DESTACADO (HOVER) ── */
  .netflix-card:hover {
    transform: translate3d(0, 0, 0) scale(1.18);
    z-index: 30;
    opacity: 1;
    background-color: var(--bg-card-sub, #161d1c);
    border-color: rgba(184, 115, 51, 0.6);
    box-shadow: 
      0 18px 38px -10px rgba(0, 0, 0, 0.75),
      0 0 0 1px rgba(184, 115, 51, 0.4);
    transition-delay: 260ms; 
  }

  .netflix-card:hover .netflix-card-img {
    filter: brightness(0.95) contrast(1.04);
    transition-delay: 260ms;
  }

  .netflix-card:hover .netflix-card-title {
    opacity: 1;
    color: #ffffff;
    transition-delay: 260ms;
  }

  /* SIBLING PUSH con :has() */
  .netflix-track:has(.netflix-card:hover) .netflix-card:not(:hover):has(~ .netflix-card:hover) {
    transform: translate3d(-10%, 0, 0);
    transition-delay: 260ms;
  }

  .netflix-card:hover ~ .netflix-card {
    transform: translate3d(10%, 0, 0);
    transition-delay: 260ms;
  }

  .netflix-track:not(:hover) .netflix-card {
    transition-delay: 0ms;
  }
</style>

<script>
  function initNetflixRows() {
    const rows = document.querySelectorAll<HTMLElement>('.netflix-row-root');

    rows.forEach(row => {
      if (row.hasAttribute('data-init')) return;
      row.setAttribute('data-init', 'true');

      const track = row.querySelector('.netflix-track') as HTMLElement | null;
      const prevBtn = row.querySelector('.prev-btn') as HTMLButtonElement | null;
      const nextBtn = row.querySelector('.next-btn') as HTMLButtonElement | null;
      
      if (!track || !prevBtn || !nextBtn || !track.parentElement) return;

      const trackEl: HTMLElement = track;
      const parentEl: HTMLElement = track.parentElement;
      const prevBtnEl: HTMLButtonElement = prevBtn;
      const nextBtnEl: HTMLButtonElement = nextBtn;

      let currentTransform = 0;

      function updateButtons() {
        const trackWidth = trackEl.scrollWidth;
        const containerWidth = parentEl.offsetWidth;
        
        prevBtnEl.disabled = currentTransform >= 0;
        nextBtnEl.disabled = Math.abs(currentTransform) + containerWidth >= trackWidth - 10;
      }

      function slide(direction: 'next' | 'prev') {
        const containerWidth = parentEl.offsetWidth;
        const moveAmount = containerWidth * 0.90; 

        if (direction === 'next') {
          currentTransform -= moveAmount;
        } else {
          currentTransform += moveAmount;
        }

        const maxScroll = -(trackEl.scrollWidth - containerWidth);
        
        if (currentTransform > 0) currentTransform = 0;
        if (currentTransform < maxScroll) currentTransform = maxScroll;

        trackEl.style.transform = `translate3d(${currentTransform}px, 0, 0)`;
        updateButtons();
      }

      nextBtnEl.addEventListener('click', () => slide('next'));
      prevBtnEl.addEventListener('click', () => slide('prev'));

      window.addEventListener('resize', () => {
        currentTransform = 0;
        trackEl.style.transform = `translate3d(0px, 0, 0)`;
        updateButtons();
      });

      updateButtons();
    });
  }

  if (typeof document !== 'undefined') {
    initNetflixRows();
    document.addEventListener('astro:page-load', initNetflixRows);
  }
</script>