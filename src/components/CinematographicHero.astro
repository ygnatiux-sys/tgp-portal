---
/**
 * CinematographicHero.astro
 * Un layout de impacto tipo Netflix para el post destacado.
 */
interface Props {
  title: string;
  subtitle?: string;
  image: string;
  vibeClass?: string;
  link?: string;
  category?: string;
}

const { title, subtitle, image, vibeClass = "", link = "#", category = "Featured" } = Astro.props;

// Is it a "Tactile" vibe? (Heuristic: victorian, ethnics, 80s)
const isTactile = vibeClass.includes('victorian') || vibeClass.includes('ethnics') || vibeClass.includes('80s');
---

<section class={`cinematographic-hero relative h-[calc(90vh-2rem)] md:h-[calc(100vh-2rem)] w-[calc(100%-2rem)] mx-auto mt-4 overflow-hidden flex items-center justify-center rounded-3xl ${vibeClass}`}>
  
  {/* Background Engine with Vignette & Scrim */}
  <div class="absolute inset-0 z-0">
    <div class="cine-wrapper w-full h-full">
      <img 
        src={image} 
        alt={title} 
        class="hero-img-target w-full h-full object-cover grayscale-[0.2] contrast-[1.1] brightness-[0.7]"
        style="transform-origin: center center; transform: scale(1.05);"
      />
    </div>
    
    {/* Cinematic Overlays (from global.css) */}
    <div class="texture-grain opacity-40"></div>
    <div class="texture-scratches"></div>
    <div class="atmospheric-dust opacity-30"></div>

    {/* The Scrim (Bottom-to-Top Gradient) */}
    <div class="absolute inset-0 bg-linear-to-t from-racing-green via-racing-green/40 to-black/20 z-10"></div>
    
    {/* The Deep Vignette */}
    <div class="absolute inset-0 z-15 pointer-events-none shadow-[inset_0_0_200px_rgba(0,0,0,0.95)] opacity-80 backdrop-blur-[1px]"></div>
    <div class="absolute inset-0 z-15 pointer-events-none ring-100 ring-inset ring-black/30 blur-3xl opacity-50"></div>
  </div>

  {/* Content Layer */}
  <div class="hero-content-box relative z-30 px-6 max-w-7xl w-full text-center md:text-left">
    <div class="mb-3 opacity-0 translate-y-8 animate-reveal">
      <span class="inline-flex items-center text-copper-ember text-[9px] tracking-[0.6em] uppercase font-tgp-tech animate-pulse-slow">
        {category}
      </span>
    </div>
    
    <h1 class={`hero-title hero-interactive-h1 font-gloock text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-bold leading-[0.9] tracking-[-0.03em] drop-shadow-[0_20px_40px_rgba(0,0,0,0.7)] mb-3 text-balance max-w-[20ch] opacity-0 translate-y-12 animate-reveal animation-delay-300 ${isTactile ? 'tactile-glow' : ''}`}>
      <a href={link} class="hover:text-copper-ember transition-colors duration-300">
        {title}
      </a>
    </h1>
    
    {subtitle && (
      <p class="font-sans text-[10px] md:text-xs tracking-[0.2em] text-gray-400 font-light max-w-4xl leading-relaxed opacity-0 animate-reveal animation-delay-600 mb-6">
        {subtitle}
      </p>
    )}

    <div class="opacity-0 animate-reveal animation-delay-900 group">
      <a href={link} class="inline-flex items-center gap-6 px-12 py-5 bg-white text-black font-sans text-[10px] tracking-[0.4em] uppercase font-bold rounded-sm hover:bg-copper-ember hover:text-white transition-all duration-700 hover:scale-105 shadow-xl shadow-black/50">
        Entrar al Archivo
        <span class="w-8 h-px bg-current group-hover:w-16 transition-all duration-700"></span>
      </a>
    </div>
  </div>

  {/* Physical Border (Tactile Mode) */}
  {isTactile && (
    <div class="absolute inset-10 border border-white/5 pointer-events-none z-40 opacity-30"></div>
  )}
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initHero = () => {
    const hero = document.querySelector('.cinematographic-hero');
    const img = document.querySelector('.hero-img-target');
    const contentBox = document.querySelector('.hero-content-box');
    const scratches = document.querySelector('.texture-scratches');
    const dust = document.querySelector('.atmospheric-dust');

    if (hero && img) {
      // 1. ZOOM-OUT & FADE OUT TO BLACK PHYSICS
      gsap.to(img, {
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          end: "bottom top",
          scrub: true
        },
        scale: 0.78,
        opacity: 0,
        ease: "power2.inOut"
      });

      // 2. UNIFIED CONTENT BLOCK FADE OUT (IN-PLACE SOFT GRADUAL FADE)
      if (contentBox) {
        gsap.to(contentBox, {
          scrollTrigger: {
            trigger: hero,
            start: "top top",
            end: "70% top",
            scrub: 1.2
          },
          y: -40,
          opacity: 0,
          scale: 0.94,
          ease: "power2.out"
        });
      }

      // 3. TEXTURE DEPTH synchronization
      if (scratches && dust) {
        gsap.to([scratches, dust], {
          scrollTrigger: {
            trigger: hero,
            start: "top top",
            end: "bottom top",
            scrub: true
          },
          y: 50,
          opacity: 0.1,
          ease: "none"
        });
      }
    }
  };

  // Lifecycle Protocol
  document.addEventListener('astro:page-load', initHero);
</script>

<style>
  .cinematographic-hero {
    background-color: var(--color-racing-green, #0A1C15);
  }

  .tactile-glow {
    text-shadow: 0 0 30px rgba(184, 115, 51, 0.4);
  }

  @keyframes reveal {
    from { opacity: 0; transform: translateY(3rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-reveal {
    animation: reveal 1.5s cubic-bezier(0.19, 1, 0.22, 1) forwards;
  }

  .animation-delay-300 { animation-delay: 300ms; }
  .animation-delay-600 { animation-delay: 600ms; }
  .animation-delay-900 { animation-delay: 900ms; }

  ::selection { background: #E3DDD3; color: #211A16; }

  /* Cinemagraph wrapper drift — capa independiente del GSAP */
  @keyframes cine-drift {
    0%   { transform: scale(1.06) translate(0%, 0%); }
    25%  { transform: scale(1.09) translate(-0.4%, 0.25%); }
    50%  { transform: scale(1.07) translate(-0.7%, -0.15%); }
    75%  { transform: scale(1.09) translate(-0.3%, 0.3%); }
    100% { transform: scale(1.06) translate(0%, 0%); }
  }

  .cine-wrapper {
    animation: cine-drift 36s ease-in-out infinite;
    will-change: transform;
    width: 100%;
    height: 110%; /* Headroom para el drift */
    position: absolute;
    top: -5%;
    left: 0;
  }

  .cinematographic-hero:hover .cine-wrapper {
    animation-duration: 18s;
  }
  
  .cinematographic-hero:hover .hero-img-target {
    filter: brightness(0.85) contrast(1.05);
    transition: filter 1.8s ease;
  }

  /* Slow gentle pulse for badge text */
  @keyframes pulse-slow {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.35; }
  }

  .animate-pulse-slow {
    animation: pulse-slow 3.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
