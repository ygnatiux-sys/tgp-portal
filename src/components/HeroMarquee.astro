---
interface Props {
  title: string;
  subtitle?: string;
  imageUrl?: string;
  vibeClass?: string;
}
const { title, subtitle = 'The Great Puzzle', imageUrl = '', vibeClass = '' } = Astro.props;
---
<section class={`dark-hero relative w-full h-[80vh] min-h-[600px] flex flex-col items-center justify-center overflow-hidden bg-racing-green ${vibeClass}`}>
  <!-- Infinite Marquee Background -->
  <div class="absolute inset-0 z-0 opacity-40 marquee-bg-pin flex">
    <div class="marquee-track flex h-full w-[200vw]">
      <img src={imageUrl} alt="Background Marquee 1" class="w-1/2 h-full object-cover dark-img-target" />
      <img src={imageUrl} alt="Background Marquee 2" class="w-1/2 h-full object-cover dark-img-target" />
    </div>
  </div>
  
  <!-- Cinematic Overlays (from global.css) -->
  <div class="texture-grain"></div>
  <div class="texture-scratches"></div>
  <div class="atmospheric-dust"></div>
  
  <!-- Universal Scrim Overlay (Aggressive for Dark) -->
  <div class="absolute inset-0 z-10 bg-linear-to-t from-racing-green via-racing-green/80 to-transparent"></div>
  <div class="absolute inset-0 z-10 bg-black/30 mix-blend-multiply"></div>

  <!-- Folio / Editorial Header -->
  <div class="absolute top-12 left-12 z-30 pointer-events-none">
    <div class={`vibe-target-folio text-white/40 text-[10px] uppercase ${vibeClass === 'vibe-travel-senses' ? 'vibe-vertical' : ''}`}>
      TGP Editorial // {vibeClass.replace('vibe-', '').replace(/-/g, ' ')}
    </div>
  </div>
  
  <!-- Massive Title & Subtitle -->
  <div class="title-container relative z-20 text-center px-6 w-full max-w-6xl mx-auto py-12">
    <p class="vibe-target-h2 font-sans text-sm uppercase tracking-[0.2em] text-[#c4a484]/80 mb-6 drop-shadow-md">
      {subtitle}
    </p>
    <h1 class="vibe-target-h1 font-serif text-6xl md:text-8xl text-[#c4a484] font-black uppercase tracking-tighter leading-none drop-shadow-2xl">
      {title}
    </h1>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initDarkHero = () => {
    const heroSection = document.querySelector('.dark-hero');
    const marqueeTrack = document.querySelector('.dark-hero .marquee-track');
    const bgPin = document.querySelector('.dark-hero .marquee-bg-pin');
    const titleContainer = document.querySelector('.dark-hero .title-container');
    const images = document.querySelectorAll('.dark-hero .dark-img-target');

    if (marqueeTrack) {
      gsap.to(marqueeTrack, {
        xPercent: -50,
        ease: "none",
        repeat: -1,
        duration: 90 
      });
    }

    if (heroSection && bgPin) {
      // 1. ZOOM-OUT & DIM
      gsap.to(images, {
        scrollTrigger: {
          trigger: heroSection,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
        scale: 0.8,
        opacity: 0.1,
        ease: "power2.inOut"
      });

      // 2. PARALLAX DRIFT
      gsap.to(bgPin, {
        scrollTrigger: {
          trigger: heroSection,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
        y: 100,
        ease: "none"
      });

      // 3. TITLE TRANSITION
      if (titleContainer) {
        gsap.to(titleContainer, {
          scrollTrigger: {
            trigger: heroSection,
            start: 'top top',
            end: 'bottom top',
            scrub: 1.2,
          },
          y: 250,
          opacity: 0,
          scale: 0.9,
          ease: "power3.out"
        });
      }
    }
  };

  // Lifecycle Protocol
  document.addEventListener('astro:page-load', initDarkHero);
</script>
