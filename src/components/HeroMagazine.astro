---
interface Props {
  title: string;
  subtitle?: string;
  imageUrl?: string;
  vibeClass?: string;
}
const {
  title,
  subtitle = "Editorial Magazine",
  imageUrl = "",
  vibeClass = "",
} = Astro.props;
---

<section
  class={`magazine-hero relative w-[calc(100%-2rem)] h-[calc(100vh-2rem)] min-h-212.5 mx-auto mt-4 overflow-hidden rounded-3xl ${vibeClass}`}
  style="background-color: var(--bg-current);"
>
  <div class="absolute inset-0 z-0 magazine-bg-pin overflow-hidden">
    <div class="absolute inset-0 opacity-90 flex">
      <div
        class="magazine-marquee-container flex h-full w-[200vw] will-change-transform"
      >
        <div class="cine-wrapper">
          <img
            src={imageUrl}
            alt=""
            class="w-full h-full object-cover grayscale-[0.2] contrast-110 magazine-img-target"
            style="transform-origin: center center;"
          />
        </div>
        <div class="cine-wrapper">
          <img
            src={imageUrl}
            alt=""
            class="w-full h-full object-cover grayscale-[0.2] contrast-110 magazine-img-target"
            style="transform-origin: center center;"
          />
        </div>
      </div>
    </div>

    <div class="texture-grain"></div>
    <div class="texture-scratches"></div>
    <div class="atmospheric-dust"></div>

    <div
      class="absolute inset-0 z-10"
      style="background-image: linear-gradient(to top, var(--bg-current) 0%, color-mix(in srgb, var(--bg-current) 50%, transparent) 50%, transparent 100%);"
    >
    </div>
    <div class="absolute inset-0 bg-black/20 z-10"></div>
  </div>

  <div
    class="magazine-content-box relative z-20 w-full h-full max-w-[1800px] mx-auto px-8 md:px-24 flex flex-col justify-end pb-16 md:pb-20 -translate-y-4"
  >
    <div class="magazine-title-box max-w-4xl pb-2">
      <h1 class="vibe-target-h1 hero-interactive-h1 text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-balance tracking-tight leading-[0.95] drop-shadow-2xl max-w-[22ch]">
        {title}
      </h1>
    </div>

    {subtitle && (
      <div class="magazine-meta-box mb-2 overflow-hidden max-w-3xl">
        <p
          class="vibe-target-h2 font-sans text-white/90 leading-relaxed text-balance max-w-full drop-shadow-md"
        >
          {subtitle}
        </p>
      </div>
    )}

    <h3
      class={`vibe-target-folio font-tgp-tech text-white/40 text-[9px] md:text-[10px] tracking-[0.25em] uppercase mt-2 ${vibeClass === "vibe-travel-senses" ? "vibe-vertical" : ""}`}
    >
      TGP Editorial // {vibeClass.replace("vibe-", "").replace(/-/g, " ")}
    </h3>

    {/* Spotify & YouTube Discrete Links */}
    <div class="flex items-center gap-4 mt-5 justify-start">
      <a
        href="https://open.spotify.com/show/3zFq9ab980MamMHW48Sqxy"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-[9px] tracking-[0.2em] uppercase font-tgp-tech text-white/40 hover:text-white transition-all duration-300 group"
      >
        <span class="flex items-center justify-center w-6 h-6 rounded-full border border-white/10 bg-white/5 group-hover:border-white/40 group-hover:bg-white/10 transition-all duration-300">
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.59 14.42c-.18.27-.53.37-.8.19-2.25-1.38-5.08-1.69-8.41-.93-.31.07-.62-.13-.69-.44-.07-.31.13-.62.44-.69 3.65-.83 6.78-.47 9.29 1.07.28.17.37.52.17.8zm1.22-2.72c-.22.36-.69.48-1.05.25-2.58-1.59-6.52-2.05-9.57-1.12-.4.12-.83-.11-.95-.51-.12-.4.11-.83.51-.95 3.5-.1 7.84.41 10.82 2.25.36.22.48.69.24 1.08zm.11-2.86C14.77 8.9 9.53 8.7 6.49 9.62c-.46.14-.94-.12-1.08-.58-.14-.46.12-.94.58-1.08 3.51-1.06 9.3-.84 13.06 1.39.42.25.56.8.31 1.22-.25.42-.8.56-1.22.31z"/>
          </svg>
        </span>
        <span>Spotify</span>
      </a>
      <a
        href="https://www.youtube.com/@thegreatpuzzleproject"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-[9px] tracking-[0.2em] uppercase font-tgp-tech text-white/40 hover:text-white transition-all duration-300 group"
      >
        <span class="flex items-center justify-center w-6 h-6 rounded-full border border-white/10 bg-white/5 group-hover:border-white/40 group-hover:bg-white/10 transition-all duration-300">
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
            <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.507a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.507 9.388.507 9.388.507s7.518 0 9.388-.507a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </span>
        <span>YouTube</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Ensuring Outfit thin weight is applied if available as fallback */
  .font-thin {
    font-weight: 100;
  }

  /* Cinemagraph drift en wrapper — sobre el marquee y el zoom GSAP */
  @keyframes cine-drift {
    0% {
      transform: scale(1.06) translate(0%, 0%);
    }
    25% {
      transform: scale(1.09) translate(-0.4%, 0.3%);
    }
    50% {
      transform: scale(1.07) translate(-0.8%, -0.2%);
    }
    75% {
      transform: scale(1.09) translate(-0.35%, 0.35%);
    }
    100% {
      transform: scale(1.06) translate(0%, 0%);
    }
  }

  .cine-wrapper {
    width: 100vw;
    height: 110%;
    flex-shrink: 0;
    position: relative;
    top: -5%;
    animation: cine-drift 34s ease-in-out infinite;
    will-change: transform;
  }

  .cine-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .magazine-hero:hover .cine-wrapper {
    animation-duration: 17s;
  }

  .magazine-hero:hover .magazine-img-target {
    /* Suavizado de luz en hover (antes brightness: 0.7) */
    filter: brightness(0.85) contrast(1.05);
    transition: filter 1.8s ease;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initMagazineHero = () => {
    const hero = document.querySelector(".magazine-hero");
    const marquee = document.querySelector(".magazine-hero .marquee-track");
    const bgPin = document.querySelector(".magazine-hero .magazine-bg-pin");
    const images = document.querySelectorAll(
      ".magazine-hero .magazine-img-target",
    );
    const contentBox = document.querySelector(".magazine-hero .magazine-content-box");

    // 1. Marquee Loop
    if (marquee) {
      gsap.fromTo(
        marquee,
        { xPercent: -50 },
        {
          xPercent: 0,
          ease: "none",
          repeat: -1,
          duration: 90,
        },
      );
    }

    if (hero && bgPin) {
      // 2. ZOOM-OUT & FADE OUT TO BLACK ON SCROLL
      gsap.to(images, {
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
        scale: 0.78,
        opacity: 0,
        ease: "power2.inOut",
      });

      // 3. BG PARALLAX DRIFT
      gsap.to(bgPin, {
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
        y: 120,
        ease: "none",
      });

      // 4. UNIFIED CONTENT BLOCK TRANSITION (IN-PLACE SOFT GRADUAL FADE)
      if (contentBox) {
        gsap.to(contentBox, {
          scrollTrigger: {
            trigger: hero,
            start: "top top",
            end: "70% top",
            scrub: 1.2,
          },
          y: 35,
          opacity: 0,
          scale: 0.94,
          ease: "power2.out",
        });
      }
    }
  };

  // Lifecycle Protocol
  document.addEventListener("astro:page-load", initMagazineHero);
</script>
