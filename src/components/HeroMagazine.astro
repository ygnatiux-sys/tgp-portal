---
interface Props {
  title: string;
  subtitle?: string;
  imageUrl?: string;
  vibeClass?: string;
}
const { title, subtitle = 'Editorial Magazine', imageUrl = '', vibeClass = '' } = Astro.props;
---
<section class={`magazine-hero relative w-full h-screen min-h-[850px] overflow-hidden bg-racing-green ${vibeClass}`}>
  <!-- Seamless GSAP Background -->
  <div class="absolute inset-0 z-0 magazine-bg-pin overflow-hidden">
    <div class="absolute inset-0 opacity-70">
      <div class="magazine-marquee-container flex h-full w-[200vw] will-change-transform">
        <img src={imageUrl} alt="" class="w-1/2 h-full object-cover grayscale-20 contrast-110" />
        <img src={imageUrl} alt="" class="w-1/2 h-full object-cover grayscale-20 contrast-110" />
      </div>
    </div>
    
    <!-- The Scrim: Deep luxury gradient -->
    <div class="absolute inset-0 bg-linear-to-t from-racing-green via-racing-green/60 to-transparent z-10"></div>
    <div class="absolute inset-0 bg-black/30 mix-blend-multiply z-10"></div>
  </div>

  <!-- Folio / Editorial Header (Absolute Floating) -->
  <div class="absolute top-12 left-12 md:top-16 md:left-16 z-30 pointer-events-none">
    <div class={`vibe-target-folio text-white/40 text-[9px] md:text-[10px] uppercase ${vibeClass === 'vibe-travel-senses' ? 'vibe-vertical' : ''}`}>
      TGP Editorial // {vibeClass.replace('vibe-', '').replace(/-/g, ' ')} // Vol. 2026
    </div>
  </div>

  <!-- Asymmetric High-Hierarchy Typography -->
  <div class="relative z-20 w-full h-full max-w-[1800px] mx-auto px-8 md:px-24 flex flex-col justify-end pb-24 md:pb-32">
    <!-- Metadata: H2 style for the "Ensayo" intro -->
    <div class="magazine-meta-box mb-8 md:mb-12 overflow-hidden">
      <p class="vibe-target-h2 font-sans text-white/80 opacity-80 leading-relaxed max-w-xl">
        {subtitle}
      </p>
    </div>

    <!-- H1: Massive Title -->
    <div class="magazine-title-box max-w-[90%] md:max-w-[80%]">
      <h1 class="vibe-target-h1 text-white/95 drop-shadow-2xl">
        {title}
      </h1>
    </div>
  </div>
</section>

<style>
  /* Ensuring Outfit thin weight is applied if available as fallback */
  .font-thin {
    font-weight: 100;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // 1. Infinite Seamless Marquee (Lento hacia la derecha)
  const marquee = document.querySelector('.magazine-marquee-container');
  if (marquee) {
    gsap.fromTo(marquee, 
      { xPercent: -50 },
      { 
        xPercent: 0, 
        ease: "none", 
        repeat: -1, 
        duration: 90 // Ultra lento, inmersivo
      }
    );
  }

  // 2. Scroll Animation: Parallax & Fade-out to 0.15
  const hero = document.querySelector('.magazine-hero');
  const bgPin = document.querySelector('.magazine-bg-pin');
  const titleBox = document.querySelector('.magazine-title-box');
  const metaBox = document.querySelector('.magazine-meta-box');

  if (hero && bgPin) {
    // Background fade-out smoothly to 0.15
    gsap.to(bgPin, {
      scrollTrigger: {
        trigger: hero,
        start: "top top",
        end: "bottom top",
        scrub: true
      },
      opacity: 0.15,
      y: 100, // Slight parallax push
      ease: "power3.out"
    });

    // Text fade and drift
    if (titleBox && metaBox) {
      gsap.to([titleBox, metaBox], {
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          end: "40% top",
          scrub: true
        },
        y: 150,
        opacity: 0,
        stagger: 0.05,
        ease: "power3.out"
      });
    }
  }
</script>
