---
/**
 * EditorialStressTest.astro
 * Provee una visualización de jerarquía tipográfica para testing de los estilos Vogue.
 * Este componente no utiliza clases de fuentes; delega el diseño al CSS global.
 */
import EditorialReadMore from './EditorialReadMore.astro';
import DynamicEditorialGallery from './DynamicEditorialGallery.astro';

interface Props {
  collection?: string;
  currentSlug?: string;
  vibeClass?: string;
}

const {
  collection = 'ensayos',
  currentSlug = '',
  vibeClass = ''
} = Astro.props;
---

<div class="editorial-stress-test">
  <h1>La Arquitectura del Silencio</h1>
  <h2>Una aproximación a la memoria de la piedra</h2>
  <p>
    El tiempo no borra, esculpe. Lo que hoy consideramos ruina fue una vez el centro de gravedad de una civilización. 
    A través de los siglos, el mármol y la diorita han mantenido un diálogo mudo con la gravedad, 
    esperando que el ojo humano redescubra la proporción divina en lo que parece azar.
  </p>
  
  <h3>Falla Estructural y Anomalía</h3>
  <blockquote>
    "No excavamos buscando objetos, excavamos buscando el vacío que dejaron." 
    <cite>— Xavier Benítez</cite>
  </blockquote>
  
  <h4>Coordenadas del Vacío</h4>
  <h5>Registro Secundario</h5>
  <h6>FIN DEL MANIFIESTO — TGP ARCHIVES</h6>

  {/* Galería Dinámica 1:1 con Lupa de Ampliación integrada en lugar del scroll vertical */}
  <DynamicEditorialGallery 
    title="Testing Spreads Editoriales"
    subtitle="Galería dinámica de placas 1:1 con ampliación e inspección fotográfica"
    vibeClass={vibeClass}
  />

  {/* Componente Dinámico de "Leer Más" integrado al grid body text */}
  <EditorialReadMore collection={collection} currentSlug={currentSlug} vibeClass={vibeClass} />
</div>

<style>
  /* 
     El estilo base aquí es mínimo para asegurar legibilidad, 
     pero los pesos y familias se controlarán por el vibeClass del padre.
  */
  .editorial-stress-test {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }
  
  /* Aseguramos que los párrafos tengan un interlineado base decente antes de la inyección de estilos */
  p {
    margin-bottom: 2rem;
  }
</style>
