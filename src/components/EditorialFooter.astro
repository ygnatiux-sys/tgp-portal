---
// EditorialFooter.astro
import Marquee from './Marquee.astro';

interface Props {
  showMarquee?: boolean;
}

const { showMarquee = true } = Astro.props;
---

{showMarquee && <Marquee />}
<footer class="bg-racing-green text-white py-10 md:py-12 border-t border-white/5">
  <div class="max-w-[1600px] mx-auto px-6 md:px-8 flex flex-col gap-6">
    
    {/* ── Nivel 1: Menús Principales Superiores Centrados ── */}
    <nav class="flex flex-wrap items-center justify-center gap-6 sm:gap-8 lg:gap-12 font-tgp-tech text-[11px] sm:text-xs tracking-[0.22em] uppercase font-medium text-white/70 select-none pt-1">
      <a href="/ensayos" class="inline-block hover:text-[#E3DDD3] transition-all duration-300">Ensayos</a>
      <a href="/essays" class="inline-block hover:text-[#E3DDD3] transition-all duration-300">Dossiers</a>
      <a href="/architectures" class="inline-block hover:text-[#E3DDD3] transition-all duration-300">Magazines</a>
      <a href="/visual-signals" class="inline-block hover:text-[#E3DDD3] transition-all duration-300">Collections</a>
      <a href="/capsulas" class="inline-block hover:text-[#E3DDD3] transition-all duration-300">eBooks</a>
      <a href="https://thegreatpuzzleproject.com" target="_self" class="inline-block text-[#E3DDD3]/90 hover:text-white transition-all duration-300">Ir a TGP</a>
    </nav>

    {/* ── Nivel 2: Fila de Redes Sociales entre Líneas Divisorias Delicadas ── */}
    <div class="w-full border-y border-white/10 py-3.5 flex items-center justify-center gap-5 sm:gap-6 text-white/40 flex-wrap">
      {/* YouTube */}
      <a href="https://www.youtube.com/@thegreatpuzzleproject" target="_blank" rel="noopener noreferrer" title="YouTube: @thegreatpuzzleproject" aria-label="YouTube" class="hover:text-[#E3DDD3] hover:scale-110 transition-all duration-300 inline-block p-1">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </a>
      {/* Instagram */}
      <a href="https://www.instagram.com/thegreatpuzzleproject" target="_blank" rel="noopener noreferrer" title="Instagram" aria-label="Instagram" class="hover:text-[#E3DDD3] hover:scale-110 transition-all duration-300 inline-block p-1">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.153-1.772 4.902 4.902 0 01-1.772-1.153c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" /></svg>
      </a>
      {/* X (Twitter) */}
      <a href="https://x.com/thegreatpuzzle" target="_blank" rel="noopener noreferrer" title="X (Twitter)" aria-label="X (Twitter)" class="hover:text-[#E3DDD3] hover:scale-110 transition-all duration-300 inline-block p-1">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
      </a>
      {/* Facebook */}
      <a href="https://facebook.com/thegreatpuzzleproject" target="_blank" rel="noopener noreferrer" title="Facebook: thegreatpuzzleproject.facebook.com" aria-label="Facebook" class="hover:text-[#E3DDD3] hover:scale-110 transition-all duration-300 inline-block p-1">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      {/* WhatsApp */}
      <a href="https://wa.me/5491134304074" target="_blank" rel="noopener noreferrer" title="WhatsApp: +54 9 11 3430 4074" aria-label="WhatsApp" class="hover:text-[#E3DDD3] hover:scale-110 transition-all duration-300 inline-block p-1">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
      </a>
      {/* TikTok */}
      <a href="https://www.tiktok.com/@thegreatpuzzleproject" target="_blank" rel="noopener noreferrer" title="TikTok: @thegreatpuzzleproject" aria-label="TikTok" class="hover:text-[#E3DDD3] hover:scale-110 transition-all duration-300 inline-block p-1">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-1-.01 1.83.01 3.67-.01 5.5-.06 2.37-.9 4.74-2.45 6.55-1.57 1.83-3.89 3.04-6.32 3.32-2.45.29-4.99-.21-7.14-1.49-2.15-1.28-3.79-3.32-4.47-5.71-.68-2.39-.42-4.98.69-7.19 1.11-2.21 3.03-3.93 5.37-4.71 2.34-.78 4.93-.53 7.07.69.01 1.48-.01 2.96 0 4.44-1.29-.63-2.8-.75-4.17-.32-1.37.43-2.48 1.44-3.04 2.76-.56 1.32-.47 2.87.24 4.1.71 1.23 1.97 2.05 3.38 2.22 1.41.17 2.85-.29 3.86-1.26 1.01-.97 1.57-2.34 1.59-3.74.02-3.81.01-7.62.01-11.43z"/></svg>
      </a>
    </div>

    {/* ── Nivel 3: Última Línea (Estilo National Geographic: Brand + Copyright + Legal) ── */}
    <div class="flex flex-col lg:flex-row items-center justify-between gap-5 text-white/50 font-tgp-tech text-[10px] tracking-[0.2em] uppercase pt-1">
      
      {/* Left Block: Brand (NatGeo style) + Vertical Separator + Copyright & Location */}
      <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 sm:gap-4">
        
        {/* Brand Lockup (NatGeo Style) */}
        <a href="/" class="flex items-center gap-2.5 shrink-0 group/footer-brand transition-all duration-300 no-underline select-none cursor-pointer">
          <div class="brand-logo w-5 h-5 flex items-center justify-center overflow-hidden rounded border border-[#E3DDD3]/40 group-hover/footer-brand:border-[#E3DDD3] p-0.5 shrink-0 transition-all bg-black/40 shadow-[0_0_8px_rgba(255,255,255,0.1)]">
            <img src="/faviconTGP.jpeg" alt="TGP Logo" class="w-full h-full object-cover rounded-xs" />
          </div>
          <div class="flex flex-col items-start leading-[1.05]">
            <span class="font-tgp-tech text-[6.5px] tracking-[0.22em] text-white/60 group-hover/footer-brand:text-[#E3DDD3] uppercase transition-colors">
              The Great Puzzle
            </span>
            <span class="font-tgp-gloock font-black text-xs sm:text-[13px] tracking-[0.24em] uppercase text-white group-hover/footer-brand:text-[#E3DDD3] transition-colors">
              Editions
            </span>
          </div>
        </a>

        {/* Vertical Divider Line (NatGeo Style) */}
        <div class="h-4 w-px bg-white/20 hidden sm:block"></div>

        {/* Copyright & Location Information */}
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 text-white/45 text-[9.5px]">
          <span>&copy; {new Date().getFullYear()} <span class="text-white/70">The Great Puzzle</span>. Todos los derechos reservados.</span>
          <span class="opacity-40 hidden sm:inline">&bull;</span>
          <span class="text-white/60">Buenos Aires</span>
          <span class="opacity-40">&bull;</span>
          <span class="text-white/60">Argentina</span>
          <span class="opacity-40">&bull;</span>
          <a 
            href="https://share.google/kk8OYubL2oxzRGNab" 
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#E3DDD3] transition-all duration-300 text-old-silver underline decoration-white/20 underline-offset-2"
          >
            Sur Global
          </a>
        </div>

      </div>

      {/* Right Block: Legal Links */}
      <div class="flex items-center gap-6 shrink-0 text-[9.5px] select-none text-white/40">
        <a href="#" class="hover:text-[#E3DDD3] transition-all duration-300">Privacidad</a>
        <a href="#" class="hover:text-[#E3DDD3] transition-all duration-300">Términos</a>
      </div>

    </div>

  </div>
</footer>
