---
// EditorialFooter.astro
---

<footer class="bg-racing-green text-white border-t border-white/5 py-8 mt-16">
  <div class="max-w-[1600px] mx-auto px-8">
    
    {/* Row 1: Brand & Menu Links */}
    <div class="flex flex-col md:flex-row justify-between items-center pb-6 border-b border-white/5 gap-6">
      {/* Brand & Project Tag */}
      <div class="flex items-center gap-3">
        {/* Favicon Icon */}
        <div class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center p-0.5 shrink-0 bg-black/20 overflow-hidden">
          <img src="/faviconTGP.jpeg" alt="TGP Icon" class="w-full h-full object-cover rounded-full" />
        </div>
        <div class="flex flex-col gap-1.5">
          <div class="flex items-baseline gap-3">
            <h2 class="font-tgp-gloock font-black text-lg md:text-xl tracking-[0.02em] uppercase text-white/95 leading-none">
              The Great Puzzle
            </h2>
            <span class="font-tgp-tech text-[8px] tracking-[0.15em] text-old-silver uppercase">
              -project-
            </span>
          </div>
          <a 
            href="https://gravatar.com/xavierbeniteztgp" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="font-tgp-tech text-[7px] tracking-[0.15em] text-old-silver/75 hover:text-copper-ember transition-colors self-start"
          >
            Dir. Xavier Benítez
          </a>
        </div>
      </div>
      
      {/* Footer Navigation Menu */}
      <nav class="flex flex-wrap gap-6 md:gap-8 font-tgp-tech text-[9px] tracking-[0.15em] uppercase font-medium text-white/60">
        <a href="/ensayos" class="hover:text-copper-ember transition-colors duration-300">Ensayos</a>
        <a href="/essays" class="hover:text-copper-ember transition-colors duration-300">Essays</a>
        <a href="/architectures" class="hover:text-copper-ember transition-colors duration-300">Architectures</a>
        <a href="/visual-signals" class="hover:text-copper-ember transition-colors duration-300">Signals</a>
        <a href="/capsulas" class="hover:text-copper-ember transition-colors duration-300">Cápsulas</a>
      </nav>
    </div>

    {/* Row 2: Copyright, Legal & Social Media */}
    <div class="flex flex-col md:flex-row justify-between items-center py-6 border-b border-white/5 gap-4 text-white/30 font-tgp-tech text-[8px] uppercase tracking-[0.15em]">
      <div class="flex flex-col md:flex-row items-center gap-4 md:gap-8">
        <p>&copy; {new Date().getFullYear()} The Great Puzzle. Todos los derechos reservados.</p>
        <div class="flex gap-6">
          <a href="#" class="hover:text-copper-ember transition-colors">Privacidad</a>
          <a href="#" class="hover:text-copper-ember transition-colors">Términos</a>
        </div>
      </div>
      
      {/* Social Media Icons */}
      <div class="flex items-center gap-6">
        {/* X (Twitter) */}
        <a href="#" aria-label="X (Twitter)" class="text-white/40 hover:text-copper-ember hover:-translate-y-0.5 transition-all duration-300">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
        {/* Instagram */}
        <a href="#" aria-label="Instagram" class="text-white/40 hover:text-copper-ember hover:-translate-y-0.5 transition-all duration-300">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
          </svg>
        </a>
        {/* LinkedIn */}
        <a href="#" aria-label="LinkedIn" class="text-white/40 hover:text-copper-ember hover:-translate-y-0.5 transition-all duration-300">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>

    {/* Row 3: Editorial Location */}
    <div class="pt-6 flex justify-center text-center">
      <div class="font-tgp-tech text-[8px] tracking-[0.4em] uppercase text-white/20 flex items-center gap-3.5 flex-wrap justify-center">
        <span>Buenos Aires</span>
        <span class="w-1 h-1 rounded-full bg-[#E3DDD3]/30 self-center"></span>
        <span>Argentina</span>
        <span class="w-1 h-1 rounded-full bg-[#E3DDD3]/30 self-center"></span>
        <a 
          href="https://share.google/kk8OYubL2oxzRGNab" 
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/20 hover:text-copper-ember transition-colors"
        >
          Sur Global
        </a>
      </div>
    </div>

  </div>
</footer>
