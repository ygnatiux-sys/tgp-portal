---
/**
 * EditorialReadMore.astro
 * Modelo Tríptico Editorial de "Continuar Lectura":
 * 1. Card Hero Protagonista Arriba (Full-width panorámico con tipografía editorial)
 * 2. Carrusel RowNetflixClasico Debajo (4 columnas visibles en desktop con artículos recientes)
 */
import { getCollection } from 'astro:content';
import RowNetflixClasico from './RowNetflixClasico.astro';

interface Props {
  collection?: 'ensayos' | 'essays' | 'architectures' | 'visual_signals' | 'capsulas' | string;
  currentSlug?: string;
  items?: Array<{
    title: string;
    subtitle?: string;
    description?: string;
    image: string;
    link: string;
    collectionLabel?: string;
    date?: string;
  }>;
  vibeClass?: string;
}

const {
  collection = 'ensayos',
  currentSlug = '',
  items: customItems,
  vibeClass = ''
} = Astro.props;

const COLLECTION_LABELS: Record<string, string> = {
  ensayos: 'Ensayos',
  essays: 'Dossiers',
  architectures: 'Magazines',
  visual_signals: 'Collections',
  'visual-signals': 'Collections',
  capsulas: 'eBooks',
  test: 'TEST',
};

const collectionKey = collection.replace('-', '_');
const activeLabel = COLLECTION_LABELS[collection] || COLLECTION_LABELS[collectionKey] || 'TGP';

let allNormalizedPosts: any[] = [];

if (customItems && customItems.length >= 2) {
  allNormalizedPosts = customItems;
} else {
  // ── Obtenemos artículos recientes de todas las colecciones principales ──
  const collectionsToQuery = ['ensayos', 'essays', 'capsulas', 'architectures', 'visual_signals'];
  let pool: any[] = [];

  for (const col of collectionsToQuery) {
    try {
      const posts = await getCollection(col as any);
      if (Array.isArray(posts)) {
        posts.forEach((p: any) => {
          if (!p.data?.draft) {
            pool.push({
              ...p,
              _col: col,
            });
          }
        });
      }
    } catch {}
  }

  // Ordenar por fecha más reciente
  pool.sort((a: any, b: any) => {
    const dateA = a.data?.date ? new Date(String(a.data.date)).getTime() : 0;
    const dateB = b.data?.date ? new Date(String(b.data.date)).getTime() : 0;
    if (dateA && dateB && dateA !== dateB) return dateB - dateA;
    return (b.id || '').localeCompare(a.id || '');
  });

  // Filtrar el artículo actual
  allNormalizedPosts = pool
    .filter((p: any) => p.id !== currentSlug)
    .map((p: any) => {
      const col = p._col || p.collection || collectionKey;
      return {
        title: p.data?.title ?? 'Sin título',
        subtitle: p.data?.subtitle ?? p.data?.description ?? '',
        image: p.data?.hero_image ?? p.data?.coverImage ?? 'https://storage.thegreatpuzzleproject.com/default-hero.webp',
        link: `/${col.replace('_', '-')}/${p.id}`,
        collectionLabel: COLLECTION_LABELS[col] || activeLabel,
        date: p.data?.date ? String(p.data.date) : '',
      };
    });
}

// Sanitización segura de caracteres
allNormalizedPosts = allNormalizedPosts.map(item => ({
  ...item,
  title: (item.title || '')
    .replaceAll('Ã±', 'ñ')
    .replaceAll('Ã¡', 'á')
    .replaceAll('Ã©', 'é')
    .replaceAll('Ã\u00AD', 'í')
    .replaceAll('Ã\xAD', 'í')
    .replaceAll('Ã³', 'ó')
    .replaceAll('Ãº', 'ú')
    .replaceAll('Ã‘', 'Ñ')
    .replaceAll('Â', ''),
  subtitle: (item.subtitle || '')
    .replaceAll('Ã±', 'ñ')
    .replaceAll('Ã¡', 'á')
    .replaceAll('Ã©', 'é')
    .replaceAll('Ã\u00AD', 'í')
    .replaceAll('Ã\xAD', 'í')
    .replaceAll('Ã³', 'ó')
    .replaceAll('Ãº', 'ú')
    .replaceAll('Ã‘', 'Ñ')
    .replaceAll('Â', ''),
}));

// Separamos el Hero Principal (arriba) y los siguientes para el carrusel (debajo)
const heroPost = allNormalizedPosts[0] || null;
const rowPosts = allNormalizedPosts.slice(1, 16);
---

<section class={`editorial-read-more-wrapper w-full pt-12 pb-6 flex flex-col gap-10 select-none ${vibeClass}`}>
  
  <!-- ═══════════════════════════════════════════════════════════════════
       1. CARD HERO PROTAGONISTA (Arriba)
  ═══════════════════════════════════════════════════════════════════ -->
  {heroPost && (
    <div class="w-full">
      <div class="flex items-center justify-between gap-4 mb-3 px-2">
        <span class="text-[8px] md:text-[9px] tracking-[0.4em] uppercase font-mono text-amber-500/90 font-bold block">
          Lectura Recomendada
        </span>
        <span class="text-[8px] tracking-[0.3em] font-mono uppercase text-white/30">
          {heroPost.collectionLabel}
        </span>
      </div>

      {/* ── REGLA: overflow-hidden + borde estructural sutil ── */}
      <a 
        href={heroPost.link}
        class="group block relative w-full rounded-2xl md:rounded-3xl overflow-hidden border border-white/5 hover:border-amber-500/40 transition-all duration-500 shadow-2xl"
      >
        {/* ── REGLA 1: Imagen Base Pura — sin brightness, sin overlay global ── */}
        <div class="relative w-full aspect-video md:aspect-21/9 bg-black">
          <img 
            src={heroPost.image} 
            alt={heroPost.title} 
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)]"
          />

          {/* ── REGLA 2: Scrim Localizado — solo protege la zona del texto ── */}
          <div class="absolute bottom-0 left-0 w-3/4 sm:w-2/3 h-1/2 sm:h-2/3 bg-linear-to-tr from-black/95 via-black/70 to-transparent pointer-events-none"></div>

          {/* ── REGLA 3: Contenedor del Texto — anclado abajo izq, z-10 ── */}
          <div class="absolute bottom-0 left-0 p-6 md:p-10 lg:p-12 flex flex-col justify-end gap-3 z-10">
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 rounded-full text-[7.5px] tracking-[0.3em] uppercase font-mono bg-black/60 backdrop-blur-md text-amber-400 border border-amber-400/30">
                {heroPost.collectionLabel}
              </span>
              {heroPost.date && (
                <span class="text-[8px] font-mono tracking-widest text-white/40">
                  {heroPost.date}
                </span>
              )}
            </div>

            {/* ── REGLA 4: Título — font-bold + tracking-wide. SIN text-shadow. ── */}
            <h3 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-serif font-bold tracking-wide leading-tight text-white group-hover:text-amber-300 transition-colors duration-300 max-w-2xl">
              {heroPost.title}
            </h3>

            {heroPost.subtitle && (
              <p class="font-sans text-xs sm:text-sm text-gray-300/80 font-light line-clamp-2 max-w-xl leading-relaxed">
                {heroPost.subtitle}
              </p>
            )}

            <div class="pt-1">
              <span class="inline-flex items-center gap-2 text-[8px] md:text-[9px] font-mono uppercase tracking-[0.25em] text-amber-400 group-hover:translate-x-1.5 transition-transform duration-300">
                <span>Continuar Lectura</span>
                <span>→</span>
              </span>
            </div>
          </div>
        </div>
      </a>
    </div>
  )}

  <!-- ═══════════════════════════════════════════════════════════════════
       2. CARRUSEL ROW NETFLIX CLÁSICO (Debajo — 4 columnas en Desktop)
  ═══════════════════════════════════════════════════════════════════ -->
  {rowPosts.length > 0 && (
    <div class="w-full pt-2">
      <RowNetflixClasico 
        items={rowPosts}
        title="Más Artículos Recientes"
        eyebrow="Archivo Epistémico"
        max={15}
      />
    </div>
  )}

</section>