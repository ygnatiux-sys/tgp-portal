---
/**
 * ImmersiveSlider.astro
 * Sección de altura completa (100dvh) con auto-slider de tarjetas gigantes.
 *
 * Cada slide muestra:
 * - Imagen full-bleed de fondo
 * - Título en display grande
 * - Subtítulo + metadatos (colección, fecha, autor)
 * - Indicador de progreso (barra superior + número de slide)
 *
 * Transición: GSAP clipPath horizontal (wipe cinematográfico)
 */

interface Post {
  title: string;
  subtitle?: string;
  image: string;
  link: string;
  collection: string;
  date?: string;
  author?: string;
  readTime?: string;
  id: string;
}

interface Props {
  posts: Post[];
  interval?: number; // ms entre slides. Default: 6000
}

const { posts, interval = 6000 } = Astro.props;

// Mínimo 3 slides para que el slider tenga sentido
const slides = posts.slice(0, 8);

const formatCollection = (col: string) =>
  col.replace('_', ' ').replace('-', ' ')
    .split(' ')
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
---

<section 
  id="immersive-slider"
  class="relative w-[calc(100%-2rem)] mx-auto my-4 overflow-hidden bg-black rounded-3xl"
  style="height: calc(100dvh - 2rem);"
  aria-label="Slider inmersivo de piezas"
>
  {/* ---- SLIDES ---- */}
  <div id="immersive-slides-container" class="relative w-full h-full">
    {slides.map((post, i) => (
      <article
        class={`immersive-slide absolute inset-0 w-full h-full ${i === 0 ? 'is-active' : ''}`}
        data-slide-index={i}
        aria-hidden={i !== 0}
      >
        {/* Background Image */}
        <div class="absolute inset-0 z-0 overflow-hidden">
          <div class="hero-v2-cine-wrapper w-full h-[110%] absolute top-[-5%] left-0">
            <img
              src={post.image}
              alt={post.title}
              class="w-full h-full object-cover brightness-[0.55] contrast-[1.08]"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
          {/* Cinematic scrims */}
          <div class="absolute inset-0 bg-linear-to-t from-[#050c08] via-black/50 to-transparent z-10"></div>
          <div class="absolute inset-0 bg-linear-to-r from-black/60 via-transparent to-transparent z-10"></div>

          {/* Granular Ken Burns local elements */}
          <div class="card-grain opacity-30 pointer-events-none"></div>
          <div class="card-scratches opacity-30 pointer-events-none"></div>
          <div class="atmospheric-dust z-20"></div>
        </div>

        {/* Content: Alineado abajo a la izquierda, igual que CinematicHeroV2 */}
        <div class="absolute inset-0 z-30 flex flex-col justify-end max-w-[1600px] mx-auto px-8 md:px-16 pb-20 md:pb-28 w-full h-full">

          {/* Badge */}
          <div class="immersive-content flex items-center gap-4 mb-8">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 border border-copper-ember/40 text-copper-ember text-[8px] tracking-[0.6em] uppercase rounded-full bg-black/50 backdrop-blur-md font-tgp-tech">
              <span class="w-1.5 h-1.5 rounded-full bg-copper-ember animate-pulse"></span>
              {formatCollection(post.collection)}
            </span>
            <span class="font-tgp-tech text-[8px] tracking-[0.7em] uppercase text-white/20">
              {String(i + 1).padStart(2, '0')} / {String(slides.length).padStart(2, '0')}
            </span>
          </div>

          {/* Título: display XL */}
          <h2 class="immersive-content font-tgp-gloock text-3xl md:text-5xl lg:text-6xl font-normal leading-[1.05] tracking-[-0.02em] text-copper-ember mb-8" style="max-width: 25ch;">
            {post.title}
          </h2>

          {/* Subtítulo */}
          {post.subtitle && (
            <p class="immersive-content mt-6 text-copper-ember/60 text-sm md:text-base font-tgp-body font-light leading-relaxed max-w-[55ch] tracking-wide mb-10">
              {post.subtitle}
            </p>
          )}

          {/* Metadatos (Folio) + Button Translucido */}
          <div class="immersive-content flex items-center gap-8 mt-10">
            {post.author && (
              <span class="text-[9px] tracking-[0.35em] uppercase text-copper-ember/40 font-tgp-tech">
                {post.author}
              </span>
            )}
            {post.date && (
              <span class="text-[9px] tracking-[0.35em] uppercase text-copper-ember/30 font-tgp-tech">
                {new Date(post.date).toLocaleDateString('es-AR', { year: 'numeric', month: 'long' })}
              </span>
            )}
            <a 
              href={post.link}
              class="ml-auto inline-flex items-center gap-5 px-10 py-4 bg-white/5 backdrop-blur-md border border-white/10 text-alpaca-silver text-[9px] tracking-[0.45em] uppercase font-bold font-tgp-tech rounded-sm hover:bg-charcoal-wood/5 hover:text-old-silver hover:border-charcoal-wood/10 transition-all duration-700 hover:scale-105 shadow-2xl shadow-black/60"
            >
              Leer Pieza
              <span class="w-6 h-px bg-current inline-block transition-all duration-700"></span>
            </a>
          </div>
        </div>

        {/* Número de slide: decorativo, derecha */}
        <div class="absolute bottom-12 right-10 z-10 hidden md:block">
          <span class="font-tgp-gloock text-[12vw] text-white/5 leading-none select-none">
            {String(i + 1).padStart(2, '0')}
          </span>
        </div>
      </article>
    ))}
  </div>



  {/* ---- UI: Controles y dots ---- */}
  <div class="absolute bottom-10 left-8 md:left-16 z-50 flex items-center gap-5">
    {slides.map((_, i) => (
      <button
        class="immersive-dot relative h-0.5 bg-white/20 transition-all duration-500 rounded-full hover:bg-white/50"
        style={`width: ${i === 0 ? '2.5rem' : '0.75rem'};`}
        data-immersive-dot={i}
        aria-label={`Ir al slide ${i + 1}`}
      ></button>
    ))}
  </div>

  {/* ---- UI: Flechas prev/next laterales (Global Physics) ---- */}
  <div class="side-nav-zone absolute inset-y-0 left-0 w-24 z-50 flex items-center justify-start group/side-l">
    <button 
      id="immersive-prev"
      class="side-nav-btn pl-6 flex items-center justify-center text-charcoal-wood hover:text-copper-ember group-hover/side-l:-translate-x-1 transition-all duration-500 cursor-pointer"
      aria-label="Slide anterior"
    >
      <svg class="w-10 h-10 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
  </div>

  <div class="side-nav-zone absolute inset-y-0 right-0 w-24 z-50 flex items-center justify-end group/side-r">
    <button 
      id="immersive-next"
      class="side-nav-btn pr-6 flex items-center justify-center text-charcoal-wood hover:text-copper-ember group-hover/side-r:translate-x-1 transition-all duration-500 cursor-pointer"
      aria-label="Slide siguiente"
    >
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>

  {/* ---- UI: Sección label (top-left) ---- */}
  <div class="absolute top-8 left-10 md:left-20 z-50">
    <span class="font-tgp-tech text-[7px] tracking-[0.8em] uppercase text-white/20">
      — Archivo Inmersivo
    </span>
  </div>

</section>

{/* ================================================================
    GSAP: Transición clipPath + auto-slider
================================================================= */}
<script define:vars={{ interval }}>
  import { gsap } from 'gsap';

  const INTERVAL = interval;

  const initImmersiveSlider = () => {
    const slides   = document.querySelectorAll('.immersive-slide');
    const dots     = document.querySelectorAll('[data-immersive-dot]');
    const progress = document.getElementById('immersive-progress');
    const prevBtn  = document.getElementById('immersive-prev');
    const nextBtn  = document.getElementById('immersive-next');

    if (slides.length === 0) return;

    let current  = 0;
    let autoTimer = null;
    let isAnimating = false;

    // Estado inicial: todos los slides ocultos excepto el primero
    gsap.set(slides, { clipPath: 'inset(0 100% 0 0)', opacity: 0 });
    gsap.set(slides[0], { clipPath: 'inset(0 0% 0 0)', opacity: 1 });

    const updateDots = (index) => {
      dots.forEach((d, i) => {
        gsap.to(d, {
          width: i === index ? '2.5rem' : '0.75rem',
          backgroundColor: i === index ? '#E3DDD3' : 'rgba(255,255,255,0.2)',
          duration: 0.4,
          ease: 'power2.out',
        });
      });
    };

    const startProgress = () => {
      if (!progress) return;
      gsap.killTweensOf(progress);
      gsap.fromTo(progress, 
        { width: '0%' },
        { width: '100%', duration: INTERVAL / 1000, ease: 'none' }
      );
    };

    const goToSlide = (next, direction = 1) => {
      if (isAnimating || next === current) return;
      isAnimating = true;

      const outSlide = slides[current];
      const inSlide  = slides[next];

      // Slide entrante: aparece desde el lado correspondiente
      gsap.set(inSlide, {
        clipPath: direction > 0 ? 'inset(0 0% 0 100%)' : 'inset(0 100% 0 0%)',
        opacity: 1,
        zIndex: 10,
      });
      gsap.set(outSlide, { zIndex: 5 });

      // Animar entrada
      gsap.to(inSlide, {
        clipPath: 'inset(0 0% 0 0%)',
        duration: 1.1,
        ease: 'expo.inOut',
        onComplete: () => {
          gsap.set(outSlide, { clipPath: 'inset(0 100% 0 0)', opacity: 0, zIndex: 0 });
          current = next;
          isAnimating = false;
        },
      });

      // Animación del contenido del slide entrante
      const contents = inSlide.querySelectorAll('.immersive-content');
      gsap.fromTo(contents,
        { y: 30, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.9, ease: 'expo.out', stagger: 0.08, delay: 0.3 }
      );

      updateDots(next);
      startProgress();
    };

    const nextSlide = () => {
      const n = (current + 1) % slides.length;
      goToSlide(n, 1);
    };

    const prevSlide = () => {
      const p = (current - 1 + slides.length) % slides.length;
      goToSlide(p, -1);
    };

    // Controles
    nextBtn?.addEventListener('click', () => {
      clearInterval(autoTimer);
      nextSlide();
      autoTimer = setInterval(nextSlide, INTERVAL);
      startProgress();
    });

    prevBtn?.addEventListener('click', () => {
      clearInterval(autoTimer);
      prevSlide();
      autoTimer = setInterval(nextSlide, INTERVAL);
      startProgress();
    });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        clearInterval(autoTimer);
        goToSlide(i, i > current ? 1 : -1);
        autoTimer = setInterval(nextSlide, INTERVAL);
        startProgress();
      });
    });

    // Auto-advance
    updateDots(0);
    startProgress();
    autoTimer = setInterval(nextSlide, INTERVAL);

    // Pausar en hover
    const section = document.getElementById('immersive-slider');
    section?.addEventListener('mouseenter', () => clearInterval(autoTimer));
    section?.addEventListener('mouseleave', () => {
      autoTimer = setInterval(nextSlide, INTERVAL);
    });
  };

  document.addEventListener('astro:page-load', initImmersiveSlider);
</script>

<style>
  .immersive-slide {
    will-change: clip-path, opacity;
  }
  .immersive-slide.is-active {
    z-index: 10;
  }
  [data-immersive-dot] {
    cursor: pointer;
    border-radius: 1px;
  }

  /* Ken Burns drift cinematográfico */
  @keyframes hero-v2-drift {
    0%   { transform: scale(1.0)  translate(0%, 0%); }
    33%  { transform: scale(1.04) translate(-0.3%, 0.2%); }
    66%  { transform: scale(1.06) translate(-0.5%, -0.1%); }
    100% { transform: scale(1.0)  translate(0%, 0%); }
  }

  .hero-v2-cine-wrapper {
    animation: hero-v2-drift 40s ease-in-out infinite;
    will-change: transform;
  }

  /* Animación de flechas hover nav */
  .immersive-nav-arrows {
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  
  #immersive-slider:hover .immersive-nav-arrows {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
</style>
