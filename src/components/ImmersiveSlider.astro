---
/**
 * ImmersiveSlider.astro
 * Sección de altura completa (100dvh) con auto-slider de tarjetas gigantes.
 *
 * Cada slide muestra:
 * - Imagen full-bleed de fondo
 * - Título en display grande
 * - Subtítulo + metadatos (colección, fecha, autor)
 * - Indicador de progreso (barra superior + número de slide)
 *
 * Transición: GSAP clipPath horizontal (wipe cinematográfico)
 */

interface Post {
  title: string;
  subtitle?: string;
  image: string;
  link: string;
  collection: string;
  date?: string;
  author?: string;
  readTime?: string;
  id: string;
}

interface Props {
  posts: Post[];
  interval?: number; // ms entre slides. Default: 6000
}

const { posts, interval = 6000 } = Astro.props;

// Mínimo 3 slides para que el slider tenga sentido
const slides = posts.slice(0, 8);

const formatCollection = (col: string) =>
  col.replace('_', ' ').replace('-', ' ')
    .split(' ')
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
---

<section 
  id="immersive-slider"
  class="relative w-full overflow-hidden bg-black"
  style="height: 100dvh;"
  aria-label="Slider inmersivo de piezas"
>
  {/* ---- SLIDES ---- */}
  <div id="immersive-slides-container" class="relative w-full h-full">
    {slides.map((post, i) => (
      <article
        class={`immersive-slide absolute inset-0 w-full h-full ${i === 0 ? 'is-active' : ''}`}
        data-slide-index={i}
        aria-hidden={i !== 0}
      >
        {/* Background Image */}
        <div class="absolute inset-0 z-0">
          <img
            src={post.image}
            alt={post.title}
            class="w-full h-full object-cover brightness-[0.45]"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
          {/* Cinematic scrims */}
          <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/30 to-black/20"></div>
          <div class="absolute inset-0 bg-linear-to-r from-black/70 via-transparent to-transparent"></div>
        </div>

        {/* Content: centrado verticalmente, alineado a la izquierda */}
        <div class="absolute inset-0 z-10 flex flex-col justify-center px-10 md:px-20 lg:px-28 max-w-350">

          {/* Folio superior: número + colección */}
          <div class="immersive-content flex items-center gap-6 mb-10">
            <span class="font-tgp-tech text-[8px] tracking-[0.7em] uppercase text-copper-ember">
              {String(i + 1).padStart(2, '0')} / {String(slides.length).padStart(2, '0')}
            </span>
            <span class="w-8 h-px bg-white/20"></span>
            <span class="font-tgp-tech text-[8px] tracking-[0.5em] uppercase text-white/40">
              {formatCollection(post.collection)}
            </span>
          </div>

          {/* Título: display XL */}
          <h2 class="immersive-content font-tgp-gloock text-[11vw] md:text-[7vw] lg:text-[6.5vw] text-white leading-[0.88] tracking-[-0.03em] mb-8" style="max-width: 14ch;">
            {post.title}
          </h2>

          {/* Subtítulo */}
          {post.subtitle && (
            <p class="immersive-content font-tgp-body text-base md:text-xl text-white/45 font-light leading-relaxed mb-10 max-w-[45ch]">
              {post.subtitle}
            </p>
          )}

          {/* Metadatos: autor + fecha + tiempo de lectura + CTA */}
          <div class="immersive-content flex flex-wrap items-center gap-6 md:gap-8 pt-4 border-t border-white/10">
            {post.author && (
              <span class="font-tgp-tech text-[9px] tracking-[0.4em] uppercase text-copper-ember/80">
                {post.author}
              </span>
            )}
            {post.date && (
              <span class="font-tgp-tech text-[9px] tracking-[0.4em] uppercase text-white/30">
                {new Date(post.date).toLocaleDateString('es-AR', { year: 'numeric', month: 'long' })}
              </span>
            )}
            <span class="font-tgp-tech text-[9px] tracking-[0.4em] uppercase text-white/30">
              {post.readTime ?? '6 min lectura'}
            </span>
            <a
              href={post.link}
              class="ml-0 md:ml-auto inline-flex items-center gap-5 px-10 py-4 border border-white/20 text-white text-[8px] tracking-[0.5em] uppercase font-tgp-tech hover:bg-copper-ember hover:border-copper-ember hover:text-black transition-all duration-700 rounded-sm"
            >
              Leer Pieza
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        {/* Número de slide: decorativo, derecha */}
        <div class="absolute bottom-12 right-10 z-10 hidden md:block">
          <span class="font-tgp-gloock text-[12vw] text-white/5 leading-none select-none">
            {String(i + 1).padStart(2, '0')}
          </span>
        </div>
      </article>
    ))}
  </div>

  {/* ---- UI: Progress bar superior ---- */}
  <div class="absolute top-0 left-0 right-0 z-50 h-0.5 bg-white/10">
    <div 
      id="immersive-progress" 
      class="h-full bg-copper-ember origin-left"
      style="width: 0%; transform-origin: left;"
    ></div>
  </div>

  {/* ---- UI: Controles y dots ---- */}
  <div class="absolute bottom-10 left-10 md:left-20 z-50 flex items-center gap-5">
    {slides.map((_, i) => (
      <button
        class="immersive-dot relative h-0.5 bg-white/20 transition-all duration-500 rounded-full hover:bg-white/50"
        style={`width: ${i === 0 ? '2.5rem' : '0.75rem'};`}
        data-immersive-dot={i}
        aria-label={`Ir al slide ${i + 1}`}
      ></button>
    ))}
  </div>

  {/* ---- UI: Flechas prev/next ---- */}
  <div class="absolute bottom-8 right-10 z-50 flex items-center gap-3">
    <button 
      id="immersive-prev"
      class="w-10 h-10 border border-white/15 flex items-center justify-center text-white/50 hover:border-copper-ember hover:text-copper-ember transition-all duration-300"
      aria-label="Slide anterior"
    >
      <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
      </svg>
    </button>
    <button 
      id="immersive-next"
      class="w-10 h-10 border border-white/15 flex items-center justify-center text-white/50 hover:border-copper-ember hover:text-copper-ember transition-all duration-300"
      aria-label="Slide siguiente"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>

  {/* ---- UI: Sección label (top-left) ---- */}
  <div class="absolute top-8 left-10 md:left-20 z-50">
    <span class="font-tgp-tech text-[7px] tracking-[0.8em] uppercase text-white/20">
      — Archivo Inmersivo
    </span>
  </div>

</section>

{/* ================================================================
    GSAP: Transición clipPath + auto-slider
================================================================= */}
<script define:vars={{ interval }}>
  import { gsap } from 'gsap';

  const INTERVAL = interval;

  const initImmersiveSlider = () => {
    const slides   = document.querySelectorAll('.immersive-slide');
    const dots     = document.querySelectorAll('[data-immersive-dot]');
    const progress = document.getElementById('immersive-progress');
    const prevBtn  = document.getElementById('immersive-prev');
    const nextBtn  = document.getElementById('immersive-next');

    if (slides.length === 0) return;

    let current  = 0;
    let autoTimer = null;
    let isAnimating = false;

    // Estado inicial: todos los slides ocultos excepto el primero
    gsap.set(slides, { clipPath: 'inset(0 100% 0 0)', opacity: 0 });
    gsap.set(slides[0], { clipPath: 'inset(0 0% 0 0)', opacity: 1 });

    const updateDots = (index) => {
      dots.forEach((d, i) => {
        gsap.to(d, {
          width: i === index ? '2.5rem' : '0.75rem',
          backgroundColor: i === index ? '#B87333' : 'rgba(255,255,255,0.2)',
          duration: 0.4,
          ease: 'power2.out',
        });
      });
    };

    const startProgress = () => {
      if (!progress) return;
      gsap.killTweensOf(progress);
      gsap.fromTo(progress, 
        { width: '0%' },
        { width: '100%', duration: INTERVAL / 1000, ease: 'none' }
      );
    };

    const goToSlide = (next, direction = 1) => {
      if (isAnimating || next === current) return;
      isAnimating = true;

      const outSlide = slides[current];
      const inSlide  = slides[next];

      // Slide entrante: aparece desde el lado correspondiente
      gsap.set(inSlide, {
        clipPath: direction > 0 ? 'inset(0 0% 0 100%)' : 'inset(0 100% 0 0%)',
        opacity: 1,
        zIndex: 10,
      });
      gsap.set(outSlide, { zIndex: 5 });

      // Animar entrada
      gsap.to(inSlide, {
        clipPath: 'inset(0 0% 0 0%)',
        duration: 1.1,
        ease: 'expo.inOut',
        onComplete: () => {
          gsap.set(outSlide, { clipPath: 'inset(0 100% 0 0)', opacity: 0, zIndex: 0 });
          current = next;
          isAnimating = false;
        },
      });

      // Animación del contenido del slide entrante
      const contents = inSlide.querySelectorAll('.immersive-content');
      gsap.fromTo(contents,
        { y: 30, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.9, ease: 'expo.out', stagger: 0.08, delay: 0.3 }
      );

      updateDots(next);
      startProgress();
    };

    const nextSlide = () => {
      const n = (current + 1) % slides.length;
      goToSlide(n, 1);
    };

    const prevSlide = () => {
      const p = (current - 1 + slides.length) % slides.length;
      goToSlide(p, -1);
    };

    // Controles
    nextBtn?.addEventListener('click', () => {
      clearInterval(autoTimer);
      nextSlide();
      autoTimer = setInterval(nextSlide, INTERVAL);
      startProgress();
    });

    prevBtn?.addEventListener('click', () => {
      clearInterval(autoTimer);
      prevSlide();
      autoTimer = setInterval(nextSlide, INTERVAL);
      startProgress();
    });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        clearInterval(autoTimer);
        goToSlide(i, i > current ? 1 : -1);
        autoTimer = setInterval(nextSlide, INTERVAL);
        startProgress();
      });
    });

    // Auto-advance
    updateDots(0);
    startProgress();
    autoTimer = setInterval(nextSlide, INTERVAL);

    // Pausar en hover
    const section = document.getElementById('immersive-slider');
    section?.addEventListener('mouseenter', () => clearInterval(autoTimer));
    section?.addEventListener('mouseleave', () => {
      autoTimer = setInterval(nextSlide, INTERVAL);
    });
  };

  document.addEventListener('astro:page-load', initImmersiveSlider);
</script>

<style>
  .immersive-slide {
    will-change: clip-path, opacity;
  }
  .immersive-slide.is-active {
    z-index: 10;
  }
  [data-immersive-dot] {
    cursor: pointer;
    border-radius: 1px;
  }
</style>
