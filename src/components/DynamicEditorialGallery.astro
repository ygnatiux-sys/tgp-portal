---
import TgpImage from './TgpImage.astro';

/**
 * DynamicEditorialGallery.astro
 * Visor editorial cinematográfico tipo slider/marquee en formato grande (60vh).
 * Al hacer clic, se expande a pantalla completa duplicando la misma experiencia de slider
 * de manera pura y limpia, heredando el background local (--bg-current) y cerrando al cliquear afuera.
 */

interface GalleryItem {
  url: string;
  caption?: string;
  title?: string;
}

interface Props {
  images?: Array<string | GalleryItem>;
  spreads?: any[];
  title?: string;
  subtitle?: string;
  vibeClass?: string;
}

const {
  images = [],
  spreads = [],
  title = "",
  subtitle = "",
  vibeClass = ""
} = Astro.props;

// Normalizar imágenes sin generar metadatos artificiales
const normalizedImages: GalleryItem[] = [];

if (images && images.length > 0) {
  images.forEach(img => {
    if (typeof img === 'string') {
      normalizedImages.push({ url: img });
    } else if (img && typeof img === 'object' && img.url) {
      normalizedImages.push(img);
    }
  });
}

// Extraer imágenes desde spreads si están presentes
if (spreads && spreads.length > 0) {
  spreads.forEach(spread => {
    const val = spread.value;
    if (!val) return;

    if (val.images && Array.isArray(val.images)) {
      val.images.forEach((img: any) => {
        if (typeof img === 'string') normalizedImages.push({ url: img, caption: val.caption });
        else if (img && img.url) normalizedImages.push({ url: img.url, caption: img.caption || val.caption, title: img.title });
      });
    }

    if (val.local_images) {
      Object.values(val.local_images).forEach((img: any) => {
        if (typeof img === 'string' && img) normalizedImages.push({ url: img, caption: val.caption });
      });
    }

    if (val.remote_wikimedia_images) {
      Object.values(val.remote_wikimedia_images).forEach((img: any) => {
        if (img && img.url && (img.is_selected !== false)) {
          normalizedImages.push({
            url: img.url,
            title: img.semantic_match,
            caption: img.author_citation || val.caption
          });
        }
      });
    }

    if (val.google_photos_images) {
      Object.values(val.google_photos_images).forEach((img: any) => {
        if (img && img.photo_url_or_id && (img.is_selected !== false)) {
          normalizedImages.push({
            url: img.photo_url_or_id,
            title: img.caption,
            caption: val.caption
          });
        }
      });
    }
  });
}

if (normalizedImages.length === 0) return null;

const count = normalizedImages.length;
const galleryId = `gallery-${Math.random().toString(36).substring(2, 9)}`;
---

<div class={`dynamic-editorial-gallery my-14 ${vibeClass}`} id={galleryId}>
  {title && (
    <div class="mb-6 text-center">
      <h3 class="font-gloock text-2xl md:text-3xl text-old-silver uppercase tracking-wider">{title}</h3>
      {subtitle && <p class="text-xs font-tgp-tech uppercase tracking-[0.2em] text-old-silver/60 mt-1">{subtitle}</p>}
    </div>
  )}

  {/* ================================================================
      1. VISOR EDITORIAL INLINE (60vh)
  ================================================================= */}
  <div class="relative w-full max-w-5xl mx-auto group/gallery-slider">
    
    {/* Marco principal de la imagen */}
    <div 
      id={`${galleryId}-inline-container`}
      class="relative w-full h-[50vh] sm:h-[60vh] md:h-[65vh] overflow-hidden rounded-2xl md:rounded-3xl border border-white/10 shadow-2xl select-none cursor-pointer"
      style="background: var(--bg-card-fumee, rgba(255, 255, 255, 0.03));"
      title="Haga clic para ampliar la galería"
    >
      {normalizedImages.map((item, index) => (
        <div 
          class={`gallery-inline-slide absolute inset-0 w-full h-full transition-all duration-700 ease-out ${index === 0 ? 'opacity-100 z-10 is-active scale-100' : 'opacity-0 z-0 scale-98 pointer-events-none'}`}
          data-slide-index={index}
          aria-hidden={index !== 0}
        >
          <TgpImage 
            src={item.url} 
            alt={item.title || item.caption || `Imagen ${index + 1}`}
            width={1920}
            height={1080}
            format="webp"
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
            class="w-full h-full object-cover brightness-[0.88] contrast-[1.04] group-hover/gallery-slider:scale-[1.02] transition-transform duration-1000 ease-out"
          />

          {/* Scrim sutil inferior para contraste */}
          <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent pointer-events-none"></div>
        </div>
      ))}

      {/* Flechas de navegación lateral */}
      {count > 1 && (
        <>
          <div class="absolute inset-y-0 left-0 w-20 z-30 flex items-center justify-start pointer-events-none">
            <button 
              id={`${galleryId}-inline-prev`}
              class="pl-4 text-white/30 hover:text-copper-ember opacity-0 group-hover/gallery-slider:opacity-100 hover:scale-110 transition-all duration-300 cursor-pointer pointer-events-auto"
              aria-label="Foto anterior"
            >
              <svg class="w-7 h-7 drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
              </svg>
            </button>
          </div>
          <div class="absolute inset-y-0 right-0 w-20 z-30 flex items-center justify-end pointer-events-none">
            <button 
              id={`${galleryId}-inline-next`}
              class="pr-4 text-white/30 hover:text-copper-ember opacity-0 group-hover/gallery-slider:opacity-100 hover:scale-110 transition-all duration-300 cursor-pointer pointer-events-auto"
              aria-label="Foto siguiente"
            >
              <svg class="w-7 h-7 drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </button>
          </div>
        </>
      )}
    </div>

    {/* Barra de control inferior: Caption y Puntos (. . . .) */}
    <div class="mt-4 flex flex-col items-center gap-2.5">
      {/* Epígrafe dinámico de la foto activa */}
      <div 
        id={`${galleryId}-inline-caption`} 
        class="min-h-5 text-center font-tgp-tech text-[9px] md:text-[10px] tracking-[0.16em] uppercase text-old-silver transition-opacity duration-300 max-w-2xl px-4"
      >
        {normalizedImages[0]?.title || normalizedImages[0]?.caption || ''}
      </div>

      {/* Puntos de paginación (. . . .) */}
      {count > 1 && (
        <div class="flex items-center justify-center gap-2 py-1">
          {normalizedImages.map((_, idx) => (
            <button 
              class={`gallery-inline-dot transition-all duration-300 cursor-pointer rounded-full ${idx === 0 ? 'bg-copper-ember w-6 h-1.5' : 'bg-white/20 hover:bg-white/50 w-1.5 h-1.5'}`}
              data-dot-index={idx}
              aria-label={`Ver foto ${idx + 1}`}
            ></button>
          ))}
        </div>
      )}
    </div>
  </div>

  {/* ================================================================
      2. VISOR EXPANDIDO A PANTALLA COMPLETA (REPLICA LA GALERÍA AL DOBLE)
      Hereda el fondo del vibe (--bg-current). Cierra al cliquear afuera.
  ================================================================= */}
  <div 
    id={`${galleryId}-expanded-modal`}
    class="fixed inset-0 z-200 hidden backdrop-blur-3xl items-center justify-center p-4 sm:p-8 md:p-12 animate-fade-in opacity-0 transition-opacity duration-300"
    style="background-color: color-mix(in srgb, var(--bg-current, #0A1C15) 96%, black);"
    role="dialog"
    aria-modal="true"
    aria-label="Galería en pantalla completa"
  >
    {/* Contenedor central duplicado en gran escala */}
    <div 
      id={`${galleryId}-expanded-card`}
      class="relative w-full max-w-7xl flex flex-col items-center group/expanded-slider select-none"
    >
      {/* Marco de imagen expandido (~80vh) */}
      <div 
        id={`${galleryId}-expanded-frame`}
        class="relative w-full h-[65vh] sm:h-[75vh] md:h-[82vh] overflow-hidden rounded-3xl border border-white/15 bg-black/60 shadow-2xl"
      >
        {normalizedImages.map((item, index) => (
          <div 
            class={`gallery-expanded-slide absolute inset-0 w-full h-full transition-all duration-700 ease-out ${index === 0 ? 'opacity-100 z-10 is-active scale-100' : 'opacity-0 z-0 scale-98 pointer-events-none'}`}
            data-slide-index={index}
            aria-hidden={index !== 0}
          >
            <TgpImage 
              src={item.url} 
              alt={item.title || item.caption || `Foto ${index + 1}`}
              width={2560}
              height={1440}
              format="webp"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-contain"
            />
            {/* Scrim sutil inferior */}
            <div class="absolute inset-0 bg-linear-to-t from-black/70 via-transparent to-transparent pointer-events-none"></div>
          </div>
        ))}

        {/* Flechas de navegación en modo expandido */}
        {count > 1 && (
          <>
            <div class="absolute inset-y-0 left-0 w-24 z-30 flex items-center justify-start pointer-events-none">
              <button 
                id={`${galleryId}-expanded-prev`}
                class="pl-6 text-white/40 hover:text-copper-ember hover:scale-110 transition-all duration-300 cursor-pointer pointer-events-auto"
                aria-label="Foto anterior"
              >
                <svg class="w-8 h-8 md:w-10 md:h-10 drop-shadow-xl" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
              </button>
            </div>
            <div class="absolute inset-y-0 right-0 w-24 z-30 flex items-center justify-end pointer-events-none">
              <button 
                id={`${galleryId}-expanded-next`}
                class="pr-6 text-white/40 hover:text-copper-ember hover:scale-110 transition-all duration-300 cursor-pointer pointer-events-auto"
                aria-label="Foto siguiente"
              >
                <svg class="w-8 h-8 md:w-10 md:h-10 drop-shadow-xl" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </button>
            </div>
          </>
        )}
      </div>

      {/* Barra de control expandida: Caption + Puntos (. . . .) */}
      <div class="mt-4 flex flex-col items-center gap-3">
        {/* Caption en modo expandido */}
        <div 
          id={`${galleryId}-expanded-caption`} 
          class="min-h-5 text-center font-tgp-tech text-[10px] md:text-[11px] tracking-[0.18em] uppercase text-white/80 transition-opacity duration-300 max-w-3xl px-6"
        >
          {normalizedImages[0]?.title || normalizedImages[0]?.caption || ''}
        </div>

        {/* Puntos expandidos (. . . .) */}
        {count > 1 && (
          <div class="flex items-center justify-center gap-2.5 py-1">
            {normalizedImages.map((_, idx) => (
              <button 
                class={`gallery-expanded-dot transition-all duration-300 cursor-pointer rounded-full ${idx === 0 ? 'bg-copper-ember w-8 h-1.5' : 'bg-white/25 hover:bg-white/60 w-2 h-2'}`}
                data-dot-index={idx}
                aria-label={`Ver foto ${idx + 1}`}
              ></button>
            ))}
          </div>
        )}
      </div>

    </div>
  </div>

</div>

<script define:vars={{ galleryId, normalizedImages }}>
  const initGallery = () => {
    const galleryRoot = document.getElementById(galleryId);
    if (!galleryRoot) return;

    // ── Elementos del Visor Inline ──
    const inlineContainer = document.getElementById(`${galleryId}-inline-container`);
    const inlineSlides    = galleryRoot.querySelectorAll('.gallery-inline-slide');
    const inlineDots      = galleryRoot.querySelectorAll('.gallery-inline-dot');
    const inlineCaption   = document.getElementById(`${galleryId}-inline-caption`);
    const inlinePrev      = document.getElementById(`${galleryId}-inline-prev`);
    const inlineNext      = document.getElementById(`${galleryId}-inline-next`);

    // ── Elementos del Visor Expandido ──
    const expandedModal   = document.getElementById(`${galleryId}-expanded-modal`);
    const expandedCard    = document.getElementById(`${galleryId}-expanded-card`);
    const expandedFrame   = document.getElementById(`${galleryId}-expanded-frame`);
    const expandedSlides  = galleryRoot.querySelectorAll('.gallery-expanded-slide');
    const expandedDots    = galleryRoot.querySelectorAll('.gallery-expanded-dot');
    const expandedCaption = document.getElementById(`${galleryId}-expanded-caption`);
    const expandedPrev    = document.getElementById(`${galleryId}-expanded-prev`);
    const expandedNext    = document.getElementById(`${galleryId}-expanded-next`);

    if (inlineSlides.length === 0) return;

    let currentSlide = 0;

    // ── Sincronizador de Diapositivas y Puntos ──
    const updateSlideDisplay = (slideList, dotList, activeIdx, isExpanded = false) => {
      slideList.forEach((s, i) => {
        const isActive = i === activeIdx;
        s.classList.toggle('opacity-100', isActive);
        s.classList.toggle('opacity-0', !isActive);
        s.classList.toggle('z-10', isActive);
        s.classList.toggle('z-0', !isActive);
        s.classList.toggle('scale-100', isActive);
        s.classList.toggle('scale-98', !isActive);
        s.classList.toggle('pointer-events-none', !isActive);
        s.setAttribute('aria-hidden', String(!isActive));
      });

      dotList.forEach((d, i) => {
        const isActive = i === activeIdx;
        if (isActive) {
          d.className = isExpanded
            ? 'gallery-expanded-dot transition-all duration-300 cursor-pointer rounded-full bg-copper-ember w-8 h-1.5'
            : 'gallery-inline-dot transition-all duration-300 cursor-pointer rounded-full bg-copper-ember w-6 h-1.5';
        } else {
          d.className = isExpanded
            ? 'gallery-expanded-dot transition-all duration-300 cursor-pointer rounded-full bg-white/25 hover:bg-white/60 w-2 h-2'
            : 'gallery-inline-dot transition-all duration-300 cursor-pointer rounded-full bg-white/20 hover:bg-white/50 w-1.5 h-1.5';
        }
      });
    };

    const goToSlide = (idx) => {
      currentSlide = (idx + normalizedImages.length) % normalizedImages.length;
      const item = normalizedImages[currentSlide];

      // Actualizar vista inline
      updateSlideDisplay(inlineSlides, inlineDots, currentSlide, false);
      if (inlineCaption) {
        inlineCaption.style.opacity = '0';
        setTimeout(() => {
          inlineCaption.textContent = item?.title || item?.caption || '';
          inlineCaption.style.opacity = '1';
        }, 150);
      }

      // Actualizar vista expandida
      updateSlideDisplay(expandedSlides, expandedDots, currentSlide, true);
      if (expandedCaption) {
        expandedCaption.style.opacity = '0';
        setTimeout(() => {
          expandedCaption.textContent = item?.title || item?.caption || '';
          expandedCaption.style.opacity = '1';
        }, 150);
      }
    };

    const next = () => goToSlide(currentSlide + 1);
    const prev = () => goToSlide(currentSlide - 1);

    // ── Controles Inline ──
    inlineNext?.addEventListener('click', (e) => {
      e.stopPropagation();
      next();
    });
    inlinePrev?.addEventListener('click', (e) => {
      e.stopPropagation();
      prev();
    });
    inlineDots.forEach((dot, idx) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        goToSlide(idx);
      });
    });

    // ── Controles Expandidos ──
    expandedNext?.addEventListener('click', (e) => {
      e.stopPropagation();
      next();
    });
    expandedPrev?.addEventListener('click', (e) => {
      e.stopPropagation();
      prev();
    });
    expandedDots.forEach((dot, idx) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        goToSlide(idx);
      });
    });

    // ── Abrir y Cerrar Modo Expandido ──
    const openExpanded = (idx) => {
      if (!expandedModal) return;
      goToSlide(idx);
      expandedModal.classList.remove('hidden');
      expandedModal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        expandedModal.classList.remove('opacity-0');
        expandedModal.classList.add('opacity-100');
      }, 10);
    };

    const closeExpanded = () => {
      if (!expandedModal) return;
      expandedModal.classList.remove('opacity-100');
      expandedModal.classList.add('opacity-0');
      document.body.style.overflow = '';
      setTimeout(() => {
        expandedModal.classList.add('hidden');
        expandedModal.classList.remove('flex');
      }, 300);
    };

    // Al cliquear afuera (en el backdrop del modal), cerrar
    expandedModal?.addEventListener('click', (e) => {
      if (e.target === expandedModal) {
        closeExpanded();
      }
    });

    // ── Drag & Swipe en Visor Inline ──
    let inlineStartX = 0;
    let isInlineDragging = false;

    inlineContainer?.addEventListener('mousedown', (e) => {
      if (e.target.closest('button')) return;
      inlineStartX = e.clientX;
      isInlineDragging = true;
    });

    inlineContainer?.addEventListener('mouseup', (e) => {
      if (!isInlineDragging) return;
      isInlineDragging = false;
      const diffX = e.clientX - inlineStartX;
      if (Math.abs(diffX) > 40) {
        if (diffX < 0) next();
        else prev();
      } else {
        // Clic sin arrastre abre el modo expandido
        openExpanded(currentSlide);
      }
    });

    // Touch Swipe Inline
    let touchStartX = 0;
    inlineContainer?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].clientX;
    }, { passive: true });

    inlineContainer?.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].clientX;
      const diffX = touchEndX - touchStartX;
      if (Math.abs(diffX) > 40) {
        if (diffX < 0) next();
        else prev();
      }
    }, { passive: true });

    // ── Drag & Swipe en Visor Expandido ──
    let expStartX = 0;
    let isExpDragging = false;

    expandedFrame?.addEventListener('mousedown', (e) => {
      if (e.target.closest('button')) return;
      expStartX = e.clientX;
      isExpDragging = true;
    });

    expandedFrame?.addEventListener('mouseup', (e) => {
      if (!isExpDragging) return;
      isExpDragging = false;
      const diffX = e.clientX - expStartX;
      if (Math.abs(diffX) > 40) {
        if (diffX < 0) next();
        else prev();
      }
    });

    // Touch Swipe Expandido
    let expTouchStartX = 0;
    expandedFrame?.addEventListener('touchstart', (e) => {
      expTouchStartX = e.changedTouches[0].clientX;
    }, { passive: true });

    expandedFrame?.addEventListener('touchend', (e) => {
      const expTouchEndX = e.changedTouches[0].clientX;
      const diffX = expTouchEndX - expTouchStartX;
      if (Math.abs(diffX) > 40) {
        if (diffX < 0) next();
        else prev();
      }
    }, { passive: true });

    // ── Navegación con Teclado (ESC cierra, flechas cambian foto) ──
    const handleKeydown = (e) => {
      if (expandedModal?.classList.contains('hidden')) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeExpanded();
      } else if (e.key === 'ArrowLeft') {
        prev();
      } else if (e.key === 'ArrowRight') {
        next();
      }
    };

    window.addEventListener('keydown', handleKeydown);
  };

  document.addEventListener('astro:page-load', initGallery);
  initGallery();
</script>
