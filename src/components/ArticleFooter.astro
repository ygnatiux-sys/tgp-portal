<script>
  const initArticleShare = () => {
    const btn  = document.getElementById('article-share-btn');
    const menu = document.getElementById('article-share-menu');
    if (!btn || !menu) return;

    let open = false;

    const close = () => {
      open = false;
      btn.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
      menu.classList.add('opacity-0', 'pointer-events-none', 'scale-90');
      menu.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
    };

    const openMenu = () => {
      open = true;
      btn.setAttribute('aria-expanded', 'true');
      menu.setAttribute('aria-hidden', 'false');
      menu.classList.remove('opacity-0', 'pointer-events-none', 'scale-90');
      menu.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
    };

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      open ? close() : openMenu();
    });

    document.addEventListener('click', (e) => {
      const wrapper = document.getElementById('article-share-wrapper');
      if (open && wrapper && !wrapper.contains(e.target as Node)) {
        close();
      }
    });
  };

  document.addEventListener('astro:page-load', initArticleShare);
</script>
