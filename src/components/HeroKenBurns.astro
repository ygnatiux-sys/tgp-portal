---
import TgpImage from './TgpImage.astro';

interface Props {
  title: string;
  subtitle?: string;
  imageUrl?: string;
  vibeClass?: string;
}
const {
  title,
  subtitle = "Vintage Archives",
  imageUrl = "",
  vibeClass = "",
} = Astro.props;
---

<section
  class={`vintage-hero relative w-[calc(100%-2rem)] h-[calc(85vh-2rem)] min-h-150 mx-auto mt-4 flex flex-col items-center justify-center overflow-hidden rounded-3xl ${vibeClass}`}
  style="background-color: var(--bg-current);"
>
  <div
    class="hero-bg absolute inset-0 z-0 ken-burns-container"
    style="box-shadow: inset 0 0 100px rgba(0,0,0,0.5);"
  >
    <div class="cine-wrapper">
      <TgpImage
        src={imageUrl}
        alt={title}
        width={1920}
        height={1080}
        format="webp"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
        class="ken-burns-img w-full h-full object-cover sepia-[0.15]"
        style="transform-origin: center center;"
      />
    </div>

    <div class="texture-grain"></div>
    <div class="texture-scratches"></div>
    <div class="atmospheric-dust"></div>

    <div
      class="absolute inset-0 z-10"
      style="background-image: linear-gradient(to top, var(--bg-current) 0%, color-mix(in srgb, var(--bg-current) 50%, transparent) 50%, transparent 100%);"
    >
    </div>
    <div class="absolute inset-0 z-10 bg-black/20"></div>
  </div>


  <div
    class="title-container relative z-20 text-center px-6 w-full max-w-5xl mx-auto py-6 md:py-8 flex flex-col items-center -translate-y-4"
  >
    <h1
      class="vibe-target-h1 hero-interactive-h1 font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl tracking-tight leading-[0.95] pb-1 drop-shadow-2xl text-balance mx-auto max-w-[22ch] inline-block"
    >
      {title}
    </h1>
    {subtitle && (
      <p
        class="vibe-target-h2 font-sans text-xs md:text-sm tracking-[0.15em] text-[#f4f0ec]/90 my-2 border-b border-[#f4f0ec]/30 pb-1 inline-block drop-shadow-md text-balance max-w-2xl mx-auto"
      >
        {subtitle}
      </p>
    )}
    <h3
      class={`vibe-target-folio font-tgp-tech text-[#f4f0ec]/50 text-[9px] md:text-[10px] tracking-[0.25em] uppercase mt-2 ${vibeClass === "vibe-travel-senses" ? "vibe-vertical" : ""}`}
    >
      TGP Editorial // {vibeClass.replace("vibe-", "").replace(/-/g, " ")}
    </h3>
  </div>

  {/* Spotify & YouTube Discrete Links at the Hero Base */}
  <div class="absolute bottom-5 sm:bottom-6 left-1/2 -translate-x-1/2 z-20 flex items-center gap-5 justify-center pointer-events-auto">
    <a
      href="https://open.spotify.com/show/3zFq9ab980MamMHW48Sqxy"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 text-[9px] tracking-[0.22em] uppercase font-tgp-tech text-old-silver hover:text-[#E3DDD3] transition-colors duration-300 group"
    >
      <span class="flex items-center justify-center w-6 h-6 rounded-full border border-old-silver/20 bg-white/4 group-hover:border-[#E3DDD3]/50 group-hover:bg-white/8 transition-all duration-300">
        <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.59 14.42c-.18.27-.53.37-.8.19-2.25-1.38-5.08-1.69-8.41-.93-.31.07-.62-.13-.69-.44-.07-.31.13-.62.44-.69 3.65-.83 6.78-.47 9.29 1.07.28.17.37.52.17.8zm1.22-2.72c-.22.36-.69.48-1.05.25-2.58-1.59-6.52-2.05-9.57-1.12-.4.12-.83-.11-.95-.51-.12-.4.11-.83.51-.95 3.5-.1 7.84.41 10.82 2.25.36.22.48.69.24 1.08zm.11-2.86C14.77 8.9 9.53 8.7 6.49 9.62c-.46.14-.94-.12-1.08-.58-.14-.46.12-.94.58-1.08 3.51-1.06 9.3-.84 13.06 1.39.42.25.56.8.31 1.22-.25.42-.8.56-1.22.31z"/>
        </svg>
      </span>
      <span>Spotify</span>
    </a>
    <a
      href="https://www.youtube.com/@thegreatpuzzleproject"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 text-[9px] tracking-[0.22em] uppercase font-tgp-tech text-old-silver hover:text-[#E3DDD3] transition-colors duration-300 group"
    >
      <span class="flex items-center justify-center w-6 h-6 rounded-full border border-old-silver/20 bg-white/4 group-hover:border-[#E3DDD3]/50 group-hover:bg-white/8 transition-all duration-300">
        <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
          <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.507a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.507 9.388.507 9.388.507s7.518 0 9.388-.507a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
      </span>
      <span>YouTube</span>
    </a>
  </div>
</section>

<style>
  .ken-burns-container {
    overflow: hidden;
  }

  /* Ken Burns en la imagen */
  .ken-burns-img {
    animation: kenburns 40s ease-in-out infinite alternate;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes kenburns {
    0% {
      transform: scale(1) translate(0, 0);
    }
    100% {
      transform: scale(1.12) translate(-1.5%, -0.8%);
    }
  }

  /* Cinemagraph en el wrapper — capa por encima del Ken Burns */
  @keyframes cine-drift {
    0% {
      transform: scale(1.06) translate(0%, 0%);
    }
    25% {
      transform: scale(1.09) translate(-0.4%, 0.3%);
    }
    50% {
      transform: scale(1.07) translate(-0.8%, -0.2%);
    }
    75% {
      transform: scale(1.09) translate(-0.3%, 0.35%);
    }
    100% {
      transform: scale(1.06) translate(0%, 0%);
    }
  }

  .cine-wrapper {
    animation: cine-drift 38s ease-in-out infinite;
    will-change: transform;
    width: 100%;
    height: 110%;
    position: absolute;
    top: -5%;
    left: 0;
  }

  .vintage-hero:hover .cine-wrapper {
    animation-duration: 19s;
  }

  .vintage-hero:hover .ken-burns-img {
    /* Suavizado de luz en el hover (antes brightness: 0.65) */
    filter: sepia(0.15) brightness(0.85);
    transition: filter 1.8s ease;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initHero = () => {
    const heroSection = document.querySelector(".vintage-hero");
    const heroBg = document.querySelector(".vintage-hero .hero-bg");
    const titleContainer = document.querySelector(
      ".vintage-hero .title-container"
    );
    const img = document.querySelector(".vintage-hero .ken-burns-img");

    if (heroSection && heroBg) {
      // 1. ELEGANT BG PARALLAX DRIFT
      gsap.to(heroBg, {
        scrollTrigger: {
          trigger: heroSection,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
        y: 100,
        ease: "none",
      });

      // 2. SMOOTH FADE OUT TO BLACK ON SCROLL
      if (img) {
        gsap.to(img, {
          scrollTrigger: {
            trigger: heroSection,
            start: "top top",
            end: "bottom top",
            scrub: true,
          },
          scale: 0.80,
          opacity: 0,
          ease: "power2.inOut",
        });
      }

      // 3. FLUID TITLE FADE OUT (IN-PLACE SOFT GRADUAL FADE)
      if (titleContainer) {
        gsap.to(titleContainer, {
          scrollTrigger: {
            trigger: heroSection,
            start: "top top",
            end: "70% top",
            scrub: 1.2,
          },
          y: 35,
          scale: 0.94,
          opacity: 0,
          ease: "power2.out",
        });
      }
    }
  };

  document.addEventListener("astro:page-load", initHero);
</script>
