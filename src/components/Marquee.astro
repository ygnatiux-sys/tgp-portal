---
import { getCollection } from 'astro:content';

let essaysRaw: any[] = [];
let architecturesRaw: any[] = [];
let visualSignalsRaw: any[] = [];
let ensayosRaw: any[] = [];
let capsulasRaw: any[] = [];

try { essaysRaw = await getCollection('essays'); } catch {}
try { architecturesRaw = await getCollection('architectures'); } catch {}
try { visualSignalsRaw = await getCollection('visual_signals'); } catch {}
try { ensayosRaw = await getCollection('ensayos'); } catch {}
try { capsulasRaw = await getCollection('capsulas'); } catch {}

const normalize = (post: any, col: string) => ({
  id: post.id,
  title: post.data.title ?? 'Sin título',
  subtitle: post.data.subtitle ?? post.data.description ?? undefined,
  image: post.data.hero_image ?? post.data.coverImage ?? 'https://images.unsplash.com/photo-1478720568477-152d9b164e26?q=80&w=1200',
  link: `/${col.replace('_', '-')}/${post.id}`,
  collection: col,
  date: post.data.date ? String(post.data.date) : undefined,
});

const sortByLatest = (a: any, b: any) => {
  const dateA = a.data?.date ? new Date(String(a.data.date)).getTime() : (a.date ? new Date(String(a.date)).getTime() : Date.now());
  const dateB = b.data?.date ? new Date(String(b.data.date)).getTime() : (b.date ? new Date(String(b.date)).getTime() : Date.now());
  return dateB - dateA || b.id.localeCompare(a.id);
};

const allPosts = [
  ...ensayosRaw.map(p => normalize(p, 'ensayos')),
  ...essaysRaw.map(p => normalize(p, 'essays')),
  ...architecturesRaw.map(p => normalize(p, 'architectures')),
  ...visualSignalsRaw.map(p => normalize(p, 'visual_signals')),
  ...capsulasRaw.map(p => normalize(p, 'capsulas'))
].sort(sortByLatest).slice(0, 10); // Top 10 novedades

const formatCollection = (col: string) => {
  const c = col.toLowerCase();
  if (c === 'essays') return 'Dossiers';
  if (c === 'architectures') return 'Magazines';
  if (c === 'visual_signals' || c === 'visual-signals') return 'Collections';
  if (c === 'capsulas') return 'eBooks';
  return col.replace('_', ' ').replace('-', ' ')
    .split(' ')
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
};

const title = "Novedades en TGP";
---

<section class="marquee-portal-wrapper py-12 border-t border-white/5 bg-(--bg-current,transparent) overflow-hidden">
  <div class="px-6 mb-8 max-w-[1600px] mx-auto">
    <span class="font-tgp-tech text-[8px] tracking-[0.6em] uppercase text-copper-ember">
      ——— {title}
    </span>
  </div>

  <div class="marquee-portal-container relative w-full flex" aria-label="Artículos recientes">
    <div class="marquee-portal-track flex shrink-0 gap-6 px-3">
      {allPosts.map((post) => (
        <a
          href={post.link}
          class="marquee-card group flex flex-col w-65 shrink-0 border border-white/5 rounded-3xl hover:border-white/15 p-4 transition-all duration-500"
          aria-label={`Leer: ${post.title}`}
        >
          <div class="marquee-thumbnail w-full aspect-16/10 overflow-hidden rounded-2xl bg-charcoal-wood relative mb-4">
            <img
              src={post.image}
              alt={post.title}
              loading="lazy"
              decoding="async"
              class="center-focus-target w-full h-full object-cover grayscale brightness-50 opacity-50 group-hover:grayscale-0 group-hover:brightness-90 group-hover:opacity-100 transition-all duration-1200 ease-in-out"
            />
          </div>
          <div class="flex flex-col min-w-0">
            <span class="font-tgp-tech text-xs tracking-[0.3em] uppercase text-copper-ember/70 mb-2">
              {formatCollection(post.collection)}
            </span>
            <h3 class="font-tgp-gloock text-xl text-white leading-snug group-hover:text-copper-ember transition-colors duration-500 line-clamp-2">
              {post.title}
            </h3>
            {post.subtitle && (
              <div class="mt-4 border-l border-white/10 pl-3">
                <p class="font-tgp-body text-xs text-white/40 font-light leading-relaxed line-clamp-2">
                  {post.subtitle}
                </p>
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
    {/* Copia exacta para el efecto de scroll infinito */}
    <div class="marquee-portal-track flex shrink-0 gap-6 px-3" aria-hidden="true">
      {allPosts.map((post) => (
        <a
          href={post.link}
          class="marquee-card group flex flex-col w-65 shrink-0 border border-white/5 rounded-3xl hover:border-white/15 p-4 transition-all duration-500"
          tabindex="-1"
        >
          <div class="marquee-thumbnail w-full aspect-16/10 overflow-hidden rounded-2xl bg-charcoal-wood relative mb-4">
            <img
              src={post.image}
              alt={post.title}
              loading="lazy"
              decoding="async"
              class="center-focus-target w-full h-full object-cover grayscale brightness-50 opacity-50 group-hover:grayscale-0 group-hover:brightness-90 group-hover:opacity-100 transition-all duration-1200 ease-in-out"
            />
          </div>
          <div class="flex flex-col min-w-0">
            <span class="font-tgp-tech text-xs tracking-[0.3em] uppercase text-copper-ember/70 mb-2">
              {formatCollection(post.collection)}
            </span>
            <h3 class="font-tgp-gloock text-xl text-white leading-snug group-hover:text-copper-ember transition-colors duration-500 line-clamp-2">
              {post.title}
            </h3>
            {post.subtitle && (
              <div class="mt-4 border-l border-white/10 pl-3">
                <p class="font-tgp-body text-xs text-white/40 font-light leading-relaxed line-clamp-2">
                  {post.subtitle}
                </p>
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee-portal-wrapper {
    position: relative;
    width: 100%;
  }

  .marquee-portal-container {
    --marquee-speed: 140s; /* Modo súper softly y pausado */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
  }

  .marquee-portal-track {
    animation: scroll-marquee var(--marquee-speed) linear infinite;
  }

  .marquee-portal-container:hover .marquee-portal-track {
    animation-play-state: paused;
  }

  @keyframes scroll-marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }
  
  .marquee-card {
    text-decoration: none;
  }
</style>

<script>
  const initMarqueeFocus = () => {
    const cards = document.querySelectorAll('.marquee-card');
    if (!cards.length) return;

    // IntersectionObserver para detectar el centro de la pantalla
    // El rootMargin de -35% a la izquierda y derecha crea una ventana del 30% en el centro
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const img = entry.target.querySelector('.center-focus-target');
        if (!img) return;
        
        if (entry.isIntersecting) {
          // Entra al centro: libera gris, toma color y opacidad 100%
          img.classList.remove('grayscale', 'brightness-50', 'opacity-50');
          img.classList.add('grayscale-0', 'brightness-90', 'opacity-100');
        } else {
          // Sale del centro: gris y baja opacidad
          img.classList.add('grayscale', 'brightness-50', 'opacity-50');
          img.classList.remove('grayscale-0', 'brightness-90', 'opacity-100');
        }
      });
    }, {
      root: null,
      rootMargin: "0px -35% 0px -35%",
      threshold: 0
    });

    cards.forEach(card => observer.observe(card));
  };

  document.addEventListener('astro:page-load', initMarqueeFocus);
</script>
