---
/**
 * LayoutPortal.astro
 * Layout optimizado para la homepage de gran densidad editorial.
 * Derivado de Layout.astro — mantiene navbar glassmorphism + GSAP lifecycle.
 * Sin la sección de intro de marca (esa lógica vive en portal.astro).
 */
import '../styles/global.css';

// @fontsource — mismas fuentes que Layout.astro base
import '@fontsource/gloock/400.css';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/bodoni-moda/400.css';
import '@fontsource/bodoni-moda/600.css';
import '@fontsource/fraunces/900.css';
import '@fontsource/fraunces/700.css';
import '@fontsource/syne/800.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/400.css';
import '@fontsource/dm-serif-display/400.css';
import '@fontsource/dm-serif-display/400-italic.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/600.css';
import '@fontsource/inter/100.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/500.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/outfit/100.css';
import '@fontsource/outfit/300.css';
import '@fontsource/outfit/500.css';
import '@fontsource/space-grotesk/300.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/epilogue/100.css';
import '@fontsource/epilogue/600.css';
import '@fontsource/epilogue/900.css';
import '@fontsource/manrope/800.css';
import '@fontsource/ibm-plex-mono/300.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/plus-jakarta-sans/200.css';
import '@fontsource/plus-jakarta-sans/300.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';

import { ClientRouter } from 'astro:transitions';
import EditorialFooter from '../components/EditorialFooter.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { 
  title, 
  description = "The Great Puzzle — Editorial Platform",
  ogImage = "/og-default.jpg"
} = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-racing-green text-white antialiased selection:bg-copper-ember selection:text-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/jpeg" href="/faviconTGP.jpeg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>

  <body class="min-h-screen relative overflow-x-hidden bg-racing-green">

    {/* ================================================================
        NAVBAR: Fixed, Floating, Collapsible Glassmorphic Pill
    ================================================================= */}
    <header 
      id="portal-glass-bridge" 
      class="fixed top-4 left-1/2 -translate-x-1/2 z-100 max-w-[1600px] w-[calc(100%-2rem)] px-2 transition-all duration-500" 
      transition:persist
    >
      <nav 
        id="main-nav-bar"
        class="group/nav relative flex items-center justify-between px-6 py-3 transition-all duration-500 ease-out"
      >
        {/* Logo + Brand */}
        <div class="brand-container flex items-center gap-3 shrink-0 transition-opacity duration-500">
          <a href="/" class="brand-logo w-8 h-8 flex items-center justify-center hover:opacity-80 transition-opacity overflow-hidden rounded-full border border-white/20 p-0.5">
            <img src="/faviconTGP.jpeg" alt="TGP Logo" class="w-full h-full object-cover rounded-full" />
          </a>
          <div class="brand-text hidden sm:flex items-baseline gap-2 transition-all duration-500 whitespace-nowrap">
            <span class="font-tgp-gloock font-black text-xs tracking-[0.02em] uppercase text-white/90">
              The Great Puzzle
            </span>
            <span class="font-tgp-tech text-[6px] tracking-widest text-old-silver uppercase">
              -project-
            </span>
          </div>
        </div>

        {/* Navigation Links */}
        <div class="nav-links flex items-center gap-6 md:gap-8 font-tgp-tech text-[9px] tracking-[0.3em] uppercase font-medium text-white/80 transition-all duration-500">
          <a href="/ensayos" class="hover:text-copper-ember transition-all duration-300">Ensayos</a>
          <a href="/essays" class="hover:text-copper-ember transition-all duration-300">Essays</a>
          <a href="/architectures" class="hover:text-copper-ember transition-all duration-300">Architectures</a>
          <a href="/visual-signals" class="hover:text-copper-ember transition-all duration-300">Signals</a>
          <a href="/capsulas" class="hover:text-copper-ember transition-all duration-300">Cápsulas</a>
        </div>

        {/* Hamburger Icon Trigger */}
        <button 
          id="nav-toggle-btn"
          class="hamburger-btn flex items-center gap-2 text-[9px] font-tgp-tech uppercase tracking-widest text-white/80 hover:text-copper-ember transition-all cursor-pointer overflow-hidden whitespace-nowrap"
          aria-label="Toggle Menu"
        >
          <span class="hamburger-label hidden sm:inline">Menu</span>
          <svg class="w-4 h-4 fill-none stroke-current shrink-0" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </nav>
    </header>

    {/* Global ambient radial gradient */}
    <div class="fixed inset-0 pointer-events-none -z-10 bg-[radial-gradient(ellipse_80%_50%_at_50%_-10%,rgba(10,28,21,0.95),rgba(5,10,8,1))]"></div>

    {/* Page Content */}
    <slot />

    <EditorialFooter />



    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const setupNavScroll = () => {
        const header = document.getElementById('portal-glass-bridge') || document.getElementById('glass-bridge');
        const toggleBtn = document.getElementById('nav-toggle-btn');
        if (!header) return;

        const handleScroll = () => {
          if (window.scrollY > 60) {
            header.classList.add('nav-collapsed');
          } else {
            header.classList.remove('nav-collapsed', 'is-open');
          }
        };

        window.addEventListener('scroll', handleScroll, { passive: true });
        handleScroll();

        toggleBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          header.classList.toggle('is-open');
        });

        document.addEventListener('click', (e) => {
          if (!header.contains(e.target as Node)) {
            header.classList.remove('is-open');
          }
        });
      };

      document.addEventListener('astro:page-load', setupNavScroll);
      setupNavScroll();

      // Lifecycle Protocol: Garbage Collection before page swap
      document.addEventListener('astro:before-swap', () => {
        ScrollTrigger.getAll().forEach(t => t.kill());
      });
    </script>

  </body>
</html>
