---
import '../styles/global.css';

// @fontsource — Local font imports (replaces Google Fonts)
import '@fontsource/gloock/400.css';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/bodoni-moda/400.css';
import '@fontsource/bodoni-moda/600.css';
import '@fontsource/fraunces/900.css';
import '@fontsource/fraunces/700.css';
import '@fontsource/syne/800.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/400.css';
import '@fontsource/dm-serif-display/400.css';
import '@fontsource/dm-serif-display/400-italic.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/600.css';
import '@fontsource/inter/100.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/500.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/outfit/100.css';
import '@fontsource/outfit/300.css';
import '@fontsource/outfit/500.css';
import '@fontsource/space-grotesk/300.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/epilogue/100.css';
import '@fontsource/epilogue/600.css';
import '@fontsource/epilogue/900.css';
import '@fontsource/manrope/800.css';
import '@fontsource/ibm-plex-mono/300.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/plus-jakarta-sans/200.css';
import '@fontsource/plus-jakarta-sans/300.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';

import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	vibeClass?: string;
}

const { title, vibeClass = '' } = Astro.props;

// Map vibeClass to data-theme attribute for Tailwind CSS variable consumption
const dataTheme = vibeClass || 'default';
---

<!doctype html>
<html lang="es" data-theme={dataTheme} class={`antialiased ${vibeClass}`} style="background-color: var(--bg-current);">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="The Great Puzzle — Editorial Platform" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/jpeg" href="/faviconTGP.jpeg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body data-theme={dataTheme} class={`min-h-screen relative overflow-x-hidden ${vibeClass}`} style="background-color: var(--bg-current); color: var(--text-current);">
		
		{/* NAVBAR: Fixed, Floating, Collapsible Glassmorphic Pill */}
		<header 
			id="glass-bridge" 
			class="fixed top-1.5 left-1/2 -translate-x-1/2 z-100 max-w-[1600px] w-[calc(100%-2rem)] px-2 transition-all duration-500" 
			transition:persist
		>
			<nav 
				id="main-nav-bar"
				class="tgp-nav group/nav relative flex items-center justify-between px-6 py-3 transition-all duration-500 ease-out"
			>
				{/* Logo + Brand */}
				<a href="/" id="nav-brand-zone" class="brand-container group/header-brand flex items-center gap-3 shrink-0 transition-all duration-500 cursor-pointer select-none no-underline">
					<div class="brand-logo w-8 h-8 flex items-center justify-center group-hover/header-brand:opacity-80 transition-all overflow-hidden rounded-full border border-white/20 group-hover/header-brand:border-[#E3DDD3]/50 p-0.5">
						<img src="/faviconTGP.jpeg" alt="TGP Logo" class="w-full h-full object-cover rounded-full" />
					</div>
					<div class="brand-text hidden sm:flex items-baseline gap-2 transition-all duration-500 whitespace-nowrap">
						<span class="font-tgp-gloock font-black text-xs tracking-[0.02em] uppercase text-old-silver group-hover/header-brand:text-[#E3DDD3] transition-colors duration-300">
							The Great Puzzle
						</span>
						<span class="font-tgp-tech text-[6px] tracking-widest text-old-silver/80 group-hover/header-brand:text-[#E3DDD3]/80 uppercase transition-colors duration-300">
							-project-
						</span>
					</div>
				</a>
				
				{/* Navigation Links (Centered in Middle Grid, Soft Tracking & Tighter Gap) */}
				<div id="nav-links-zone" class="nav-links flex items-center justify-center gap-2.5 sm:gap-3.5 lg:gap-5 font-tgp-tech text-[9px] tracking-[0.13em] lg:tracking-[0.16em] uppercase font-medium text-white/60 transition-all duration-500">
					<a href="/ensayos" class="hover:text-copper-ember transition-all duration-300">Ensayos</a>
					<a href="/essays" class="hover:text-copper-ember transition-all duration-300">Dossiers</a>
					<a href="/architectures" class="hover:text-copper-ember transition-all duration-300">Magazines</a>
					<a href="/visual-signals" class="hover:text-copper-ember transition-all duration-300">Collections</a>
					<a href="/capsulas" class="hover:text-copper-ember transition-all duration-300">eBooks</a>
					<a href="https://thegreatpuzzleproject.com" target="_self" class="hover:text-copper-ember transition-all duration-300">Ir a TGP</a>
				</div>

				{/* Action Controls (Right Aligned: Search Input Line + Search Trigger + Hamburger Menu) */}
				<div class="flex items-center gap-3 shrink-0 ml-auto">
					{/* Search Inline Wrapper (Right-aligned, compact 2-3 words width: w-[165px]) */}
					<div 
						id="search-input-zone" 
						class="hidden items-center gap-2 border-b border-white/10 focus-within:border-copper-ember/60 py-0.5 w-41.25 transition-all duration-300 group/search animate-fade-in"
					>
						<svg class="w-3.5 h-3.5 text-white/30 group-focus-within/search:text-copper-ember transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
						</svg>
						<input 
							type="text" 
							id="search-query" 
							placeholder="BUSCAR PIEZAS" 
							autocomplete="off"
							spellcheck="false"
							class="w-full bg-transparent outline-none border-none text-white/40 focus:text-white text-[9px] tracking-[0.2em] font-tgp-tech uppercase placeholder-white/20 transition-colors"
						/>
						<button id="search-clear-btn" class="text-white/30 hover:text-copper-ember transition-colors cursor-pointer hidden" aria-label="Clear search">
							<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
							</svg>
						</button>
					</div>

					<button 
						id="search-trigger-btn"
						class="search-btn flex items-center justify-center p-1 text-white/60 hover:text-copper-ember transition-all cursor-pointer"
						aria-label="Buscar posts"
					>
						<svg class="w-4 h-4 fill-none stroke-current shrink-0" viewBox="0 0 24 24" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
						</svg>
					</button>

					<button 
						id="nav-toggle-btn-base"
						class="hamburger-btn flex items-center gap-2 text-[9px] font-tgp-tech uppercase tracking-widest text-white/60 hover:text-copper-ember transition-all cursor-pointer overflow-hidden whitespace-nowrap"
						aria-label="Toggle Menu"
					>
						<span class="hamburger-label hidden sm:inline">Menu</span>
						<svg class="w-4 h-4 fill-none stroke-current shrink-0" viewBox="0 0 24 24" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
						</svg>
					</button>
				</div>

				{/* Dropdown panel for search results (Printed into main bg grid, low default opacity) */}
				<div 
					id="search-results-panel" 
					class="absolute top-[calc(100%+0.5rem)] right-6 md:right-8 left-auto w-60 bg-transparent py-2 hidden flex-col gap-2 max-h-80 overflow-y-auto scrollbar-thin transition-all duration-300 z-50 animate-fade-in"
				>
					<div class="text-[7px] tracking-[0.3em] uppercase text-white/20 font-tgp-tech pb-1.5 border-b border-white/5 text-right">Resultados</div>
					<div id="search-results-list" class="flex flex-col text-right"></div>
					<div id="search-no-results" class="text-[9px] tracking-[0.2em] uppercase text-white/20 font-tgp-tech text-right py-3 hidden">No se encontraron piezas.</div>
				</div>
			</nav>
		</header>

		<!-- Global texture/ambient background -->
		<div class="fixed inset-0 pointer-events-none -z-10 bg-[radial-gradient(ellipse_at_top,var(--tw-gradient-stops))] from-emerald-950/40 via-racing-green to-racing-green"></div>
		
		<slot />

		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			const setupBaseNavScroll = () => {
				const header = document.getElementById('glass-bridge');
				const toggleBtn = document.getElementById('nav-toggle-btn-base');
				if (!header) return;

				const handleScroll = () => {
					if (window.scrollY > 60) {
						header.classList.add('nav-collapsed');
						document.body.classList.add('is-scrolled');
					} else {
						header.classList.remove('nav-collapsed');
						document.body.classList.remove('is-scrolled');
					}
				};

				window.removeEventListener('scroll', handleScroll);
				window.addEventListener('scroll', handleScroll, { passive: true });
				handleScroll();

				toggleBtn?.replaceWith(toggleBtn.cloneNode(true));
				const newToggleBtn = document.getElementById('nav-toggle-btn-base');
				newToggleBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					header.classList.toggle('is-toggled');
					header.classList.toggle('is-open');
				});

				const clickOutsideHandler = (e: MouseEvent) => {
					if (!header.contains(e.target as Node)) {
						header.classList.remove('is-toggled', 'is-open');
					}
				};
				document.removeEventListener('click', clickOutsideHandler);
				document.addEventListener('click', clickOutsideHandler);
			};

			// Search engine logic
			let searchData: any[] = [];
			let searchLoaded = false;

			const initSearch = () => {
				const header = document.getElementById('portal-glass-bridge') || document.getElementById('glass-bridge');
				const triggerBtn = document.getElementById('search-trigger-btn');
				const inputZone = document.getElementById('search-input-zone');
				const brandZone = document.getElementById('nav-brand-zone');
				const linksZone = document.getElementById('nav-links-zone');
				const queryInput = document.getElementById('search-query') as HTMLInputElement | null;
				const clearBtn = document.getElementById('search-clear-btn');
				const resultsPanel = document.getElementById('search-results-panel');
				const resultsList = document.getElementById('search-results-list');
				const noResults = document.getElementById('search-no-results');

				if (!triggerBtn || triggerBtn.dataset.searchInitialized) return;
				triggerBtn.dataset.searchInitialized = 'true';

				const loadSearchIndex = async () => {
					if (searchLoaded) return;
					try {
						const res = await fetch('/search-index.json');
						searchData = await res.json();
						searchLoaded = true;
					} catch (err) {
						console.error('Error fetching search index:', err);
					}
				};

				const openSearch = async () => {
					await loadSearchIndex();
					inputZone?.classList.remove('hidden');
					inputZone?.classList.add('flex');
					queryInput?.focus();

					triggerBtn.innerHTML = `
						<svg class="w-4 h-4 fill-none stroke-current shrink-0 text-copper-ember" viewBox="0 0 24 24" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
						</svg>
					`;
					triggerBtn.setAttribute('aria-label', 'Cerrar búsqueda');
				};

				const closeSearch = () => {
					inputZone?.classList.remove('flex');
					inputZone?.classList.add('hidden');

					if (queryInput) queryInput.value = '';
					clearBtn?.classList.add('hidden');
					resultsPanel?.classList.add('hidden');
					if (resultsList) resultsList.innerHTML = '';
					noResults?.classList.add('hidden');

					triggerBtn.innerHTML = `
						<svg class="w-4 h-4 fill-none stroke-current shrink-0" viewBox="0 0 24 24" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
						</svg>
					`;
					triggerBtn.setAttribute('aria-label', 'Buscar posts');
				};

				triggerBtn.addEventListener('click', (e) => {
					e.stopPropagation();
					const isOpen = !inputZone?.classList.contains('hidden');
					if (isOpen) {
						closeSearch();
					} else {
						openSearch();
					}
				});

				clearBtn?.addEventListener('click', () => {
					if (queryInput) {
						queryInput.value = '';
						queryInput.focus();
						resultsPanel?.classList.add('hidden');
						clearBtn.classList.add('hidden');
					}
				});

				const highlightMatch = (text: string, query: string) => {
					if (!query) return text;
					const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
					return text.replace(regex, '<span class="text-copper-ember font-bold underline decoration-copper-ember/30">$1</span>');
				};

				queryInput?.addEventListener('input', (e) => {
					const rawVal = (e.target as HTMLInputElement).value;
					const val = rawVal.trim().toLowerCase();
					if (val.length > 0) {
						clearBtn?.classList.remove('hidden');
					} else {
						clearBtn?.classList.add('hidden');
						resultsPanel?.classList.add('hidden');
						return;
					}

					if (!searchLoaded) return;

					const filtered = searchData.filter(item => 
						item.title.toLowerCase().includes(val) || 
						(item.subtitle && item.subtitle.toLowerCase().includes(val)) || 
						item.collection.toLowerCase().includes(val)
					).slice(0, 8);

					if (resultsList) {
						resultsList.innerHTML = '';
						if (filtered.length > 0) {
							noResults?.classList.add('hidden');
							resultsPanel?.classList.remove('hidden');
							filtered.forEach(item => {
								const highlightedTitle = highlightMatch(item.title, val);
								const highlightedSubtitle = item.subtitle ? highlightMatch(item.subtitle, val) : '';
								const subMarkup = highlightedSubtitle 
									? `<span class="font-tgp-body text-[8.5px] text-white/15 group-hover/result:text-white/70 group-focus/result:text-white/70 transition-colors mt-0.5 line-clamp-1 leading-snug font-light text-right">${highlightedSubtitle}</span>` 
									: '';

								const itemEl = document.createElement('a');
								itemEl.href = item.link;
								itemEl.tabIndex = 0;
								itemEl.className = 'group/result flex flex-col py-2 px-0 border-b border-white/5 last:border-none bg-transparent hover:bg-transparent focus:bg-transparent outline-none transition-colors duration-200 cursor-pointer text-right items-end';
								itemEl.innerHTML = `
									<div class="flex items-center gap-2 justify-end w-full">
										<span class="font-tgp-tech text-[6px] tracking-[0.2em] uppercase text-white/15 group-hover/result:text-copper-ember group-focus/result:text-copper-ember transition-colors shrink-0">${item.collection}</span>
										<span class="font-tgp-gloock text-xs text-white/25 group-hover/result:text-white group-focus/result:text-white transition-colors leading-tight text-right">${highlightedTitle}</span>
									</div>
									${subMarkup}
								`;
								itemEl.addEventListener('click', () => {
									closeSearch();
								});
								resultsList.appendChild(itemEl);
							});
						} else {
							noResults?.classList.remove('hidden');
							resultsPanel?.classList.remove('hidden');
						}
					}
				});

				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') {
						closeSearch();
					}
				});

				document.addEventListener('click', (e) => {
					if (header && !header.contains(e.target as Node)) {
						closeSearch();
					}
				});
			};

			document.addEventListener('astro:page-load', () => {
				setupBaseNavScroll();
				initSearch();
			});
			setupBaseNavScroll();
			initSearch();

			// Lifecycle Protocol: Garbage Collection
			document.addEventListener('astro:before-swap', () => {
				ScrollTrigger.getAll().forEach(t => t.kill());
			});
		</script>
	</body>
</html>
