---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	vibeClass?: string;
}

const { title, vibeClass = '' } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-racing-green text-white antialiased selection:bg-emerald-800 selection:text-white">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<ClientRouter />

		<!-- Google Fonts: Editorial Dictionary (14 Families) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Prata&family=Plus+Jakarta+Sans:wght@100;200;400;700&family=Cormorant+Garamond:ital,wght@0,300;0,700;1,300&family=Raleway:wght@100;400;900&family=Gloock&family=IBM+Plex+Mono:wght@300;400&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Montserrat:wght@100;400;900&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Jost:wght@100;400;800&family=DM+Serif+Display&family=Epilogue:wght@100;400;900&family=Syne:wght@400;700;800&family=Space+Grotesk:wght@300;700&display=swap" rel="stylesheet">
		
		<style is:global>
			/* Opt-out of default font-serif to allow vibe dominance */
			.font-outfit { font-family: 'Outfit', sans-serif; }
		</style>
	</head>
	<body class={`min-h-screen bg-racing-green font-outfit relative overflow-x-hidden ${vibeClass}`}>
		
		{/* NAVBAR: Glassmorphism Bridge (Global Integration) */}
		<header id="glass-bridge" class="fixed top-0 left-0 w-full z-100 px-6 py-8 opacity-0 -translate-y-full pointer-events-none" transition:persist>
			<nav class="max-w-7xl mx-auto flex items-center justify-between px-10 py-5 rounded-full backdrop-blur-[32px] saturate-180 border transition-all duration-700 pointer-events-auto"
				 style="background-color: color-mix(in srgb, var(--bg-current), transparent 82%); 
				        border-color: color-mix(in srgb, var(--text-current), transparent 85%);
				        color: var(--text-current);
				        box-shadow: 0 30px 60px -12px rgba(0,0,0,0.25), inset 0 1px 0 color-mix(in srgb, var(--text-current), transparent 94%);">
				
				<div class="flex items-center gap-6">
					<a href="/" class="w-10 h-10 rounded-full bg-copper-ember shadow-[inset_0_0_10px_rgba(0,0,0,0.5)] flex items-center justify-center text-xs font-bold text-black font-sans hover:scale-110 transition-transform">TGP</a>
					<span class="font-serif tracking-[0.4em] text-[10px] uppercase hidden md:block opacity-80"
						  style="color: var(--text-current);">The Great Puzzle • 2026</span>
				</div>
				
				<div class="flex items-center gap-10 font-sans text-[10px] tracking-[0.3em] uppercase font-medium">
					<a href="/ensayos" class="hover:text-copper-ember transition-all duration-300">Ensayos</a>
					<a href="/essays" class="hover:text-copper-ember transition-all duration-300">Essays</a>
					<a href="/architectures" class="hover:text-copper-ember transition-all duration-300">Architectures</a>
					<a href="/visual-signals" class="hover:text-copper-ember transition-all duration-300">Signals</a>
					<a href="/capsulas" class="px-6 py-2 bg-copper-ember text-black rounded-full font-bold hover:bg-white hover:scale-105 transition-all duration-500 shadow-lg shadow-copper-ember/20">Cápsulas</a>
				</div>
			</nav>
		</header>

		<!-- Global texture/ambient background -->
		<div class="fixed inset-0 pointer-events-none -z-10 bg-[radial-gradient(ellipse_at_top,var(--tw-gradient-stops))] from-emerald-950/40 via-racing-green to-racing-green"></div>
		
		<slot />

		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			const initNavbar = () => {
				const nav = document.getElementById('glass-bridge');
				if (!nav) return;

				// Reset state
				gsap.set(nav, { opacity: 0, y: -100 });

				ScrollTrigger.create({
					start: () => window.innerHeight * 0.5, 
					onEnter: () => gsap.to(nav, { opacity: 1, y: 0, duration: 1.2, pointerEvents: 'auto', ease: "expo.out" }),
					onLeaveBack: () => gsap.to(nav, { opacity: 0, y: -100, duration: 0.8, pointerEvents: 'none', ease: "expo.in" }),
				});
			};

			// Lifecycle Protocol: Initialization
			document.addEventListener('astro:page-load', () => {
				initNavbar();
			});

			// Lifecycle Protocol: Garbage Collection
			document.addEventListener('astro:before-swap', () => {
				ScrollTrigger.getAll().forEach(t => t.kill());
			});
		</script>
	</body>
</html>
