---
import '../styles/global.css';

// @fontsource — Local font imports (replaces Google Fonts)
import '@fontsource/gloock/400.css';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/bodoni-moda/400.css';
import '@fontsource/bodoni-moda/600.css';
import '@fontsource/fraunces/900.css';
import '@fontsource/fraunces/700.css';
import '@fontsource/syne/800.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/400.css';
import '@fontsource/dm-serif-display/400.css';
import '@fontsource/dm-serif-display/400-italic.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/600.css';
import '@fontsource/inter/100.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/500.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/outfit/100.css';
import '@fontsource/outfit/300.css';
import '@fontsource/outfit/500.css';
import '@fontsource/space-grotesk/300.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/epilogue/100.css';
import '@fontsource/epilogue/600.css';
import '@fontsource/epilogue/900.css';
import '@fontsource/manrope/800.css';
import '@fontsource/ibm-plex-mono/300.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/plus-jakarta-sans/200.css';
import '@fontsource/plus-jakarta-sans/300.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';

import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	vibeClass?: string;
}

const { title, vibeClass = '' } = Astro.props;

// Map vibeClass to data-theme attribute for Tailwind CSS variable consumption
const dataTheme = vibeClass || 'default';
---

<!doctype html>
<html lang="es" class="bg-racing-green text-white antialiased selection:bg-emerald-800 selection:text-white">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="The Great Puzzle — Editorial Platform" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body data-theme={dataTheme} class={`min-h-screen relative overflow-x-hidden ${vibeClass}`}>
		
		{/* NAVBAR: Glassmorphism Bridge (Global Integration) */}
		<header id="glass-bridge" class="fixed top-0 left-0 w-full z-100 px-6 py-8 opacity-0 -translate-y-full pointer-events-none" transition:persist>
			<nav class="tgp-nav max-w-7xl mx-auto flex items-center justify-between px-10 py-5 rounded-full backdrop-blur-[32px] saturate-180 border border-theme-muted bg-theme-glass transition-all duration-700 pointer-events-auto shadow-[0_30px_60px_-12px_rgba(0,0,0,0.25)]">
				<div class="flex items-center gap-6">
					<a href="/" class="w-10 h-10 rounded-full bg-copper-ember shadow-[inset_0_0_10px_rgba(0,0,0,0.5)] flex items-center justify-center text-xs font-bold text-black font-tgp-tech hover:scale-110 transition-transform">TGP</a>
					<span class="font-tgp-serif tracking-[0.4em] text-[10px] uppercase hidden md:block opacity-80 text-theme-text">The Great Puzzle • 2026</span>
				</div>
				<div class="flex items-center gap-10 font-tgp-tech text-[10px] tracking-[0.3em] uppercase font-medium text-theme-text">
					<a href="/ensayos" class="hover:text-copper-ember transition-all duration-300">Ensayos</a>
					<a href="/essays" class="hover:text-copper-ember transition-all duration-300">Essays</a>
					<a href="/architectures" class="hover:text-copper-ember transition-all duration-300">Architectures</a>
					<a href="/visual-signals" class="hover:text-copper-ember transition-all duration-300">Signals</a>
					<a href="/capsulas" class="px-6 py-2 bg-copper-ember text-black rounded-full font-bold hover:bg-white hover:scale-105 transition-all duration-500 shadow-lg shadow-copper-ember/20">Cápsulas</a>
				</div>
			</nav>
		</header>

		<!-- Global texture/ambient background -->
		<div class="fixed inset-0 pointer-events-none -z-10 bg-[radial-gradient(ellipse_at_top,var(--tw-gradient-stops))] from-emerald-950/40 via-racing-green to-racing-green"></div>
		
		<slot />

		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			const initNavbar = () => {
				const nav = document.getElementById('glass-bridge');
				if (!nav) return;

				// Reset state
				gsap.set(nav, { opacity: 0, y: -100 });

				ScrollTrigger.create({
					start: () => window.innerHeight * 0.5, 
					onEnter: () => gsap.to(nav, { opacity: 1, y: 0, duration: 1.2, pointerEvents: 'auto', ease: "expo.out" }),
					onLeaveBack: () => gsap.to(nav, { opacity: 0, y: -100, duration: 0.8, pointerEvents: 'none', ease: "expo.in" }),
				});
			};

			// Lifecycle Protocol: Initialization
			document.addEventListener('astro:page-load', () => {
				initNavbar();
			});

			// Lifecycle Protocol: Garbage Collection
			document.addEventListener('astro:before-swap', () => {
				ScrollTrigger.getAll().forEach(t => t.kill());
			});
		</script>
	</body>
</html>
