---
import '../styles/global.css';

interface Props {
	title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es" class="bg-[#050505]">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
        <link href="https://fonts.googleapis.com/css2?family=Gloock&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#050505] text-gray-200 font-sans selection:bg-[#FF6719] selection:text-white pb-20 md:pb-0 m-0 p-0 overflow-x-hidden min-h-screen relative">
        {/* Floating Back Button */}
        <a 
            href={Astro.url.pathname.startsWith('/ensayos/') ? '/ensayos' : '/'} 
            class="fixed top-6 left-6 z-100 bg-white/5 hover:bg-[#FF6719] backdrop-blur-md border border-white/10 p-3 rounded-full text-white hover:text-black transition-all duration-300 group shadow-2xl"
            aria-label="Volver"
        >
            <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
        </a>

		<slot />

        {/* Mobile Navigation Bar */}
        <nav class="fixed bottom-0 left-0 w-full bg-[#050505]/95 backdrop-blur-xl border-t border-white/5 md:hidden z-50 py-4 px-8 flex justify-around items-center">
            <a href="/" class="text-gray-500 hover:text-[#FF6719] transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            </a>
            <a href="/ensayos" class="text-white hover:text-[#FF6719] transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </a>
            <a href="#" class="text-gray-500 hover:text-[#FF6719] transition-colors relative">
                <span class="absolute top-0 right-0 w-2 h-2 bg-[#FF6719] rounded-full"></span>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
            </a>
        </nav>
	</body>
</html>
