---
import '../styles/global.css';

interface Props {
	title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es" class="bg-[#26211E]">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
        <link href="https://fonts.googleapis.com/css2?family=Gloock&display=swap" rel="stylesheet">
	</head>
	<body class="text-[#F3EFE9] font-sans selection:bg-[#FF6719] selection:text-white pb-20 md:pb-0 m-0 p-0 overflow-x-hidden min-h-screen relative" style="background-color: var(--bg-current, #26211E); color: var(--text-current, #F3EFE9); --bg-article-fumee: #13100E; --bg-article-fumee-dark: #090706; --bg-card-fumee: rgba(21, 18, 16, 0.85); --border-fumee: rgba(255, 255, 255, 0.08);">
        {/* ── Top Identity Bar ── */}
        <div class="fixed top-0 left-0 w-full z-50 flex items-center justify-between px-6 py-5 pointer-events-none">
          {/* Logo → Inicio */}
          <a 
            href="/" 
            class="pointer-events-auto no-underline flex items-center gap-3 group"
            aria-label="Inicio"
          >
            <span class="w-8 h-8 rounded-full bg-[#FF6719] flex items-center justify-center text-[9px] font-bold text-black tracking-widest group-hover:scale-110 transition-transform duration-300">
              TGP
            </span>
            <span class="hidden md:block font-sans text-[9px] tracking-[0.45em] uppercase text-white/30 group-hover:text-white/70 transition-colors duration-300">
              The Great Puzzle
            </span>
          </a>

          {/* Botón "Volver al Feed" — solo en artículos individuales */}
          {Astro.url.pathname.startsWith('/ensayos/') ? (
            <a
              href="/ensayos"
              class="pointer-events-auto flex items-center gap-2 border border-white/10 hover:border-[#FF6719]/40 bg-[#050505]/60 backdrop-blur-md px-4 py-2 rounded-full text-[9px] tracking-[0.3em] uppercase text-white/40 hover:text-[#FF6719] transition-all duration-300 no-underline"
              aria-label="Volver al feed"
            >
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              Feed
            </a>
          ) : (
            <span class="font-sans text-[9px] tracking-[0.4em] uppercase text-white/15">
              Ensayos
            </span>
          )}
        </div>

		<slot />

        {/* Mobile Navigation Bar */}
        <nav class="fixed bottom-0 left-0 w-full bg-[#050505]/95 backdrop-blur-xl border-t border-white/5 md:hidden z-50 py-4 px-8 flex justify-around items-center">
            <a href="/" class="text-gray-500 hover:text-[#FF6719] transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            </a>
            <a href="/ensayos" class="text-white hover:text-[#FF6719] transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </a>
            <a href="#" class="text-gray-500 hover:text-[#FF6719] transition-colors relative">
                <span class="absolute top-0 right-0 w-2 h-2 bg-[#FF6719] rounded-full"></span>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
            </a>
        </nav>
	</body>
</html>
