---
import Layout from './Layout.astro';
interface Props {
  title: string;
  hero_image?: string;
  vibeClass?: string;
}
const { title, hero_image = '', vibeClass = '' } = Astro.props;
---
<Layout title={title} vibeClass={vibeClass}>
  <div class="min-h-screen font-sans" style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background-color: var(--bg-current); color: var(--text-current);">
    <slot name="hero" />

    <section class="max-w-4xl mx-auto px-6 py-24 pb-48 relative z-20" style="background-color: var(--bg-current);">
      <div class="prose prose-tgp mx-auto max-w-none">
        <slot />
      </div>
    </section>
  </div>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;700&display=swap');
</style>

<script>
</script>
