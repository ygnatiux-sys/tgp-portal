---
import Layout from './Layout.astro';
interface Props {
  title: string;
  description?: string;
  hero_image?: string;
  image?: string;
  vibeClass?: string;
  article?: any;
}
const { title, description, hero_image = '', image, vibeClass = '', article } = Astro.props;
---
<Layout title={title} description={description} image={image || hero_image} vibeClass={vibeClass} article={article}>
  <div class="min-h-screen font-sans transition-colors duration-700" style="font-family: var(--font-tgp-jakarta), system-ui, sans-serif; background-color: var(--bg-current); color: var(--text-current);">
    <slot name="hero" />

    <main class="relative z-20 transition-colors duration-700" style="background-color: var(--bg-current);">
      <slot />
    </main>
  </div>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;700&display=swap');
</style>

<script>
</script>
