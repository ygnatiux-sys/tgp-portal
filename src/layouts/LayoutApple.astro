---
import Layout from './Layout.astro';
interface Props {
  title: string;
  hero_image?: string;
}
const { title, hero_image = '' } = Astro.props;
---
<Layout title={title}>
  <div class="bg-[#f5f5f7] text-[#1d1d1f] min-h-screen font-sans" style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;">
    <section class="apple-hero relative h-screen w-full flex items-center justify-center overflow-hidden">
      <!-- High Quality Static Image -->
      <div class="hero-bg absolute inset-0 z-0">
        <img src={hero_image} alt={title} class="w-full h-full object-cover" />
      </div>
      <!-- Glassmorphism Title -->
      <div class="relative z-10 p-12 rounded-3xl backdrop-blur-2xl bg-white/10 border border-white/20 shadow-2xl">
        <h1 class="text-6xl md:text-8xl font-medium tracking-tight text-white drop-shadow-md text-center">
          {title}
        </h1>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-6 py-24 pb-48 relative z-20 bg-[#f5f5f7]">
      <div class="prose prose-lg md:prose-xl prose-stone mx-auto">
        <slot />
      </div>
    </section>
  </div>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;700&display=swap');
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const heroBg = document.querySelector('.hero-bg');
  
  if (heroBg) {
    gsap.to(heroBg, {
      scrollTrigger: {
        trigger: '.apple-hero',
        start: 'top top',
        end: 'bottom top',
        scrub: true,
      },
      filter: 'blur(20px) brightness(0.5)',
      scale: 1.1,
      ease: 'power4.out',
    });
  }
</script>
