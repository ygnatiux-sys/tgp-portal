---
import Layout from './Layout.astro';
interface Props {
  title: string;
  hero_image?: string;
  vibeClass?: string;
}
const { title, hero_image = '', vibeClass = '' } = Astro.props;
---
<Layout title={title} vibeClass={vibeClass}>
  <div class="bg-[#f4f0ec] text-[#2c2b29] min-h-screen">
    <slot name="hero" />

    <section class="max-w-3xl mx-auto px-8 py-24 pb-48 relative z-20 bg-[#f4f0ec]">
      <div class="prose prose-tgp mx-auto max-w-none">
        <slot />
      </div>
    </section>
  </div>
</Layout>

<script>
</script>
