---
import Layout from './Layout.astro';
interface Props {
  title: string;
  hero_image?: string;
}
const { title, hero_image = '' } = Astro.props;
---
<Layout title={title}>
  <div class="bg-racing-green text-[#e2e8f0] min-h-screen">
    <slot name="hero" />

    <section class="max-w-4xl mx-auto px-6 py-20 pb-48 relative z-20 bg-racing-green">
      <div class="prose prose-invert prose-tgp mx-auto max-w-none">
        <slot />
      </div>
    </section>
  </div>
</Layout>

