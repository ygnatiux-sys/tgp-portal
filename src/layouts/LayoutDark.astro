---
import Layout from './Layout.astro';
interface Props {
  title: string;
  hero_image?: string;
  vibeClass?: string;
}
const { title, hero_image = '', vibeClass = '' } = Astro.props;
---
<Layout title={title} vibeClass={vibeClass}>
  <div class="bg-racing-green text-[#e2e8f0] min-h-screen">
    <slot name="hero" />

    <main class="relative z-20 bg-racing-green">
      <slot />
    </main>
  </div>
</Layout>

