---
import Layout from './Layout.astro';
interface Props {
  title: string;
  hero_image?: string;
  vibeClass?: string;
}
const { title, hero_image = '', vibeClass = '' } = Astro.props;
---
<Layout title={title} vibeClass={vibeClass}>
  <div class="min-h-screen transition-colors duration-700" style="background-color: var(--bg-current); color: var(--text-current);">
    <slot name="hero" />

    <main class="relative z-20 transition-colors duration-700" style="background-color: var(--bg-current);">
      <slot />
    </main>
  </div>
</Layout>

<style>
</style>

<script>
</script>
