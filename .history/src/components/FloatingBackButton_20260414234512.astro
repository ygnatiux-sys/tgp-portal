---
// FloatingBackButton.astro
---

<a
  href="javascript:history.back()"
  class="tgp-back-btn fixed top-1/2 left-4 md:left-8 z-[100] -translate-y-1/2 p-3 md:p-4 rounded-full bg-black/20 backdrop-blur-md border border-white/10 text-white/50 hover:text-white hover:bg-black/60 hover:scale-110 hover:border-white/30 transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] group shadow-2xl"
  aria-label="Volver atrás"
>
  <svg
    class="w-5 h-5 md:w-6 md:h-6 transition-transform group-hover:-translate-x-1"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.5"
      d="M15 19l-7-7 7-7"></path>
  </svg>
</a>

<style>
  /* Efecto de entrada suave al cargar la página */
  .tgp-back-btn {
    animation: fade-in-left 1.2s ease-out forwards;
    opacity: 0;
  }

  @keyframes fade-in-left {
    from {
      opacity: 0;
      transform: translate(-20px, -50%);
    }
    to {
      opacity: 1;
      transform: translate(0, -50%);
    }
  }

  /* Ocultar sutilmente al hacer scroll hacia abajo (Opcional, manejado por GSAP si querés, pero así fijo en el medio es el estándar editorial actual) */
</style>
