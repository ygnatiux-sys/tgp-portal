---
interface Props {
  title: string;
  subtitle?: string;
  imageUrl?: string;
  vibeClass?: string;
}
const {
  title,
  subtitle = "The Great Puzzle",
  imageUrl = "",
  vibeClass = "",
} = Astro.props;
---

<section
  class={`dark-hero relative w-full h-[80vh] min-h-[600px] flex flex-col items-center justify-center overflow-hidden bg-racing-green ${vibeClass}`}
>
  <div class="absolute inset-0 z-0 opacity-70 marquee-bg-pin flex">
    <div class="marquee-track flex h-full w-[200vw]">
      <div class="cine-wrapper">
        <img
          src={imageUrl}
          alt="Background Marquee 1"
          class="dark-img-target w-full h-full object-cover"
          style="transform-origin: center center;"
        />
      </div>
      <div class="cine-wrapper">
        <img
          src={imageUrl}
          alt="Background Marquee 2"
          class="dark-img-target w-full h-full object-cover"
          style="transform-origin: center center;"
        />
      </div>
    </div>
  </div>

  <div class="texture-grain"></div>
  <div class="texture-scratches"></div>
  <div class="atmospheric-dust"></div>

  <div
    class="absolute inset-0 z-10 bg-gradient-to-t from-racing-green via-racing-green/60 to-transparent"
  >
  </div>
  <div class="absolute inset-0 z-10 bg-black/40"></div>

  <div class="absolute top-12 left-12 z-30 pointer-events-none">
    <div
      class={`vibe-target-folio text-white/40 text-[10px] uppercase ${vibeClass === "vibe-travel-senses" ? "vibe-vertical" : ""}`}
    >
      TGP Editorial // {vibeClass.replace("vibe-", "").replace(/-/g, " ")}
    </div>
  </div>

  <div
    class="title-container relative z-20 text-center px-6 w-full max-w-5xl mx-auto py-12"
  >
    <p
      class="vibe-target-h2 font-sans text-sm uppercase tracking-[0.2em] text-[#c4a484]/80 mb-6 drop-shadow-md text-balance max-w-3xl mx-auto"
    >
      {subtitle}
    </p>
    <h1
      class="vibe-target-h1 font-serif text-5xl md:text-[5.5rem] text-[#c4a484] font-black uppercase tracking-tighter leading-[0.95] text-balance drop-shadow-2xl mx-auto max-w-5xl"
    >
      {title}
    </h1>
  </div>
</section>

<style>
  @keyframes cine-drift {
    0% {
      transform: scale(1.06) translate(0%, 0%);
    }
    25% {
      transform: scale(1.09) translate(-0.4%, 0.3%);
    }
    50% {
      transform: scale(1.07) translate(-0.8%, -0.2%);
    }
    75% {
      transform: scale(1.09) translate(-0.35%, 0.35%);
    }
    100% {
      transform: scale(1.06) translate(0%, 0%);
    }
  }

  .cine-wrapper {
    width: 100vw;
    height: 110%;
    flex-shrink: 0;
    position: relative;
    top: -5%;
    animation: cine-drift 32s ease-in-out infinite;
    will-change: transform;
  }

  .cine-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dark-hero:hover .cine-wrapper {
    animation-duration: 16s;
  }

  .dark-hero:hover .dark-img-target {
    /* Suavizamos la bajada de luz en hover para que no quede negro total */
    filter: brightness(0.8) contrast(1.1);
    transition: filter 1.8s ease;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initDarkHero = () => {
    const heroSection = document.querySelector(".dark-hero");
    const marqueeTrack = document.querySelector(".dark-hero .marquee-track");
    const bgPin = document.querySelector(".dark-hero .marquee-bg-pin");
    const titleContainer = document.querySelector(
      ".dark-hero .title-container",
    );
    const images = document.querySelectorAll(".dark-hero .dark-img-target");

    if (marqueeTrack) {
      gsap.to(marqueeTrack, {
        xPercent: -50,
        ease: "none",
        repeat: -1,
        duration: 90,
      });
    }

    if (heroSection && bgPin) {
      // 1. ZOOM-OUT & DIM
      gsap.to(images, {
        scrollTrigger: {
          trigger: heroSection,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
        scale: 0.8,
        opacity: 0.4, // Aumentado para que al scrollear no desaparezca del todo
        ease: "power2.inOut",
      });

      // 2. PARALLAX DRIFT
      gsap.to(bgPin, {
        scrollTrigger: {
          trigger: heroSection,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
        y: 100,
        ease: "none",
      });

      // 3. TITLE TRANSITION
      if (titleContainer) {
        gsap.to(titleContainer, {
          scrollTrigger: {
            trigger: heroSection,
            start: "top top",
            end: "bottom top",
            scrub: 1.2,
          },
          y: 250,
          opacity: 0,
          scale: 0.9,
          ease: "power3.out",
        });
      }
    }
  };

  // Lifecycle Protocol
  document.addEventListener("astro:page-load", initDarkHero);
</script>
