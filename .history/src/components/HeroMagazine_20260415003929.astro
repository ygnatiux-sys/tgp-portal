---
interface Props {
  title: string;
  subtitle?: string;
  imageUrl?: string;
  vibeClass?: string;
}
const {
  title,
  subtitle = "Editorial Magazine",
  imageUrl = "",
  vibeClass = "",
} = Astro.props;
---

<section
  class={`magazine-hero relative w-full h-screen min-h-[850px] overflow-hidden bg-racing-green ${vibeClass}`}
>
  <div class="absolute inset-0 z-0 magazine-bg-pin overflow-hidden">
    <div class="absolute inset-0 opacity-90 flex">
      <div
        class="magazine-marquee-container flex h-full w-[200vw] will-change-transform"
      >
        <div class="cine-wrapper">
          <img
            src={imageUrl}
            alt=""
            class="w-full h-full object-cover grayscale-[0.2] contrast-110 magazine-img-target"
            style="transform-origin: center center;"
          />
        </div>
        <div class="cine-wrapper">
          <img
            src={imageUrl}
            alt=""
            class="w-full h-full object-cover grayscale-[0.2] contrast-110 magazine-img-target"
            style="transform-origin: center center;"
          />
        </div>
      </div>
    </div>

    <div class="texture-grain"></div>
    <div class="texture-scratches"></div>
    <div class="atmospheric-dust"></div>

    <div
      class="absolute inset-0 bg-gradient-to-t from-racing-green via-racing-green/50 to-transparent z-10"
    >
    </div>
    <div class="absolute inset-0 bg-black/20 z-10"></div>
  </div>

  <div
    class="absolute top-12 left-12 md:top-16 md:left-16 z-30 pointer-events-none"
  >
    <div
      class={`vibe-target-folio text-white/40 text-[9px] md:text-[10px] uppercase ${vibeClass === "vibe-travel-senses" ? "vibe-vertical" : ""}`}
    >
      TGP Editorial // {vibeClass.replace("vibe-", "").replace(/-/g, " ")} // Vol.
      2026
    </div>
  </div>

  <div
    class="relative z-20 w-full h-full max-w-[1800px] mx-auto px-8 md:px-24 flex flex-col justify-end pb-24 md:pb-32"
  >
    <div class="magazine-meta-box mb-8 md:mb-12 overflow-hidden max-w-3xl">
      <p
        class="vibe-target-h2 font-sans text-white/90 leading-relaxed text-balance max-w-full drop-shadow-md"
      >
        {subtitle}
      </p>
    </div>

    <div class="magazine-title-box max-w-5xl pb-6">
      <h1 class="vibe-target-h1 text-5xl md:text-[5.5rem] text-white text-balance tracking-tighter leading-[1.1] drop-shadow-2xl">
        {title}
      </h1>
    </div>
  </div>
</section>

<style>
  /* Ensuring Outfit thin weight is applied if available as fallback */
  .font-thin {
    font-weight: 100;
  }

  /* Cinemagraph drift en wrapper — sobre el marquee y el zoom GSAP */
  @keyframes cine-drift {
    0% {
      transform: scale(1.06) translate(0%, 0%);
    }
    25% {
      transform: scale(1.09) translate(-0.4%, 0.3%);
    }
    50% {
      transform: scale(1.07) translate(-0.8%, -0.2%);
    }
    75% {
      transform: scale(1.09) translate(-0.35%, 0.35%);
    }
    100% {
      transform: scale(1.06) translate(0%, 0%);
    }
  }

  .cine-wrapper {
    width: 100vw;
    height: 110%;
    flex-shrink: 0;
    position: relative;
    top: -5%;
    animation: cine-drift 34s ease-in-out infinite;
    will-change: transform;
  }

  .cine-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .magazine-hero:hover .cine-wrapper {
    animation-duration: 17s;
  }

  .magazine-hero:hover .magazine-img-target {
    filter: brightness(0.9) contrast(1.08);
    transition: filter 1.8s ease;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initMagazineHero = () => {
    const hero = document.querySelector(".magazine-hero");
    const marquee = document.querySelector(
      ".magazine-hero .magazine-marquee-container",
    );
    const bgPin = document.querySelector(".magazine-hero .magazine-bg-pin");
    const images = document.querySelectorAll(
      ".magazine-hero .magazine-img-target",
    );
    const titleBox = document.querySelector(
      ".magazine-hero .magazine-title-box",
    );
    const metaBox = document.querySelector(".magazine-hero .magazine-meta-box");

    // 1. Marquee Loop
    if (marquee) {
      gsap.fromTo(
        marquee,
        { xPercent: -50 },
        {
          xPercent: 0,
          ease: "none",
          repeat: -1,
          duration: 90,
        },
      );
    }

    if (hero && bgPin) {
      // 2. ZOOM-OUT & FADE Scroll Physics
      gsap.to(images, {
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
        scale: 0.85,
        opacity: 0.3, // Aumentado de 0.1 a 0.3 para no perder la imagen
        ease: "power2.inOut",
      });

      // 3. BG PARALLAX DRIFT
      gsap.to(bgPin, {
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
        y: 120,
        ease: "none",
      });

      // 4. TEXT TRANSITION
      if (titleBox && metaBox) {
        gsap.to([titleBox, metaBox], {
          scrollTrigger: {
            trigger: hero,
            start: "top top",
            end: "40% top",
            scrub: 1.5,
          },
          y: 200,
          opacity: 0,
          scale: 0.95,
          stagger: 0.1,
          ease: "power3.out",
        });
      }
    }
  };

  // Lifecycle Protocol
  document.addEventListener("astro:page-load", initMagazineHero);
</script>
