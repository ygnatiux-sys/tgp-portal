---
interface Props {
  title: string;
  subtitle?: string;
  imageUrl?: string;
  vibeClass?: string;
}
const {
  title,
  subtitle = "Vintage Archives",
  imageUrl = "",
  vibeClass = "",
} = Astro.props;
---

<section
  class={`vintage-hero relative w-full h-[85vh] min-h-[600px] flex flex-col items-center justify-center overflow-hidden bg-racing-green ${vibeClass}`}
>
  <div
    class="hero-bg absolute inset-0 z-0 ken-burns-container"
    style="box-shadow: inset 0 0 100px rgba(0,0,0,0.5);"
  >
    <div class="cine-wrapper">
      <img
        src={imageUrl}
        alt={title}
        class="ken-burns-img w-full h-full object-cover sepia-[0.15]"
        style="transform-origin: center center;"
      />
    </div>

    <div class="texture-grain"></div>
    <div class="texture-scratches"></div>
    <div class="atmospheric-dust"></div>

    <div
      class="absolute inset-0 z-10 bg-gradient-to-t from-racing-green via-racing-green/50 to-transparent"
    >
    </div>
    <div class="absolute inset-0 z-10 bg-black/20"></div>
  </div>

  <div class="focal-square">
    <span class="focal-label">AF FOCUS L:12</span>
  </div>

  <div class="absolute top-12 left-12 z-40 pointer-events-none">
    <div
      class={`vibe-target-folio text-white/40 text-[10px] uppercase ${vibeClass === "vibe-travel-senses" ? "vibe-vertical" : ""}`}
    >
      TGP Editorial // {vibeClass.replace("vibe-", "").replace(/-/g, " ")}
    </div>
  </div>

  <div
    class="title-container relative z-20 text-center px-6 w-full max-w-5xl mx-auto py-12"
  >
    <p
      class="vibe-target-h2 font-sans text-sm uppercase tracking-[0.2em] text-[#f4f0ec]/90 mb-8 border-b border-[#f4f0ec]/30 pb-2 inline-block drop-shadow-md text-balance max-w-3xl mx-auto"
    >
      {subtitle}
    </p>
    <h1
      class="vibe-target-h1 font-serif text-5xl md:text-[5.5rem] text-[#f4f0ec] tracking-tighter uppercase leading-[0.95] drop-shadow-2xl text-balance mx-auto max-w-5xl"
    >
      {title}
    </h1>
  </div>
</section>

<style>
  .ken-burns-container {
    overflow: hidden;
  }

  /* Ken Burns en la imagen */
  .ken-burns-img {
    animation: kenburns 40s ease-in-out infinite alternate;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes kenburns {
    0% {
      transform: scale(1) translate(0, 0);
    }
    100% {
      transform: scale(1.12) translate(-1.5%, -0.8%);
    }
  }

  /* Cinemagraph en el wrapper — capa por encima del Ken Burns */
  @keyframes cine-drift {
    0% {
      transform: scale(1.06) translate(0%, 0%);
    }
    25% {
      transform: scale(1.09) translate(-0.4%, 0.3%);
    }
    50% {
      transform: scale(1.07) translate(-0.8%, -0.2%);
    }
    75% {
      transform: scale(1.09) translate(-0.3%, 0.35%);
    }
    100% {
      transform: scale(1.06) translate(0%, 0%);
    }
  }

  .cine-wrapper {
    animation: cine-drift 38s ease-in-out infinite;
    will-change: transform;
    width: 100%;
    height: 110%;
    position: absolute;
    top: -5%;
    left: 0;
  }

  .vintage-hero:hover .cine-wrapper {
    animation-duration: 19s;
  }

  .vintage-hero:hover .ken-burns-img {
    /* Suavizado de luz en el hover (antes brightness: 0.65) */
    filter: sepia(0.15) brightness(0.85);
    transition: filter 1.8s ease;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initHero = () => {
    const heroSection = document.querySelector(".vintage-hero");
    const heroBg = document.querySelector(".vintage-hero .hero-bg");
    const titleContainer = document.querySelector(
      ".vintage-hero .title-container",
    );
    const focalSquare = document.querySelector(".vintage-hero .focal-square");
    const img = document.querySelector(".vintage-hero .ken-burns-img");

    if (heroSection && heroBg) {
      // 1. ZOOM-OUT TRANSITION
      gsap.to(img, {
        scrollTrigger: {
          trigger: heroSection,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
        scale: 0.9,
        opacity: 0.4, // Aumentado de 0.2 a 0.4
        ease: "power2.inOut",
      });

      // 2. FOCAL SQUARE PULSE
      if (focalSquare) {
        gsap.to(focalSquare, {
          scale: 1.1,
          opacity: 0.5,
          duration: 3,
          repeat: -1,
          yoyo: true,
          ease: "sine.inOut",
        });

        gsap.to(focalSquare, {
          scrollTrigger: {
            trigger: heroSection,
            start: "top top",
            end: "center top",
            scrub: true,
          },
          scale: 2,
          opacity: 0,
          ease: "expo.in",
        });
      }

      // 3. TITLE PARALLAX
      if (titleContainer) {
        gsap.to(titleContainer, {
          scrollTrigger: {
            trigger: heroSection,
            start: "top top",
            end: "bottom top",
            scrub: 1,
          },
          y: 200,
          scale: 0.95,
          opacity: 0,
          ease: "power3.out",
        });
      }
    }
  };

  document.addEventListener("astro:page-load", initHero);
</script>
